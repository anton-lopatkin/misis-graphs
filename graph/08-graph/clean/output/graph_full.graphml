    <node id="П.И. СОКОЛОВСКИЙ">
      <data key="d0">П.И. СОКОЛОВСКИЙ</data>
      <data key="d1">СТАНДАРТ</data>
      <data key="d2">Автор исследований по влиянию фосфора на свойства стали; его данные используются для оценки степени ликвации и хладостойкости</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">91</data>
      <data key="d7">432</data>
