      <data key="d12">211</data>
    </edge>
    <edge source="НИОБИЙ" target="ПОРОГ ХЛАДНОЛОМКОСТИ">
      <data key="d10">9.0</data>
      <data key="d11">Микролегирование ниобием максимально снижает порог хладноломкости</data>
      <data key="d12">177</data>
    </edge>
