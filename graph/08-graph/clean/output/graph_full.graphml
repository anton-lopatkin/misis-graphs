      <data key="d12">6</data>
    </edge>
    <edge source="S345" target="РИС. 5.39">
      <data key="d10">1.0</data>
      <data key="d11">На рис. 5.39 представлены данные по стали S345 после различных обработок</data>
      <data key="d12">6</data>
    </edge>
    <edge source="ГРУБОЕ ЗЕРНО" target="ПОТЕРЯ ВЯЗКОСТИ">
      <data key="d10">9.0</data>
      <data key="d11">Грубое зерно приводит к снижению вязкости и хладостойкости</data>
      <data key="d12">6</data>
    </edge>
    <edge source="ГРУБОЕ ЗЕРНО" target="МИКРОСЕГРЕГАЦИЯ">
