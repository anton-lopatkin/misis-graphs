    </edge>
    <edge source="ЯЧЕЙКА" target="ИСПЫТАНИЕ НА СТОЙКОСТЬ ПРОТИВ СЕРОВОДОРОДНОГО РАСТРЕСКИВАНИЯ ПОД НАПРЯЖЕНИЕМ">
