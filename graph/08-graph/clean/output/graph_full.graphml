    <node id="ЗЕРНИСТЫЙ ПЕРЛИТ">
      <data key="d0">ЗЕРНИСТЫЙ ПЕРЛИТ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Микроструктура, характеризующаяся округлыми выделениями цементита в ферритной матрице, обеспечивает лучшее сочетание прочности и вязкости по сравнению с пластинчатым перлитом</data>
