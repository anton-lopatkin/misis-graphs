    <edge source="ХЛАДОСТОЙКОСТЬ" target="КРИТИЧЕСКАЯ ТЕМПЕРАТУРА ХРУПКОСТИ">
      <data key="d10">9.0</data>
      <data key="d11">Хладостойкость обратно связана с критической температурой хрупкости — чем ниже порог, тем выше хладостойкость</data>
      <data key="d12">120</data>
    </edge>
