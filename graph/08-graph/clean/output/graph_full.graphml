    <node id="ТЕМПЕРАТУРА ОКОНЧАНИЯ ПРОКАТКИ 710 °C">
      <data key="d0">ТЕМПЕРАТУРА ОКОНЧАНИЯ ПРОКАТКИ 710 °C</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Температура прокатки в двухфазной (γ + α) области, способствует формированию субзеренной ферритной структуры</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">9</data>
