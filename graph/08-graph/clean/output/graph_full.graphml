      <data key="d12">18</data>
    </edge>
    <edge source="ТОЛЩИНА ПРОКАТА" target="ВОЗДУШНОЕ ОХЛАЖДЕНИЕ">
      <data key="d10">7.0</data>
      <data key="d11">Толщина определяет эффективность воздушного охлаждения — более тонкие изделия охлаждаются быстрее</data>
      <data key="d12">15</data>
    </edge>
    <edge source="ТОЛЩИНА ПРОКАТА" target="ЗАМЕДЛЕННОЕ ОХЛАЖДЕНИЕ">
      <data key="d10">10.0</data>
      <data key="d11">Прокат толщиной более 12 мм (и особенно 30–40 мм) требует укладки в штабель для замедленного охлаждения</data>
      <data key="d12">45</data>
    </edge>
    <edge source="ТОЛЩИНА ПРОКАТА" target="ОПЫТНО-ПРОМЫШЛЕННАЯ ПАРТИЯ">
      <data key="d10">10.0</data>
      <data key="d11">Партия изготовлена в виде проката толщиной 25 мм</data>
      <data key="d12">17</data>
    </edge>
    <edge source="ТОЛЩИНА ПРОКАТА" target="Σ_Т">
      <data key="d10">7.0</data>
