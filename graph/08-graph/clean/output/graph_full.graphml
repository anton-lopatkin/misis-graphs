      <data key="d12">22</data>
    </edge>
    <edge source="Σ_Т" target="X56">
      <data key="d10">10.0</data>
      <data key="d11">Предел текучести σ_т — ключевая механическая характеристика стали X56</data>
      <data key="d12">28</data>
    </edge>
