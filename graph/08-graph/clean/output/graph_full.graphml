      <data key="d10">10.0</data>
      <data key="d11">Феррит является основным компонентом ферритной матрицы</data>
      <data key="d12">170</data>
    </edge>
    <edge source="ФЕРРИТ" target="ИГОЛЬЧАТЫЙ ФЕРРИТ">
