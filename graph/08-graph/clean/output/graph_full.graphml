    <node id="ПЛАСТИЧЕСКОЕ ДЕФОРМИРОВАНИЕ">
      <data key="d0">ПЛАСТИЧЕСКОЕ ДЕФОРМИРОВАНИЕ</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Процесс изменения формы металла под нагрузкой, влияющий на структуру аустенита и кинетику последующих превращений</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">12</data>
