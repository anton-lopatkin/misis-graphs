    <edge source="ДИФФУЗИЯ" target="ГОМЕОГЕНИЗАЦИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Гомеогенизация (гомогенизация) осуществляется за счёт диффузионных процессов</data>
