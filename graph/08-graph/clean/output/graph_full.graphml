      <data key="d12">59</data>
    </edge>
    <edge source="ДИСПЕРСИОННОЕ УПРОЧНЕНИЕ" target="СКОРОСТЬ ОХЛАЖДЕНИЯ ~20 °C/С">
      <data key="d10">9.0</data>
