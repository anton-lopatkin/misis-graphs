    </edge>
    <edge source="ЗЕРНО ФЕРРИТА" target="ТЕМПЕРАТУРА НАЧАЛА ПРЕВРАЩЕНИЯ">
      <data key="d10">8.0</data>
      <data key="d11">Высокая температура начала превращения способствует огрублению зерна, низкая — его измельчению</data>
