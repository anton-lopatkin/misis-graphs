    <node id="ДОЛЯ ОСТРОВКОВ М/А">
      <data key="d0">ДОЛЯ ОСТРОВКОВ М/А</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Объёмная доля метастабильных включений мартенсита и остаточного аустенита, коррелирующая с прочностью стали)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">14</data>
      <data key="d6">202</data>
      <data key="d7">769</data>
