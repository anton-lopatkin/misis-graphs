    <node id="ПРОДУКТ ПРЕВРАЩЕНИЯ ОСТАТОЧНОГО АУСТЕНИТА">
      <data key="d0">ПРОДУКТ ПРЕВРАЩЕНИЯ ОСТАТОЧНОГО АУСТЕНИТА</data>
