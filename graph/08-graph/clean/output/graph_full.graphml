    <node id="ИСПЫТАНИЕ ЦИЛИНДРИЧЕСКИХ ОБРАЗЦОВ">
      <data key="d0">ИСПЫТАНИЕ ЦИЛИНДРИЧЕСКИХ ОБРАЗЦОВ</data>
      <data key="d1">ИСПЫТАНИЕ</data>
      <data key="d2">Метод определения механических свойств: предела текучести, прочности, удлинения и ударной вязкости)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
