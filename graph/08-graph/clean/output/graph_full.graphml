      <data key="d12">69</data>
    </edge>
    <edge source="МИКРОЛЕГИРОВАНИЕ" target="ТЕХНОЛОГИЯ ПОЛУЧЕНИЕ СТАЛЬ СЕВЕРНОЕ ИСПОЛНЕНИЕ">
      <data key="d10">10.0</data>
