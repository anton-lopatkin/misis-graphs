      <data key="d10">9.0</data>
      <data key="d11">В стали 12ХГНБ присутствуют дисперсные частицы карбонитридов ниобия с высокой объемной плотностью</data>
      <data key="d12">22</data>
    </edge>
    <edge source="ДИСПЕРСНЫЕ ЧАСТИЦЫ" target="МОДЕЛЬ ОРОВАНА">
