      <data key="d12">33</data>
    </edge>
    <edge source="ЗАМЕДЛЕННОЕ ОХЛАЖДЕНИЕ" target="НАЧАЛЬНАЯ ТЕМПЕРАТУРА ШТАБЕЛЯ">
      <data key="d10">7.0</data>
      <data key="d11">Начальная температура штабеля влияет на кинетику удаления водорода при замедленном охлаждении</data>
