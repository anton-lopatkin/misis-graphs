      <data key="d12">52</data>
    </edge>
    <edge source="АЗОТ" target="СОДЕРЖАНИЕ АЗОТА">
      <data key="d10">10.0</data>
      <data key="d11">Содержание азота — количественная характеристика элемента в стали</data>
      <data key="d12">55</data>
    </edge>
    <edge source="АЗОТ" target="НИТРИДЫ НИОБИЯ">
