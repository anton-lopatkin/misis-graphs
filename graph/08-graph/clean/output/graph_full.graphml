    <edge source="УГЛЕРОД" target="ПРОИЗВЕДЕНИЕ РАСТВОРИМОСТИ">
      <data key="d10">1.0</data>
      <data key="d11">Произведение растворимости [Nb][C] определяется также содержанием углерода в стали</data>
      <data key="d12">173</data>
    </edge>
    <edge source="УГЛЕРОД" target="НАГРЕВ СЛЯБА">
      <data key="d10">9.0</data>
      <data key="d11">Температура нагрева определяется произведением [Nb][C], зависящим от содержания углерода</data>
      <data key="d12">165</data>
    </edge>
    <edge source="УГЛЕРОД" target="СТАЛЬ 0,09 % С И 0,058 % NB">
      <data key="d10">10.0</data>
      <data key="d11">Углерод — ключевой элемент, определяющий свойства и режимы обработки стали</data>
      <data key="d12">164</data>
    </edge>
    <edge source="УГЛЕРОД" target="БЕЙНИТНО-ФЕРРИТНАЯ СТАЛЬ">
      <data key="d10">8.0</data>
      <data key="d11">Чем ниже содержание углерода, тем эффективнее упрочнение за счёт бейнитного превращения и выше вязкость</data>
      <data key="d12">165</data>
    </edge>
    <edge source="УГЛЕРОД" target="ПРЕВРАЩЕНИЕ АУСТЕНИТА">
      <data key="d10">9.0</data>
      <data key="d11">Углерод является ключевым элементом, определяющим температурный интервал и тип превращения аустенита; его содержание и распределение влияют на склонность к образованию бейнита и мартенсита</data>
      <data key="d12">193</data>
    </edge>
    <edge source="УГЛЕРОД" target="УСКОРЕННОЕ ОХЛАЖДЕНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">Содержание углерода определяет поведение стали при ускоренном охлаждении</data>
      <data key="d12">433</data>
    </edge>
    <edge source="УГЛЕРОД" target="ЛЕГИРОВАНИЕ">
      <data key="d10">10.0</data>
      <data key="d11">Углерод — основной элемент легирования, определяющий прочность и склонность к образованию мартенсита</data>
      <data key="d12">176</data>
    </edge>
    <edge source="УГЛЕРОД" target="ГРУБАЯ СТРУКТУРА ВЕРХНЕГО БЕЙНИТА">
