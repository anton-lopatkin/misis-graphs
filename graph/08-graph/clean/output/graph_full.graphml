    <node id="ПРОКАТКА ПОСЛЕ СВЕРХНИЗКОГО НАГРЕВА">
      <data key="d0">ПРОКАТКА ПОСЛЕ СВЕРХНИЗКОГО НАГРЕВА</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Процесс прокатки при пониженной температуре нагрева (до 1000 °C), позволяющий снизить переходную температуру хрупкости</data>
      <data key="d3">1</data>
