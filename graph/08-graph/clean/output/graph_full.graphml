      <data key="d10">9.0</data>
      <data key="d11">Высокая степень деформации способствует эффективному измельчению зерна</data>
      <data key="d12">99</data>
    </edge>
    <edge source="СТЕПЕНЬ ДЕФОРМАЦИИ" target="ПОРОГ ХЛАДНОЛОМКОСТИ T₅₀">
