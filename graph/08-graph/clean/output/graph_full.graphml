      <data key="d12">98</data>
    </edge>
    <edge source="СОПРОТИВЛЕНИЕ РАЗРУШЕНИЮ" target="РАЗМЕР ПЕРЛИТНОЙ КОЛОНИИ">
      <data key="d10">6.0</data>
      <data key="d11">Влияние степени дисперсности перлитных колоний (4,5–10,5 мкм) на характеристики разрушения не установлено</data>
      <data key="d12">15</data>
    </edge>
