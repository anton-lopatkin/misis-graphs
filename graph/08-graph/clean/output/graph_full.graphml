      <data key="d12">116</data>
    </edge>
    <edge source="МАРГАНЕЦ" target="КРЕМНИЙ">
      <data key="d10">7.0</data>
      <data key="d11">Марганец и кремний являются легирующими элементами в марганцовисто-кремнистых сталях</data>
      <data key="d12">121</data>
    </edge>
    <edge source="МАРГАНЕЦ" target="СОДЕРЖАНИЕ МАРГАНЦА">
      <data key="d10">10.0</data>
      <data key="d11">Количественное содержание марганца влияет на соотношение [Mn]/[S] и предотвращение образования FeS</data>
      <data key="d12">84</data>
    </edge>
    <edge source="МАРГАНЕЦ" target="СТАЛЬ 12Г2СБ">
      <data key="d10">10.0</data>
