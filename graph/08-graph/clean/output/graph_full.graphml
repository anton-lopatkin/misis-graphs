    <node id="ЗАВЕРШЕНИЕ ДЕФОРМАЦИИ В Γ-ОБЛАСТИ">
      <data key="d0">ЗАВЕРШЕНИЕ ДЕФОРМАЦИИ В Γ-ОБЛАСТИ</data>
