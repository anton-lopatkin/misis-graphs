    <node id="ОЛАДЬЕОБРАЗНАЯ ФОРМА ЗЕРНА">
      <data key="d0">ОЛАДЬЕОБРАЗНАЯ ФОРМА ЗЕРНА</data>
      <data key="d1">СТРУКТУРА</data>
