    <node id="СВЕРХВЫСОКОПРОЧНАЯ ЛИСТОВАЯ СТАЛЬ">
      <data key="d0">СВЕРХВЫСОКОПРОЧНАЯ ЛИСТОВАЯ СТАЛЬ</data>
