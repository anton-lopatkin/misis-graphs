    <node id="МАРТЕНСИТНО-АУСТЕНИТНЫЙ СОСТАВЛЯЮЩИЙ">
      <data key="d0">МАРТЕНСИТНО-АУСТЕНИТНЫЙ СОСТАВЛЯЮЩИЙ</data>
