    <node id="ТЕХНОЛОГИЯ ПРОИЗВОДСТВА СТАЛИ">
      <data key="d0">ТЕХНОЛОГИЯ ПРОИЗВОДСТВА СТАЛИ</data>
      <data key="d1">ОБРАБОТКА</data>
