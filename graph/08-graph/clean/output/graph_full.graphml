    <node id="РАБОТА УДАРА ПО ШАРПИ">
      <data key="d0">РАБОТА УДАРА ПО ШАРПИ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Энергия, поглощённая образцом при ударе; составляет около 300 Дж при −30 °C и более 260 Дж при −50 °C)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">22</data>
      <data key="d6">262</data>
      <data key="d7">-1</data>
      <data key="d8">-1</data>
      <data key="d9">-1</data>
    </node>
    <node id="ФОРМИРОВАНИЕ МАРТЕНСИТА">
      <data key="d0">ФОРМИРОВАНИЕ МАРТЕНСИТА</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Фазовое превращение, происходящее при быстром охлаждении, приводящее к образованию мартенсита между зёрнами иррегулярного феррита)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">13</data>
      <data key="d6">195</data>
      <data key="d7">755</data>
