      <data key="d12">20</data>
    </edge>
    <edge source="УГЛЕРОДНЫЙ ЭКВИВАЛЕНТ C₃" target="СТРОИТЕЛЬНАЯ СТАЛЬ">
      <data key="d10">10.0</data>
      <data key="d11">Углеродный эквивалент C₃ используется для оценки степени легирования строительной стали и риска образования хрупких структур</data>
      <data key="d12">44</data>
    </edge>
    <edge source="СПЛОШНОСТЬ" target="УЛЬТРАЗВУКОВОЙ КОНТРОЛЬ">
