      <data key="d11">Для получения однородной структуры по толщине листа требуется достаточная прокаливаемость</data>
      <data key="d12">23</data>
    </edge>
    <edge source="ГРАДИЕНТ СТРУКТУРЫ" target="КОМПЛЕКС МЕХАНИЧЕСКИХ СВОЙСТВ">
      <data key="d10">8.0</data>
      <data key="d11">Целенаправленный градиент структуры (закалка у поверхности + диффузионные продукты в центре) улучшает комплекс свойств по сравнению со случайной неоднородностью</data>
      <data key="d12">5</data>
    </edge>
    <edge source="ВИД ДИАГРАММЫ НАПРЯЖЕНИЕ–ДЕФОРМАЦИЯ" target="СМЕШАННАЯ СТРУКТУРА">
      <data key="d10">9.0</data>
