    <node id="КОНЕЧНАЯ СТРУКТУРА ПРОКАТА">
      <data key="d0">КОНЕЧНАЯ СТРУКТУРА ПРОКАТА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Микроструктура готового проката, формируемая в результате превращения аустенита; зависит от условий чистовой прокатки и охлаждения)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">12</data>
      <data key="d6">174</data>
      <data key="d7">661</data>
      <data key="d8">-1</data>
