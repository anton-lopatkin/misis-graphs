    <node id="ТЕРМИЧЕСКАЯ ОБРАБОТКА ПОСЛЕ УСКОРЕННОГО ОХЛАЖДЕНИЯ">
      <data key="d0">ТЕРМИЧЕСКАЯ ОБРАБОТКА ПОСЛЕ УСКОРЕННОГО ОХЛАЖДЕНИЯ</data>
