      <data key="d11">Предел текучести σ_т = 460 МПа указан для данного профиля</data>
      <data key="d12">27</data>
    </edge>
    <edge source="Σ_Т" target="С345ПЛ">
      <data key="d10">10.0</data>
      <data key="d11">У стали С345ПЛ предел текучести составляет 475 МПа при толщине 20 мм</data>
      <data key="d12">29</data>
    </edge>
