    <node id="ПОВЫШЕНИЕ ПРОЧНОСТИ">
      <data key="d0">ПОВЫШЕНИЕ ПРОЧНОСТИ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Обобщённая характеристика, отражающая увеличение сопротивления материала пластической деформации в результате различных механизмов упрочнения</data>
