      <data key="d12">164</data>
    </edge>
    <edge source="ПРЕДЕЛ ТЕКУЧЕСТИ" target="ИСПЫТАНИЕ ПРИ ПОВЫШЕННЫХ ТЕМПЕРАТУРАХ">
      <data key="d10">9.0</data>
