      <data key="d11">Значение KCV⁻⁴⁰ определяется по результатам испытания на ударный изгиб при –40 °C</data>
      <data key="d12">28</data>
    </edge>
    <edge source="KCV⁻⁴⁰" target="18САТЮ">
