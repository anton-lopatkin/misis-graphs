    <node id="ИСПЫТАНИЕ НА СТОЙКОСТЬ К СЕРОВОДОРОДНОМУ РАСТРЕСКИВАНИЮ">
      <data key="d0">ИСПЫТАНИЕ НА СТОЙКОСТЬ К СЕРОВОДОРОДНОМУ РАСТРЕСКИВАНИЮ</data>
      <data key="d1">ИСПЫТАНИЕ</data>
      <data key="d2">Метод контроля склонности стали к растрескиванию в среде, содержащей H₂S, стандартизирован по NACE TM 02–84</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">22</data>
