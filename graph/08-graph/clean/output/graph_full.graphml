    <node id="СТАЛЬ ТИП 08Ю">
      <data key="d0">СТАЛЬ ТИП 08Ю</data>
      <data key="d1">СТАЛЬ</data>
      <data key="d2">Рядовая низкоуглеродистая сталь, используемая для сравнения с IF-сталью. Уступает по свойствам при глубокой вытяжке, имеет более высокое содержание углерода и хуже пластические характеристики</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">62</data>
      <data key="d7">377</data>
