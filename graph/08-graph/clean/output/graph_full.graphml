    <edge source="ТЕМПЕРАТУРА" target="Γ→Α ПРЕВРАЩЕНИЕ">
      <data key="d10">10.0</data>
      <data key="d11">Температура определяет начало и завершение γ→α-превращения, а также скорость диффузии углерода и подвижность границ раздела фаз</data>
      <data key="d12">39</data>
