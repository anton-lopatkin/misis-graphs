    <node id="ДОЛЯ РЕЕЧНОГО БЕЙНИТНОГО ФЕРРИТА">
      <data key="d0">ДОЛЯ РЕЕЧНОГО БЕЙНИТНОГО ФЕРРИТА</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Количественная характеристика объёмной доли реечного (пластинчатого) бейнитного феррита в микроструктуре, влияющая на вязкость)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
