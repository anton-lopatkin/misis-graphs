    </edge>
    <edge source="РАСПРЕДЕЛЕНИЕ МЕХАНИЧЕСКИХ СВОЙСТВ" target="СРЕДНЕЕ ЗНАЧЕНИЕ">
      <data key="d10">10.0</data>
