    <node id="ЦЕНТРАЛЬНАЯ ЗОНА">
      <data key="d0">ЦЕНТРАЛЬНАЯ ЗОНА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Центральная часть сляба или проката, где наблюдается повышенная концентрация легирующих элементов, аустенитной структуры и водорода из-за ограниченной диффузии</data>
      <data key="d3">2</data>
