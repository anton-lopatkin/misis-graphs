      <data key="d12">4</data>
    </edge>
    <edge source="СМОТКА ПОЛОСЫ В РУЛОН" target="ЭФФЕКТ ДИСПЕРСИОННОГО ТВЕРДЕНИЯ">
      <data key="d10">8.0</data>
      <data key="d11">Температура смотки влияет на возможность выделения карбонитридных частиц и проявление эффекта дисперсионного твердения</data>
      <data key="d12">7</data>
    </edge>
