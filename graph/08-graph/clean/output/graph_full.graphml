      <data key="d12">147</data>
    </edge>
    <edge source="КОНТРОЛИРУЕМАЯ ПРОКАТКА" target="ТЕРМОМЕХАНИЧЕСКИЙ КОНТРОЛИРУЕМЫЙ ПРОЦЕСС">
      <data key="d10">10.0</data>
