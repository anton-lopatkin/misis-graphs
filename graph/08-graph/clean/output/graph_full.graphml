      <data key="d12">65</data>
    </edge>
    <edge source="СТАЛЬ X70" target="Σ_В">
      <data key="d10">10.0</data>
      <data key="d11">Сталь X70 должна иметь временное сопротивление разрыву не менее 600 МПа</data>
      <data key="d12">64</data>
