      <data key="d1">ИСПЫТАНИЕ</data>
      <data key="d2">Определение ударной вязкости на образце с круглым надрезом; более чувствительно к структурной однородности</data>
      <data key="d3">1</data>
      <data key="d4">0</data>
      <data key="d5">-1</data>
      <data key="d6">-1</data>
