      <data key="d12">49</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА УДАРНЫЙ ИЗГИБ" target="НИЗКОТЕМПЕРАТУРНАЯ ВЯЗКОСТЬ">
      <data key="d10">10.0</data>
