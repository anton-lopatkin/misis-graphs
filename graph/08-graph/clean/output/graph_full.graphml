      <data key="d12">6</data>
    </edge>
    <edge source="СВОЙСТВА ПО ТОЛЩИНЕ ПРОКАТА" target="ГРАДИЕНТ ТЕМПЕРАТУРЫ ПО ТОЛЩИНЕ ЛИСТА">
