    </node>
    <node id="ПАКЕТ БЕЙНИТНОГО ФЕРРИТА">
      <data key="d0">ПАКЕТ БЕЙНИТНОГО ФЕРРИТА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Группа параллельных или близко расположенных пластин бейнитного феррита, образующих единую морфологическую область&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">13</data>
      <data key="d6">190</data>
      <data key="d7">726</data>
      <data key="d8">-1</data>
      <data key="d9">-1</data>
    </node>
    <node id="МЕЛКОЕ ЗЕРНО ФЕРРИТ">
      <data key="d0">МЕЛКОЕ ЗЕРНО ФЕРРИТ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Ферритные зёрна размером 2–3 мкм, обладающие повышенной прочностью за счёт эффекта упрочнения мелким зерном&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">13</data>
      <data key="d6">190</data>
      <data key="d7">726</data>
      <data key="d8">-1</data>
