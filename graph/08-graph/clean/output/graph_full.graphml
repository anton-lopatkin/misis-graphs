      <data key="d9">-1</data>
    </node>
    <node id="ФАСЕТКА СКОЛА">
      <data key="d0">ФАСЕТКА СКОЛА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Микроскопическая плоская поверхность на изломе, соответствующая отдельному участку разрушения по кристаллографической плоскости; формирует ручьистый узор)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">4</data>
      <data key="d5">19</data>
      <data key="d6">239</data>
      <data key="d7">866</data>
