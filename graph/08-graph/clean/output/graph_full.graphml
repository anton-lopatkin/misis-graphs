      <data key="d9">-1</data>
    </node>
    <node id="АКТИВНАЯ МЕЖФАЗНАЯ ГРАНИЦА">
      <data key="d0">АКТИВНАЯ МЕЖФАЗНАЯ ГРАНИЦА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Подвижная граница раздела между ферритом и аустенитом (аллотриоморфный феррит), способная служить центром зарождения бейнита</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">12</data>
      <data key="d6">176</data>
      <data key="d7">671</data>
      <data key="d8">1012</data>
