      <data key="d12">10</data>
    </edge>
    <edge source="ИСПЫТАНИЕ ПАДАЮЩИМ ГРУЗОМ⁻²⁰" target="СТАЛЬ МАРКИ 10Г2ФБЮО">
      <data key="d10">8.0</data>
      <data key="d11">Сталь марки 10Г2ФБЮО должна гарантировать результаты испытаний падающим грузом при –20 °C</data>
      <data key="d12">5</data>
    </edge>
    <edge source="РЕЖИМ ВЫСОКОТЕМПЕРАТУРНОЙ ТЕРМОМЕХАНИЧЕСКОЙ ОБРАБОТКИ" target="ЛИСТ ДО 16 ММ">
      <data key="d10">10.0</data>
