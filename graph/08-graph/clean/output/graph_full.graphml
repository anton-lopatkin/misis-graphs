    <node id="ФОСФОРИСТОСЕРНИСТОЕ СОЕДИНЕНИЕ">
      <data key="d0">ФОСФОРИСТОСЕРНИСТОЕ СОЕДИНЕНИЕ</data>
      <data key="d1">ФАЗА</data>
      <data key="d2">Легкоплавкая фаза, выделяющаяся по границам зерен при наличии фосфора и серы; способствует зернограничной хрупкости и хрупкому разрушению стали</data>
      <data key="d3">1</data>
