    </node>
    <node id="СЕТЬ ГРАНИЦ ЗЕРНА АУСТЕНИТА">
      <data key="d0">СЕТЬ ГРАНИЦ ЗЕРНА АУСТЕНИТА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Сохраняющаяся в некоторых структурах (например, бейнит) следовая структура, отражающая первоначальные границы аустенитных зерен; в игольчатом феррите она не обнаруживается&gt;</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">13</data>
      <data key="d6">189</data>
      <data key="d7">722</data>
