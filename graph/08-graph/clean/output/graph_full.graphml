    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="СТРУКТУРА ОПРЕДЕЛЁННОГО ТИПА">
      <data key="d10">10.0</data>
      <data key="d11">Наличие структуры определённого типа (например, мелкозернистой) является основным фактором высокой хладостойкости</data>
