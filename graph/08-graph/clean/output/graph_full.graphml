    <node id="БЛОЧНЫЙ МАРТЕНСИТ">
      <data key="d0">БЛОЧНЫЙ МАРТЕНСИТ</data>
      <data key="d1">ФАЗА</data>
      <data key="d2">Разновидность мартенсита, имеющая блочную (равноосную) форму и очень высокую плотность дислокаций, присутствует в составе М/А частиц</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
