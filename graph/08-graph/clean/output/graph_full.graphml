    </edge>
    <edge source="СКОРОСТЬ ОХЛАЖДЕНИЯ" target="УСЛОВИЕ ПОСЛЕДЕФОРМАЦИОННОГО ОХЛАЖДЕНИЯ">
      <data key="d10">10.0</data>
