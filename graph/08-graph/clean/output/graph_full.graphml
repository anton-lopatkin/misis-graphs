    <edge source="ХОЛОДНАЯ ПРОКАТКА" target="МИКРОЛЕГИРОВАННАЯ ВЫСОКОПРОЧНАЯ ХОЛОДНОКАТАНАЯ ПОЛОСА">
      <data key="d10">9.0</data>
      <data key="d11">Производится методом холодной прокатки</data>
      <data key="d12">9</data>
    </edge>
    <edge source="DP 600" target="ГОРЯЧЕКАТАНЫЙ">
      <data key="d10">1.0</data>
      <data key="d11">DP 600 может производиться в горячекатаном состоянии, что указано в тексте</data>
