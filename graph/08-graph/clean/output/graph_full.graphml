    <node id="ПРЕВРАЩЕНИЕ АУСТЕНИТА В ФЕРРИТ И ПЕРЛИТ">
      <data key="d0">ПРЕВРАЩЕНИЕ АУСТЕНИТА В ФЕРРИТ И ПЕРЛИТ</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Фазовое превращение при охлаждении, приводящее к образованию ультрамелкозернистой структуры&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">20</data>
