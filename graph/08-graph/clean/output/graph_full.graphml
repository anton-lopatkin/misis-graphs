    <node id="ОПТИМИЗАЦИЯ СОСТАВА СТАЛИ">
      <data key="d0">ОПТИМИЗАЦИЯ СОСТАВА СТАЛИ</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Процесс подбора химического состава стали в соответствии с заданными требованиями к свойствам и технологии обработки)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">3</data>
      <data key="d5">22</data>
