    <edge source="НИЗКОУГЛЕРОДИСТЫЙ БЕЙНИТ" target="НИЗКОУГЛЕРОДИСТАЯ БЕЙНИТНАЯ СТАЛЬ">
      <data key="d10">10.0</data>
