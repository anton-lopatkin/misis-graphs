      <data key="d12">110</data>
    </edge>
    <edge source="ВАНАДИЙ" target="СТАЛЬ 1522">
      <data key="d10">9.0</data>
      <data key="d11">Ванадий — микролегирующий элемент в стали 1522, способствующий дисперсионному упрочнению</data>
      <data key="d12">100</data>
    </edge>
    <edge source="ВАНАДИЙ" target="X56">
      <data key="d10">8.0</data>
      <data key="d11">Ванадий способствует упрочнению через образование карбидов в стали X56</data>
      <data key="d12">104</data>
    </edge>
    <edge source="ВАНАДИЙ" target="SAWL 485 IDF">
      <data key="d10">16.0</data>
      <data key="d11">Ванадий (0,033 %) участвует в дисперсионном упрочнении и образовании карбонитридов</data>
