    <node id="НЕОДНОРОДНОСТЬ ОХЛАЖДЕНИЯ">
      <data key="d0">НЕОДНОРОДНОСТЬ ОХЛАЖДЕНИЯ</data>
      <data key="d1">ДЕФЕКТ</data>
      <data key="d2">Неравномерное распределение температуры по сечению проката, приводящее к внутренним напряжениям и короблению&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">-1</data>
