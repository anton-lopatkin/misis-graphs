      <data key="d12">28</data>
    </edge>
    <edge source="ИНТЕНСИВНОЕ ОХЛАЖДЕНИЕ" target="ТУРБУЛЕНТНЫЙ ПОТОК ВОДЫ">
      <data key="d10">10.0</data>
