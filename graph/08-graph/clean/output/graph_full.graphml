    <node id="ТЕМПЕРАТУРА 830–790 °C">
      <data key="d0">ТЕМПЕРАТУРА 830–790 °C</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Температурный интервал завершения прокатки в технологии производства листового проката из стали К55. Обеспечивает незавершённую рекристаллизацию аустенита и последующее формирование мелкозернистой феррито-перлитной структуры при ускоренном охлаждении)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">12</data>
      <data key="d6">175</data>
      <data key="d7">664</data>
