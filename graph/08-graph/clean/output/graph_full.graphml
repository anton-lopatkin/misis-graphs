      <data key="d10">9.0</data>
      <data key="d11">Феррит преимущественно зарождается в зонах с высокой плотностью несовершенств, например, в полосах деформации</data>
      <data key="d12">17</data>
    </edge>
    <edge source="ЗАРОЖДЕНИЕ ФЕРРИТА" target="УДЕЛЬНАЯ МЕЖФАЗНАЯ ПОВЕРХНОСТЬ АУСТЕНИТА S_V">
      <data key="d10">8.0</data>
