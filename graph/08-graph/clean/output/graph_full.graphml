    <node id="ЭКСПЕРИМЕНТАЛЬНЫЕ ДАННЫЕ">
      <data key="d0">ЭКСПЕРИМЕНТАЛЬНЫЕ ДАННЫЕ</data>
      <data key="d1">ИСПЫТАНИЕ</data>
      <data key="d2">Результаты измерений, полученные при исследовании влияния температуры аустенитизации на структуру и свойства стали&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">18</data>
      <data key="d6">224</data>
      <data key="d7">832</data>
      <data key="d8">-1</data>
