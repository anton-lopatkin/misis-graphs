      <data key="d12">9</data>
    </edge>
    <edge source="ВИДМАНШТЕТТЕН ФЕРРИТ" target="КРУПНЫЙ ВЫТЯНУТЫЙ ПЛАСТИНА ФЕРРИТ">
      <data key="d10">10.0</data>
      <data key="d11">Видманштеттен феррит состоит из крупных вытянутых пластин феррита, что определяет его морфологию</data>
