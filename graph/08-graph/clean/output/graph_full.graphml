      <data key="d11">Начальное давление газа определяет форму кривой декомпрессии, которая задаёт движущую силу для трещины</data>
      <data key="d12">5</data>
    </edge>
    <edge source="ВНЕШНЕЕ ОГРАНИЧЕНИЕ" target="СОПРОТИВЛЕНИЕ ТРУБА РАЗВИТИЮ ВЯЗКОЙ ТРЕЩИНЫ">
