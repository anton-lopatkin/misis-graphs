    <node id="НИЗКОТЕМПЕРАТУРНЫЙ ОБРАБОТКА">
      <data key="d0">НИЗКОТЕМПЕРАТУРНЫЙ ОБРАБОТКА</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Этап контролируемой прокатки, при котором деформация происходит в области подавленной рекристаллизации аустенита, способствуя измельчению зерна</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">12</data>
      <data key="d6">180</data>
      <data key="d7">709</data>
      <data key="d8">-1</data>
