    <node id="ТЕМПЕРАТУРА ИСПЫТАНИЯ НА УДАРНУЮ ВЯЗКОСТЬ">
      <data key="d0">ТЕМПЕРАТУРА ИСПЫТАНИЯ НА УДАРНУЮ ВЯЗКОСТЬ</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Параметр испытания, при котором определяется ударная вязкость стали, например, −40 °C, −60 °C, −69 °C</data>
