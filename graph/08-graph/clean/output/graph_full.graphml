      <data key="d10">9.0</data>
      <data key="d11">Сталь испытывается в сероводородной среде для определения склонности к растрескиванию</data>
      <data key="d12">343</data>
    </edge>
    <edge source="СТАЛЬ" target="ПОРИСТОСТЬ">
