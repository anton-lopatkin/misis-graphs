      <data key="d12">21</data>
    </edge>
    <edge source="СТРУКТУРА ПО СЕЧЕНИЮ ПРОКАТА" target="ОДНОРОДНОСТЬ СТРУКТУРЫ">
      <data key="d10">10.0</data>
      <data key="d11">Однородность структуры — это характеристика, описывающая равномерность структуры по сечению проката</data>
      <data key="d12">16</data>
    </edge>
    <edge source="СТРУКТУРА ПО СЕЧЕНИЮ ПРОКАТА" target="ПРОЧНОСТНЫЕ СВОЙСТВА">
      <data key="d10">8.0</data>
      <data key="d11">Неоднородность структуры снижает прочностные свойства по сравнению с однородной структурой</data>
