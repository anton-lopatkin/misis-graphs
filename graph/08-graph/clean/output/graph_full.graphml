    <node id="МАРТЕНСИТ/АУСТЕНИТ">
      <data key="d0">МАРТЕНСИТ/АУСТЕНИТ</data>
      <data key="d1">ФАЗА</data>
      <data key="d2">М/А-составляющая — агрегат из мартенсита и остаточного аустенита, образующийся при неполном превращении высокоуглеродистого аустенита</data>
      <data key="d3">1</data>
