      <data key="d12">15</data>
    </edge>
    <edge source="ДИСПЕРСНАЯ ЧАСТИЦА" target="РАБОТА М.И. ГОЛЬДШТЕЙН С СОТРУДНИК">
      <data key="d10">9.0</data>
