      <data key="d12">54</data>
    </edge>
    <edge source="ПЛОТНОСТЬ ДИСЛОКАЦИЙ" target="НАКЛЕП">
      <data key="d10">10.0</data>
      <data key="d11">Наклеп приводит к увеличению плотности дислокаций в стали</data>
      <data key="d12">66</data>
    </edge>
    <edge source="ПЛОТНОСТЬ ДИСЛОКАЦИЙ" target="СТАЛЬ СЕВЕРНОЕ ИСПОЛНЕНИЕ">
      <data key="d10">8.0</data>
      <data key="d11">В сталях северного исполнения плотность дислокаций составляет 10⁸–10⁹ см⁻², что соответствует слабому наклепу</data>
      <data key="d12">70</data>
    </edge>
    <edge source="ПЛОТНОСТЬ ДИСЛОКАЦИЙ" target="ВНЕШНИЙ СЛОЙ ПРОКАТА">
      <data key="d10">9.0</data>
