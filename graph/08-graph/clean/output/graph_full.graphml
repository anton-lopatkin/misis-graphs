    </edge>
    <edge source="РАЗМЕР ЗЕРНА АУСТЕНИТА" target="ЗЕРНОГРАНИЧНОЕ УПРОЧНЕНИЕ">
      <data key="d10">1.0</data>
      <data key="d11">Мелкий размер зерна аустенита приводит к мелкозернистой структуре феррита и, соответственно, к зернограничному упрочнению</data>
