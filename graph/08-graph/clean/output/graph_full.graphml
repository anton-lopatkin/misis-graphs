    </edge>
    <edge source="УСКОРЕННОЕ ОХЛАЖДЕНИЕ" target="СТАЛЬ КЛАСС ПРОЧНОСТИ X65">
      <data key="d10">9.0</data>
      <data key="d11">Ускоренное охлаждение после прокатки применяется для стали X65, способствуя образованию бейнита и повышению прочности</data>
      <data key="d12">295</data>
