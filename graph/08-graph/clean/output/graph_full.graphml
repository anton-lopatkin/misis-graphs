      <data key="d12">88</data>
    </edge>
    <edge source="СЕРА" target="СТАЛЬ 17Г1СУ">
      <data key="d10">8.0</data>
      <data key="d11">Содержание серы в стали 17Г1СУ — до 0,016 %, выше, чем в новых марках</data>
      <data key="d12">85</data>
    </edge>
