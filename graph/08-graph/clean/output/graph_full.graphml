      <data key="d10">9.0</data>
      <data key="d11">Ориентировка {111} &lt;112&gt; — важный компонент текстуры, способствующий улучшению свойств</data>
      <data key="d12">19</data>
    </edge>
    <edge source="ТЕКСТУРА" target="ПРЕВРАЩЕНИЕ ИЗ НЕРЕКРИСТАЛЛИЗОВАННОГО АУСТЕНИТА">
      <data key="d10">10.0</data>
      <data key="d11">Превращение из нерекристаллизованного аустенита приводит к усилению текстуры, особенно компонента {112} &lt;110&gt;</data>
      <data key="d12">19</data>
    </edge>
    <edge source="ТЕКСТУРА" target="НЕРЕКРИСТАЛЛИЗОВАННЫЙ АУСТЕНИТ">
