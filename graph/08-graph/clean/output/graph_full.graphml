    <node id="Α-ОБЛАСТЬ">
      <data key="d0">Α-ОБЛАСТЬ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Область температур ниже Ar₃, где основной фазой является феррит; прокатка в этой области формирует дислокационную структуру уже в феррите</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">20</data>
      <data key="d6">241</data>
      <data key="d7">868</data>
