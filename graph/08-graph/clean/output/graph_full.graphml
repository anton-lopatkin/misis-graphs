      <data key="d0">ПЛОСКОСТЬ (112)</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Кристаллографическая плоскость, на которой может происходить разрушение или образование фрагментов при хрупком сколе; упоминается как возможный источник «языков» на изломе)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">19</data>
      <data key="d6">239</data>
      <data key="d7">866</data>
      <data key="d8">-1</data>
      <data key="d9">-1</data>
    </node>
    <node id="ГРАНИЦА СКРУЧИВАНИЯ">
      <data key="d0">ГРАНИЦА СКРУЧИВАНИЯ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Тип малоуглового границы раздела, образованной вращением вокруг оси; участвует в передаче трещины между фасетками при «ручейистом» узоре)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">19</data>
      <data key="d6">239</data>
      <data key="d7">866</data>
      <data key="d8">-1</data>
      <data key="d9">-1</data>
    </node>
    <node id="ГРАНИЦА СКРУЧИВАНИЯ С НАКЛОНОМ">
      <data key="d0">ГРАНИЦА СКРУЧИВАНИЯ С НАКЛОНОМ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Комбинированная граница, сочетающая элементы скручивания и наклона; определяет характер перехода «ручья» между фасетками)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">0</data>
      <data key="d5">-1</data>
      <data key="d6">-1</data>
      <data key="d7">-1</data>
