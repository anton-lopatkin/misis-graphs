      <data key="d10">9.0</data>
      <data key="d11">Оба являются разновидностями бейнитной структуры, отличающимися по морфологии и условиям образования</data>
      <data key="d12">93</data>
    </edge>
    <edge source="ГРАНУЛЯРНЫЙ БЕЙНИТ" target="ТЕМПЕРАТУРНЫЙ ИНТЕРВАЛ ПРЕВРАЩЕНИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Гранулярный бейнит образуется при более высоких температурах превращения</data>
      <data key="d12">43</data>
    </edge>
    <edge source="ГРАНУЛЯРНЫЙ БЕЙНИТ" target="ПРЕРВАННАЯ ЗАКАЛКА">
      <data key="d10">9.0</data>
      <data key="d11">Метод прерванной закалки позволяет установить, что гранулярный бейнит формируется при более высоких температурах</data>
      <data key="d12">43</data>
    </edge>
    <edge source="ГРАНУЛЯРНЫЙ БЕЙНИТ" target="ФЕРРИТНАЯ МАТРИЦА">
