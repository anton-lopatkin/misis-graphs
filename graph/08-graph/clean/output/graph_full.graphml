      <data key="d12">30</data>
    </edge>
    <edge source="ТЕМПЕРАТУРА ОКОНЧАНИЯ ПРОКАТКИ" target="МЕХАНИЧЕСКОЕ СВОЙСТВО">
      <data key="d10">8.0</data>
      <data key="d11">Изменение температуры окончания прокатки влияет на прочность и вязкость, особенно в сталях с промежуточной структурой</data>
      <data key="d12">37</data>
    </edge>
    <edge source="ТЕМПЕРАТУРА ОКОНЧАНИЯ ПРОКАТКИ" target="УСТОЙЧИВОСТЬ АУСТЕНИТА">
      <data key="d10">8.0</data>
      <data key="d11">Температура окончания прокатки определяет степень наклёпа и, следовательно, устойчивость аустенита к превращению</data>
      <data key="d12">33</data>
    </edge>
    <edge source="ТЕМПЕРАТУРА ОКОНЧАНИЯ ПРОКАТКИ" target="РИС. 5.31">
      <data key="d10">10.0</data>
