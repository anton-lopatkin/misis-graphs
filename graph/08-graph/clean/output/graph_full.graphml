    </edge>
    <edge source="КРЕМНИЙ" target="V(C,N)">
      <data key="d10">8.0</data>
      <data key="d11">Кремний усиливает выделение частиц V(C,N) из аустенита</data>
      <data key="d12">47</data>
    </edge>
