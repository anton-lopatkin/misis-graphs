    </node>
    <node id="НЕПОЛНАЯ РЕКРИСТАЛЛИЗАЦИЯ АУСТЕНИТА">
      <data key="d0">НЕПОЛНАЯ РЕКРИСТАЛЛИЗАЦИЯ АУСТЕНИТА</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Явление, при котором часть аустенитного зерна не рекристаллизуется, приводящее к разнозернистости и грубому бейниту</data>
      <data key="d3">1</data>
      <data key="d4">3</data>
      <data key="d5">15</data>
      <data key="d6">216</data>
      <data key="d7">824</data>
