    <node id="ПРЕДЕЛ УСТАЛОСТИ">
      <data key="d0">ПРЕДЕЛ УСТАЛОСТИ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Способность материала противостоять циклическим нагрузкам; у стали NANOHITEN повышается пропорционально росту прочности)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">11</data>
      <data key="d6">163</data>
      <data key="d7">614</data>
      <data key="d8">991</data>
