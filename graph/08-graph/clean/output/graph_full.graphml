    <node id="ОБЪЕМНО-НАПРЯЖЕННОЕ СОСТОЯНИЕ">
      <data key="d0">ОБЪЕМНО-НАПРЯЖЕННОЕ СОСТОЯНИЕ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Напряженное состояние в зоне надреза, при котором действуют растягивающие напряжения, способствующие хрупкому разрушению</data>
      <data key="d3">1</data>
      <data key="d4">4</data>
      <data key="d5">18</data>
