    <node id="КОНЕЧНАЯ ТЕМПЕРАТУРА ОХЛАЖДЕНИЯ">
      <data key="d0">КОНЕЧНАЯ ТЕМПЕРАТУРА ОХЛАЖДЕНИЯ</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Температура, до которой охлаждали прокат после деформации — 410–450 °C, определяет завершение фазовых превращений</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">67</data>
