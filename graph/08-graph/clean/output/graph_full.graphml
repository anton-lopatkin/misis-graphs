      <data key="d10">8.0</data>
      <data key="d11">Мартенсит травится более равномерно из-за равномерного распределения углерода, что помогает его идентифицировать</data>
      <data key="d12">113</data>
    </edge>
    <edge source="МАРТЕНСИТ" target="БЕЙНИТНЫЙ ФЕРРИТ">
