    </edge>
    <edge source="КРЕМНИЙ" target="R-2">
      <data key="d10">8.0</data>
      <data key="d11">Плавка R-2 содержит 0,85% кремния — одно из самых высоких значений, используется для раскисления и упрочнения</data>
