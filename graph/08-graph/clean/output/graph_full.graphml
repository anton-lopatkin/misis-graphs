    <node id="ФЕРРИТО-МАРТЕНСИТНАЯ СТРУКТУРА">
      <data key="d0">ФЕРРИТО-МАРТЕНСИТНАЯ СТРУКТУРА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Дуплексная структура, состоящая из феррита и мартенсита; формируется при неполном превращении аустенита и обеспечивает высокую прочность)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">12</data>
