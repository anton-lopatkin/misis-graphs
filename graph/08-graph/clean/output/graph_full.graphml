      <data key="d12">84</data>
    </edge>
    <edge source="МАРГАНЕЦ" target="МАРГАНЦОВИСТАЯ СТАЛЬ">
      <data key="d10">10.0</data>
      <data key="d11">Марганец является основным легирующим элементом в марганцовистых сталях, повышающим их прочность</data>
      <data key="d12">83</data>
    </edge>
    <edge source="МАРГАНЕЦ" target="СТАЛЬ 07ГФБ">
