    </edge>
    <edge source="ЗЕРНО АУСТЕНИТА" target="ВИДМАНШТЕТТОВ ФЕРРИТ">
      <data key="d10">8.0</data>
      <data key="d11">Видманштеттов феррит зарождается на границах аустенитных зёрен и растёт внутрь зерна</data>
