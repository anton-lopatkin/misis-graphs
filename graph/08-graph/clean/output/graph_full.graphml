      <data key="d12">42</data>
    </edge>
    <edge source="ЗАМЕДЛЕННОЕ ОХЛАЖДЕНИЕ" target="ТЕРМОДИФФУЗИОННАЯ ОБРАБОТКА">
      <data key="d10">10.0</data>
      <data key="d11">Термодиффузионная обработка включает в себя замедленное охлаждение как ключевую стадию</data>
      <data key="d12">36</data>
    </edge>
    <edge source="ЗАМЕДЛЕННОЕ ОХЛАЖДЕНИЕ" target="ТЕМПЕРАТУРА УКЛАДКИ ЛИСТОВ В ШТАБЕЛЬ">
      <data key="d10">9.0</data>
      <data key="d11">Температура укладки — один из основных параметров режима замедленного охлаждения</data>
      <data key="d12">32</data>
    </edge>
    <edge source="ЗАМЕДЛЕННОЕ ОХЛАЖДЕНИЕ" target="ТЕМПЕРАТУРА ЗАВЕРШЕНИЯ ЗАМЕДЛЕННОГО ОХЛАЖДЕНИЯ">
      <data key="d10">8.0</data>
