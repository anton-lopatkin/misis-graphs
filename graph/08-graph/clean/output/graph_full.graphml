      <data key="d12">8</data>
    </edge>
    <edge source="ПРЕВРАЩЕНИЕ АУСТЕНИТА В ФЕРРИТ" target="НЕРЕКРИСТАЛЛИЗОВАННАЯ СТРУКТУРА АУСТЕНИТА">
      <data key="d10">9.0</data>
