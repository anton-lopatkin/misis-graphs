      <data key="d11">Сталь X70 имеет временное сопротивление не менее 600 МПа, что подтверждает её высокую прочность</data>
      <data key="d12">7</data>
    </edge>
    <edge source="УДАРНАЯ ВЯЗКОСТЬ KCV⁻⁴⁰" target="ЛИСТ ДО 16 ММ">
      <data key="d10">8.0</data>
