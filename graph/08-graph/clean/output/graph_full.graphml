    </node>
    <node id="СТАЛЬ X52">
      <data key="d0">СТАЛЬ X52</data>
      <data key="d1">СТАЛЬ</data>
      <data key="d2">Трубная сталь класса прочности X52, применяемая в нефтегазовой промышленности, с минимальным пределом прочности 455 МПа и пределом текучести 358 МПа</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">55</data>
      <data key="d7">343</data>
