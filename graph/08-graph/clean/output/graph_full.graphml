    <node id="АГРЕГАТ">
      <data key="d0">АГРЕГАТ</data>
      <data key="d1">ОБОРУДОВАНИЕ</data>
      <data key="d2">Технологическое оборудование, используемое в металлургии, включая установки для ковшевой металлургии, позволяющие улучшить чистоту стали.</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
