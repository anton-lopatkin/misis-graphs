      <data key="d12">6</data>
    </edge>
    <edge source="ТЕМПЕРАТУРА НАГРЕВА ПОД ПРОКАТКУ" target="ПОВЫШЕНИЕ СОДЕРЖАНИЯ НИОБИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Повышенное содержание ниобия требует более высокой температуры нагрева для полного растворения карбонитридов</data>
      <data key="d12">5</data>
    </edge>
    <edge source="ПОСЛЕДЕФОРМАЦИОННОЕ УСКОРЕННОЕ ОХЛАЖДЕНИЕ" target="ПОНИЖЕННАЯ СКОРОСТЬ ОХЛАЖДЕНИЯ">
      <data key="d10">8.0</data>
      <data key="d11">Ускоренное охлаждение компенсирует негативное влияние медленного охлаждения на структуру</data>
      <data key="d12">10</data>
    </edge>
