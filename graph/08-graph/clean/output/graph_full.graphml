    </edge>
    <edge source="МОДИФИЦИРОВАНИЕ НЕМЕТАЛЛИЧЕСКИХ ВКЛЮЧЕНИЙ" target="МИКРОЛЕГИРОВАНИЕ РЗМ">
      <data key="d10">8.0</data>
      <data key="d11">Микролегирование редкоземельными металлами способствует изменению формы и состава сульфидов</data>
