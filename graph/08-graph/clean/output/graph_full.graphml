    <node id="СПЕЦИАЛЬНОЕ ПРИСПОСОБЛЕНИЕ">
      <data key="d0">СПЕЦИАЛЬНОЕ ПРИСПОСОБЛЕНИЕ</data>
      <data key="d1">ОБОРУДОВАНИЕ</data>
      <data key="d2">Устройство для интенсивного охлаждения проката после деформации, позволяющее управлять структурообразованием</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">15</data>
      <data key="d6">213</data>
      <data key="d7">813</data>
