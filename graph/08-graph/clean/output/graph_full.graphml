    <node id="КРАСНОЛОМКОСТЬ">
      <data key="d0">КРАСНОЛОМКОСТЬ</data>
      <data key="d1">ДЕФЕКТ</data>
      <data key="d2">Склонность стали к образованию трещин при высоких температурах, особенно в процессе прокатки или сварки; вызывается избытком меди в металле</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">11</data>
      <data key="d6">165</data>
      <data key="d7">624</data>
      <data key="d8">-1</data>
