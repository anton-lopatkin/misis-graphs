    <node id="ПРОКАТ ТОЛЩИНОЙ 30 ММ">
      <data key="d0">ПРОКАТ ТОЛЩИНОЙ 30 ММ</data>
      <data key="d1">ИЗДЕЛИЕ</data>
      <data key="d2">Полуфабрикат из стали, производимый по технологии контролируемой прокатки, требует баланса между прочностью, вязкостью и технологичностью)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">14</data>
      <data key="d6">201</data>
      <data key="d7">764</data>
