      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">99</data>
      <data key="d7">455</data>
      <data key="d8">963</data>
      <data key="d9">-1</data>
    </node>
    <node id="УРАВНЕНИЕ KCV = A·S^B">
      <data key="d0">УРАВНЕНИЕ KCV = A·S^B</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Математическая модель, описывающая количественную зависимость ударной вязкости (KCV) от содержания серы (S). Параметры a и b зависят от состояния стали: после нормализации и после механического старения</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
