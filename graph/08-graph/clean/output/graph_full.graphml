    <edge source="СТАЛЬ" target="МИКРОТВЁРДОСТЬ">
      <data key="d10">8.0</data>
      <data key="d11">Микротвёрдость измеряется в разных зонах стали, в осевой зоне может достигать HV300</data>
      <data key="d12">339</data>
    </edge>
    <edge source="СТАЛЬ" target="ИСПЫТАНИЕ НА ВОДОРОДНОЕ РАСТРЕСКИВАНИЕ">
