      <data key="d12">64</data>
    </edge>
    <edge source="МАЛОУГЛЕРОДИСТАЯ СТАЛЬ" target="НИЗКОЛЕГИРОВАННАЯ СТАЛЬ">
      <data key="d10">1.0</data>
      <data key="d11">Обе группы сталей исследуются по влиянию углерода на свойства, имеют схожие закономерности изменения прочности и вязкости</data>
      <data key="d12">64</data>
