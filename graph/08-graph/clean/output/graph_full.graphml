    <node id="ПАКЕТ ПАРАЛЛЕЛЬНАЯ ПЛАСТИНА">
      <data key="d0">ПАКЕТ ПАРАЛЛЕЛЬНАЯ ПЛАСТИНА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Характерная морфология бейнитного феррита, состоящая из группы параллельных реек или пластин, образующих пакетную структуру</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">13</data>
      <data key="d6">189</data>
      <data key="d7">722</data>
