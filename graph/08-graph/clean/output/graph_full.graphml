    <node id="ОБОРУДОВАНИЕ С ШИРОКИМ ИНТЕРВАЛОМ ТЕХНОЛОГИЧЕСКИХ ВОЗМОЖНОСТЕЙ">
      <data key="d0">ОБОРУДОВАНИЕ С ШИРОКИМ ИНТЕРВАЛОМ ТЕХНОЛОГИЧЕСКИХ ВОЗМОЖНОСТЕЙ</data>
