      <data key="d0">РАБОЧЕЕ ДАВЛЕНИЕ 11,8 МПА</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Высокое давление в трубопроводе, предъявляющее повышенные требования к прочности и толщине стенки труб</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">7</data>
      <data key="d6">124</data>
