      <data key="d12">97</data>
    </edge>
    <edge source="ВАНАДИЙ" target="ЭКОНОМИЧНОЕ ЛЕГИРОВАНИЕ">
      <data key="d10">1.0</data>
      <data key="d11">Ванадий применяется в малых количествах для значительного упрочнения, что соответствует принципу экономичного легирования</data>
      <data key="d12">95</data>
    </edge>
    <edge source="ВАНАДИЙ" target="СТАЛЬ КЛАССА ПРОЧНОСТИ X70">
      <data key="d10">7.0</data>
      <data key="d11">Ванадий использовался в составе стали X70, но при совершенной технологии может быть исключён</data>
      <data key="d12">97</data>
    </edge>
