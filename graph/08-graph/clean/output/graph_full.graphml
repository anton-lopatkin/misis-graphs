    <node id="ВЫСОКАЯ ПЛОТНОСТЬ ДИСЛОКАЦИЙ">
      <data key="d0">ВЫСОКАЯ ПЛОТНОСТЬ ДИСЛОКАЦИЙ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Характеристика реечного бейнитного феррита, проявляющаяся в виде плотности дислокаций ~10¹⁰–10¹¹ см⁻², способствующая упрочнению металла</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">13</data>
      <data key="d6">189</data>
