    </node>
    <node id="ОПТИМИЗАЦИЯ ТЕМПЕРАТУРЫ НАГРЕВА">
      <data key="d0">ОПТИМИЗАЦИЯ ТЕМПЕРАТУРЫ НАГРЕВА</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Технологическая задача подбора оптимальной температуры нагрева перед прокаткой для управления структурой)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">15</data>
