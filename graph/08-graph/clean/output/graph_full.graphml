    <node id="ЗЕРНИСТАЯ ФОРМА АУСТЕНИТА">
      <data key="d0">ЗЕРНИСТАЯ ФОРМА АУСТЕНИТА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Форма остаточного аустенита, приобретённая под действием растущего непластинчатого феррита; принимает зернистую или равноосную морфологию в гранулярном бейните</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">13</data>
      <data key="d6">193</data>
      <data key="d7">745</data>
