      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Температура, при которой дисперсные фазы полностью растворяются в аустените, определяемая термодинамикой системы</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">8</data>
