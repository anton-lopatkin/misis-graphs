      <data key="d10">8.0</data>
      <data key="d11">Сталь X100 подвергается горячей прокатке на Dillinger Hüttenwerke как часть термомеханического процесса для формирования благоприятной исходной структуры</data>
      <data key="d12">95</data>
    </edge>
    <edge source="ГОРЯЧАЯ ПРОКАТКА" target="СТРУКТУРА СТАЛИ">
      <data key="d10">8.0</data>
