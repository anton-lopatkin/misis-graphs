      <data key="d12">112</data>
    </edge>
    <edge source="РАЗМЕР ЗЕРНА" target="ДИСПЕРСНАЯ СТРУКТУРА">
      <data key="d10">9.0</data>
      <data key="d11">Дисперсная структура характеризуется мелким размером зерна</data>
      <data key="d12">117</data>
    </edge>
    <edge source="РАЗМЕР ЗЕРНА" target="НЕМЕТАЛЛИЧЕСКОЕ ВКЛЮЧЕНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">Линейный размер неметаллических включений не должен превышать размер зерна</data>
      <data key="d12">129</data>
