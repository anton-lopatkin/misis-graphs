    </edge>
    <edge source="СТАЛЬ 08ХГ2ФБД" target="ТЕМПЕРАТУРА 550 °C">
      <data key="d10">7.0</data>
      <data key="d11">Аналогично, может быть применима и для стали 08ХГ2ФБД</data>
      <data key="d12">21</data>
    </edge>
    <edge source="СТАЛЬ 08ХГ2ФБД" target="ПРОКАТ КЛАССА ПРОЧНОСТИ X70">
      <data key="d10">1.0</data>
      <data key="d11">Сталь 08ХГ2ФБД также подходит для изготовления проката класса X70</data>
      <data key="d12">22</data>
    </edge>
    <edge source="СКОРОСТЬ ОХЛАЖДЕНИЯ V=12 °C/С" target="ТЕМПЕРАТУРА 740 °C">
      <data key="d10">10.0</data>
      <data key="d11">При температуре конца прокатки 740 °C применяется охлаждение со скоростью 12 °C/с</data>
      <data key="d12">4</data>
    </edge>
    <edge source="СКОРОСТЬ ОХЛАЖДЕНИЯ V=25 °C/С" target="ТЕМПЕРАТУРА 790 °C">
      <data key="d10">10.0</data>
      <data key="d11">При температуре конца прокатки 790 °C используется более высокая скорость охлаждения — 25 °C/с</data>
      <data key="d12">2</data>
    </edge>
    <edge source="ТЕМПЕРАТУРА 550 °C" target="ПРОКАТ КЛАССА ПРОЧНОСТИ X70">
      <data key="d10">9.0</data>
      <data key="d11">Окончание ускоренного охлаждения при ~550 °C считается оптимальным для получения проката класса X70</data>
