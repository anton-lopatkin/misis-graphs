    <node id="МИКРОЛЕГИРОВАНИЕ СТАЛИ">
      <data key="d0">МИКРОЛЕГИРОВАНИЕ СТАЛИ</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Добавление небольших количеств легирующих элементов (например, Nb, V, Ti) для контроля рекристаллизации и измельчения зерна&gt;</data>
      <data key="d3">1</data>
      <data key="d4">4</data>
      <data key="d5">9</data>
      <data key="d6">140</data>
      <data key="d7">571</data>
