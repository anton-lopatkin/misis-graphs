    <node id="ИСПЫТАНИЕ ПРИ ПОВЫШЕННОЙ ТЕМПЕРАТУРЕ">
      <data key="d0">ИСПЫТАНИЕ ПРИ ПОВЫШЕННОЙ ТЕМПЕРАТУРЕ</data>
      <data key="d1">ИСПЫТАНИЕ</data>
      <data key="d2">Метод оценки механических свойств стали при температурах до 700 °C, например, при 600 °C для проверки огнестойкости</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
