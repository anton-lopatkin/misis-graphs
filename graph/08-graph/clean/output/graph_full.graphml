      <data key="d10">10.0</data>
      <data key="d11">Рекристаллизация — это превращение, происходящее в аустените после деформации, приводящее к образованию новых, более мелких зёрен</data>
      <data key="d12">168</data>
    </edge>
    <edge source="АУСТЕНИТ" target="СТРУКТУРА">
      <data key="d10">9.0</data>
      <data key="d11">Аустенит представляет собой высокотемпературную фазу, имеющую зеренную структуру</data>
      <data key="d12">185</data>
    </edge>
