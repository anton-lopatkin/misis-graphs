    <node id="ТЕКСТУРА ФЕРРИТА">
      <data key="d0">ТЕКСТУРА ФЕРРИТА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Кристаллографическая текстура, формируемая при деформации в (γ + α)-области, способствует повышению доли вязкой составляющей в изломе при испытании падающим грузом)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">3</data>
      <data key="d5">5</data>
      <data key="d6">104</data>
      <data key="d7">483</data>
      <data key="d8">969</data>
      <data key="d9">-1</data>
    </node>
    <node id="МИНИМАЛЬНАЯ ТЕМПЕРАТУРА ЭКСПЛУАТАЦИИ">
      <data key="d0">МИНИМАЛЬНАЯ ТЕМПЕРАТУРА ЭКСПЛУАТАЦИИ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Нижний предел температуры, при котором сталь сохраняет достаточную вязкость; для сталей 09Г2ФБ и 10Г2ФБ составляет от −15 до −20 °C)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">99</data>
      <data key="d7">459</data>
