    <node id="УДЕЛЬНАЯ ПОВЕРХНОСТЬ АУСТЕНИТА S_V">
      <data key="d0">УДЕЛЬНАЯ ПОВЕРХНОСТЬ АУСТЕНИТА S_V</data>
