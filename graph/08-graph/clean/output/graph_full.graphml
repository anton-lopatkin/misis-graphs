    <node id="АНИЗОТРОПНЫЙ РОСТ">
      <data key="d0">АНИЗОТРОПНЫЙ РОСТ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Неравномерный рост кристаллов феррита по определённым кристаллографическим направлениям; характерен для квазиполигонального и видманштеттового феррита)</data>
      <data key="d3">1</data>
