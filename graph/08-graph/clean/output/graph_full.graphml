      <data key="d12">8</data>
    </edge>
    <edge source="МЕЛКОЕ ТРУДНОДЕФОРМИРУЕМОЕ ВКЛЮЧЕНИЕ" target="РАСПРЕДЕЛЕНИЕ ВКЛЮЧЕНИЙ">
      <data key="d10">1.0</data>
      <data key="d11">Равномерное распределение мелких труднодеформируемых включений по объёму проката является результатом комплексной внепечной обработки</data>
      <data key="d12">7</data>
