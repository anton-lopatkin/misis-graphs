    <node id="ГРАНИЦА С МАЛЫМ УГЛОМ РАЗОРИЕНТАЦИИ">
      <data key="d0">ГРАНИЦА С МАЛЫМ УГЛОМ РАЗОРИЕНТАЦИИ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Граница между рейками внутри одного пакета бейнита, где ориентация кристаллов мало отличается, способствуя более лёгкому распространению деформации</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
