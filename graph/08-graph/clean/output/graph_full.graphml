    </node>
    <node id="ТЕМПЕРАТУРА УКРУПНЕНИЯ ЗЕРНА">
      <data key="d0">ТЕМПЕРАТУРА УКРУПНЕНИЯ ЗЕРНА</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Критическая температура, при которой резко возрастает стандартное отклонение размера зёрен; соответствует началу аномального роста зерна или вторичной рекристаллизации|</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">47</data>
      <data key="d7">-1</data>
