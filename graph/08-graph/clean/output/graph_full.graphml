      <data key="d6">49</data>
      <data key="d7">331</data>
      <data key="d8">-1</data>
      <data key="d9">-1</data>
    </node>
    <node id="СТАЛЬ МАРКА 10">
      <data key="d0">СТАЛЬ МАРКА 10</data>
      <data key="d1">СТАЛЬ</data>
      <data key="d2">Мягкая сталь, используемая для изготовления болтов методом холодного деформирования; не имеет гарантии по ударной вязкости даже при комнатной температуре&gt;</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">99</data>
      <data key="d7">458</data>
