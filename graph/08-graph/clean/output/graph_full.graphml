    <node id="СТАЛЬ X60">
      <data key="d0">СТАЛЬ X60</data>
      <data key="d1">СТАЛЬ</data>
      <data key="d2">Трубная сталь класса прочности X60, применяемая в нефтегазовой промышленности, с минимальным пределом прочности 517 МПа и пределом текучести 413 МПа</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">55</data>
      <data key="d7">343</data>
