      <data key="d12">51</data>
    </edge>
    <edge source="ЗЕРНО ФЕРРИТА" target="УДЕЛЬНАЯ ПОВЕРХНОСТЬ ГРАНИЦ ЗЁРЕН АУСТЕНИТА">
      <data key="d10">1.0</data>
      <data key="d11">Чем выше удельная поверхность границ зёрен аустенита, тем мельче зерно феррита</data>
