    <node id="ДИАГРАММА ПРЕВРАЩЕНИЯ ПРИ НЕПРЕРЫВНОМ ОХЛАЖДЕНИИ">
      <data key="d0">ДИАГРАММА ПРЕВРАЩЕНИЯ ПРИ НЕПРЕРЫВНОМ ОХЛАЖДЕНИИ</data>
