      <data key="d12">39</data>
    </edge>
    <edge source="СУБЗЕРЕННАЯ СТРУКТУРА" target="НИЗКОТЕМПЕРАТУРНАЯ КОНТРОЛИРУЕМАЯ ПРОКАТКА">
      <data key="d10">9.0</data>
      <data key="d11">Прокатка в (γ + α)-области способствует формированию субзеренной структуры в феррите</data>
