      <data key="d10">9.0</data>
      <data key="d11">Грубые карбиды служат инициаторами хрупкого разрушения из-за концентрации напряжений</data>
      <data key="d12">25</data>
    </edge>
    <edge source="ХРУПКОЕ РАЗРУШЕНИЕ" target="ВОДОРОДНЫЙ МЕХАНИЗМ">
      <data key="d10">9.0</data>
      <data key="d11">Водородный механизм является причиной хрупкого разрушения в высокопрочных сталях</data>
      <data key="d12">24</data>
