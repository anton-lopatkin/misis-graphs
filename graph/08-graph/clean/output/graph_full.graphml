      <data key="d12">8</data>
    </edge>
    <edge source="АТОМАРНЫЙ ВОДОРОД" target="КАТОДНАЯ РЕАКЦИЯ">
      <data key="d10">10.0</data>
      <data key="d11">Катодная реакция приводит к образованию атомарного водорода</data>
      <data key="d12">9</data>
    </edge>
    <edge source="АТОМАРНЫЙ ВОДОРОД" target="ПОВЕРХНОСТЬ СТАЛИ">
      <data key="d10">10.0</data>
      <data key="d11">На поверхности стали происходит адгезия атомарного водорода, образованного в результате катодной реакции</data>
      <data key="d12">8</data>
    </edge>
