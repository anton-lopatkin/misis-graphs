    </node>
    <node id="ОСТРАЯ ЧАСТЬ">
      <data key="d0">ОСТРАЯ ЧАСТЬ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Геометрическая особенность неметаллического включения, где концентрируются напряжения и где скапливается водород, способствуя зарождению трещин.</data>
      <data key="d3">1</data>
      <data key="d4">0</data>
      <data key="d5">-1</data>
      <data key="d6">-1</data>
