    <edge source="СОПРОТИВЛЕНИЕ РАЗРУШЕНИЮ" target="СРЕДНИЙ РАЗМЕР ПЕРЛИТНОЙ КОЛОНИИ 7,5–10,5 МКМ">
      <data key="d10">6.0</data>
