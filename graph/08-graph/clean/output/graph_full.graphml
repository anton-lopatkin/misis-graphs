    </node>
    <node id="НИЗКОТЕМПЕРАТУРНАЯ ВЯЗКОСТЬ">
      <data key="d0">НИЗКОТЕМПЕРАТУРНАЯ ВЯЗКОСТЬ</data>
      <data key="d1">СВОЙСТВО</data>
