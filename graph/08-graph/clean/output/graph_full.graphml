      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Закономерный, диффузионно-контролируемый рост феррита, характерный для полигонального феррита</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">13</data>
