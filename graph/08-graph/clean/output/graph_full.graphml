    <edge source="СУЛЬФИДНЫЕ ВКЛЮЧЕНИЯ" target="СТРОЧЕЧНОЕ ВЫДЕЛЕНИЕ НЕМЕТАЛЛИЧЕСКИХ ВКЛЮЧЕНИЙ">
