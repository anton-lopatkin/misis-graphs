    </node>
    <node id="РЕКРИСТАЛЛИЗАЦИОННАЯ ПРОКАТКА">
      <data key="d0">РЕКРИСТАЛЛИЗАЦИОННАЯ ПРОКАТКА</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Схема прокатки, при которой происходит рекристаллизация аустенита, требует иной системы микролегирования по сравнению с термомеханической прокаткой</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">-1</data>
      <data key="d6">-1</data>
