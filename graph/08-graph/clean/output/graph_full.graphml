      <data key="d10">9.0</data>
      <data key="d11">Игольчатый феррит повышает сопротивление разрушению за счёт высокой плотности высокоугловых границ, вызывающих отклонение хрупкой трещины</data>
      <data key="d12">95</data>
    </edge>
    <edge source="СОПРОТИВЛЕНИЕ РАЗРУШЕНИЮ" target="УДАРНАЯ ВЯЗКОСТЬ">
