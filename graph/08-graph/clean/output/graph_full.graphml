    <edge source="РЕЕЧНЫЙ МАРТЕНСИТ" target="ПЕРЕСЫЩЕННЫЙ ФЕРРИТ">
      <data key="d10">7.0</data>
      <data key="d11">Мартенсит — это пересыщенный твёрдый раствор углерода в феррите, из которого при старении может выделяться цементит</data>
      <data key="d12">16</data>
    </edge>
    <edge source="РЕЕЧНЫЙ МАРТЕНСИТ" target="ПОЛОСЧАТАЯ МИКРОСТРУКТУРА">
      <data key="d10">9.0</data>
      <data key="d11">Реечный мартенсит является составляющей полосчатой микроструктуры в варианте № 6</data>
      <data key="d12">22</data>
    </edge>
    <edge source="РЕЕЧНЫЙ МАРТЕНСИТ" target="ПАКЕТ МАРТЕНСИТА">
      <data key="d10">10.0</data>
      <data key="d11">Реечный мартенсит организован в пакеты параллельных реек</data>
