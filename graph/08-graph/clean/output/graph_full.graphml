    <node id="СПЕЦИАЛЬНЫЙ МЕТОД ПРОКАТКИ">
      <data key="d0">СПЕЦИАЛЬНЫЙ МЕТОД ПРОКАТКИ</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Особая технология прокатки, применяемая для улучшения вязкости микролегированных сталей</data>
      <data key="d3">1</data>
