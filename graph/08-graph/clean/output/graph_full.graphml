      <data key="d10">9.0</data>
      <data key="d11">Трубы из стали X100 были применены на опытном участке Westpath в Канаде</data>
      <data key="d12">73</data>
    </edge>
    <edge source="ТРУБА" target="GODIN LAKE">
      <data key="d10">8.0</data>
