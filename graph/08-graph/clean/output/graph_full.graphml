    <node id="ЭЛЕКТРОННАЯ СТРУКТУРА">
      <data key="d0">ЭЛЕКТРОННАЯ СТРУКТУРА</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Распределение электронов в атоме, влияющее на совместимость элементов при образовании твёрдых растворов</data>
      <data key="d3">1</data>
      <data key="d4">0</data>
      <data key="d5">-1</data>
      <data key="d6">-1</data>
