    <node id="ПЛАСТИНЧАТЫЙ КРИСТАЛЛ БЕЙНИТА">
      <data key="d0">ПЛАСТИНЧАТЫЙ КРИСТАЛЛ БЕЙНИТА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Ранняя форма бейнитного феррита, формирующаяся на начальных стадиях превращения в виде пластин&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">13</data>
      <data key="d6">189</data>
      <data key="d7">722</data>
