      <data key="d12">51</data>
    </edge>
    <edge source="КРЕМНИЙ" target="СТАЛЬ K65(X80)">
      <data key="d10">8.0</data>
      <data key="d11">Повышенное содержание кремния в стали K65(X80) способствует упрочнению, но может ухудшать вязкость, что требует корректировки состава</data>
      <data key="d12">49</data>
    </edge>
    <edge source="КРЕМНИЙ" target="СТАЛЬ КЛАССА ПРОЧНОСТИ X100">
      <data key="d10">8.0</data>
