      <data key="d12">14</data>
    </edge>
    <edge source="ТЕМПЕРАТУРА НАГРЕВА ПОД ПРОКАТКУ" target="ИНТЕНСИВНЫЙ РОСТ ЗЕРНА АУСТЕНИТА">
      <data key="d10">9.0</data>
