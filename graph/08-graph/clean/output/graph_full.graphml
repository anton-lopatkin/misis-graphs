      <data key="d12">45</data>
    </edge>
    <edge source="ВЕРХНИЙ БЕЙНИТ" target="ЛЕГИРОВАННАЯ СТАЛЬ">
      <data key="d10">9.0</data>
      <data key="d11">В легированных сталях при повышении углерода формируется верхний бейнит как основная структурная составляющая</data>
      <data key="d12">53</data>
    </edge>
    <edge source="ВЕРХНИЙ БЕЙНИТ" target="РИС. 3.17, A">
      <data key="d10">10.0</data>
      <data key="d11">На рис. 3.17, a показана типичная структура верхнего бейнита с удлинёнными рейками и цементитом на границах</data>
