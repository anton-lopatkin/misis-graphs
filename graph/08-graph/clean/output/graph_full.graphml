    <node id="ЗАКОЛКА">
      <data key="d0">ЗАКОЛКА</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Термическая обработка, включающая нагрев до аустенитного состояния и быстрое охлаждение для получения мартенсита</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">12</data>
      <data key="d6">177</data>
      <data key="d7">678</data>
      <data key="d8">1013</data>
