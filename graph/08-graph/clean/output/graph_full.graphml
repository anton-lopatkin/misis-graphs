    </edge>
    <edge source="ЭЛЕМЕНТ БЕЗОПАСНОСТИ" target="МИКРОЛЕГИРОВАННАЯ ВЫСОКОПРОЧНАЯ ХОЛОДНОКАТАНАЯ ПОЛОСА">
      <data key="d10">9.0</data>
      <data key="d11">Из этой стали изготавливают элементы безопасности автомобилей</data>
