    </node>
    <node id="СИЛА ТРЕНИЯ В РЕШЁТКЕ">
      <data key="d0">СИЛА ТРЕНИЯ В РЕШЁТКЕ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Внутреннее сопротивление движению дислокаций в кристаллической решётке, обозначаемое как σ₀, возрастает при снижении температуры и повышает прочность.</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">-1</data>
