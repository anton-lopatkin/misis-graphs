      <data key="d10">8.0</data>
      <data key="d11">Аналогично, для стали 08ХГ2ФБД используется температура конца прокатки 750 °C</data>
      <data key="d12">20</data>
    </edge>
    <edge source="СТАЛЬ 08ХГ2ФБД" target="ТЕМПЕРАТУРА 500 °C">
      <data key="d10">7.0</data>
      <data key="d11">Аналогичные процессы происходят и в стали 08ХГ2ФБД</data>
