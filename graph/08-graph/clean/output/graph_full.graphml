    <edge source="СОЕДИНЕНИЕ КАЛЬЦИЙ" target="ДЕСУЛЬФУРАЦИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Кальций используется как десульфуратор, способствуя химическому превращению серы в сульфид кальция</data>
      <data key="d12">7</data>
    </edge>
    <edge source="СОЕДИНЕНИЕ КАЛЬЦИЙ" target="СУЛЬФИД КАЛЬЦИЯ">
      <data key="d10">10.0</data>
      <data key="d11">Кальций вступает в реакцию с серой, образуя сульфид кальция</data>
      <data key="d12">7</data>
    </edge>
    <edge source="СОЕДИНЕНИЕ МАГНИЙ" target="ДЕСУЛЬФУРАЦИЯ">
      <data key="d10">8.0</data>
      <data key="d11">Магний также участвует в десульфурации, повышая эффективность удаления серы</data>
      <data key="d12">7</data>
    </edge>
    <edge source="СОЕДИНЕНИЕ МАГНИЙ" target="УДАЛЕНИЕ ВОДОРОД И АЗОТ">
      <data key="d10">7.0</data>
      <data key="d11">Обработка магнием способствует удалению водорода и азота из стали</data>
      <data key="d12">6</data>
    </edge>
    <edge source="СНИЖЕНИЕ СОДЕРЖАНИЯ КИСЛОРОД" target="ОЧИЩЕНИЕ СТАЛИ">
      <data key="d10">8.0</data>
      <data key="d11">Очистка стали направлена и на удаление кислорода</data>
      <data key="d12">11</data>
    </edge>
    <edge source="СУЛЬФИД КАЛЬЦИЯ" target="ТУГОПЛАВКОЕ ВКЛЮЧЕНИЕ">
