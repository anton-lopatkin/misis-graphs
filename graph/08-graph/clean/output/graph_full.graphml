    </node>
    <node id="ПОДАВЛЕНИЕ РОСТА ЗЕРНА">
      <data key="d0">ПОДАВЛЕНИЕ РОСТА ЗЕРНА</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Процесс торможения роста аустенитного зерна при нагреве и деформации, обеспечиваемый выделениями карбонитридов ниобия и ванадия&gt;</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">40</data>
      <data key="d7">300</data>
      <data key="d8">-1</data>
      <data key="d9">-1</data>
    </node>
    <node id="МЕТАЛЛУРГИЧЕСКИЙ ЗАВОД-ИЗГОТОВИТЕЛЬ">
      <data key="d0">МЕТАЛЛУРГИЧЕСКИЙ ЗАВОД-ИЗГОТОВИТЕЛЬ</data>
