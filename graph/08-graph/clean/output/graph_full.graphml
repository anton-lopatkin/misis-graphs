    <node id="ПЛАВЛЕНИЕ">
      <data key="d0">ПЛАВЛЕНИЕ</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Переход металла из твердого состояния в жидкое, предшествует процессу кристаллизации при разливке</data>
      <data key="d3">1</data>
      <data key="d4">0</data>
      <data key="d5">-1</data>
