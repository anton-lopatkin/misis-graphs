      <data key="d12">17</data>
    </edge>
    <edge source="РЕЕЧНЫЙ МАРТЕНСИТ" target="ПРЕВРАЩЕНИЕ АУСТЕНИТА В МАРТЕНСИТ">
      <data key="d10">10.0</data>
