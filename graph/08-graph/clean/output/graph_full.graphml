      <data key="d12">10</data>
    </edge>
    <edge source="ОДНОРОДНОСТЬ СТРУКТУРЫ" target="СОПРОТИВЛЕНИЕ КОРРОЗИОННОМУ РАСТРЕСКИВАНИЮ ПОД НАПРЯЖЕНИЕМ">
