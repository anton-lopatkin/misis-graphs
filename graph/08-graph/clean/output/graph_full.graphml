      <data key="d12">9</data>
    </edge>
    <edge source="СТАЛЬ R-1" target="СОДЕРЖАНИЕ ХРОМА">
      <data key="d10">8.0</data>
      <data key="d11">Содержание хрома варьируется в плавке R-1 как часть исследуемого диапазона составов</data>
      <data key="d12">7</data>
    </edge>
    <edge source="СТАЛЬ R-1" target="СОДЕРЖАНИЕ ВАНАДИЯ">
      <data key="d10">8.0</data>
      <data key="d11">Содержание ванадия варьируется в стали R-1 в рамках серии микролегированных плавок</data>
      <data key="d12">7</data>
    </edge>
    <edge source="СТАЛЬ S-1" target="ПОНИЖЕННАЯ ТЕМПЕРАТУРА ПРОКАТКИ">
      <data key="d10">9.0</data>
      <data key="d11">Прокатка при пониженной температуре позволила сформировать мелкозернистый феррит и 30 % бейнита в стали S-1</data>
      <data key="d12">9</data>
    </edge>
    <edge source="СТАЛЬ S-1" target="ПРОКАТКА ПРИ ПОНИЖЕННОЙ ТЕМПЕРАТУРЕ">
      <data key="d10">9.0</data>
      <data key="d11">Прокатка при пониженной температуре обеспечила формирование мелкозернистого феррита и 30 % бейнита в стали S-1</data>
      <data key="d12">9</data>
    </edge>
    <edge source="СТАЛЬ S-1" target="ТЕМПЕРАТУРА ИСПЫТАНИЯ 700 °C">
      <data key="d10">9.0</data>
