    <node id="ЭКСПЛУАТАЦИОННЫЕ СВОЙСТВА">
      <data key="d0">ЭКСПЛУАТАЦИОННЫЕ СВОЙСТВА</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Совокупность характеристик стали, определяющих её поведение в условиях эксплуатации, включая ударную вязкость и хладостойкость&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">91</data>
      <data key="d7">432</data>
