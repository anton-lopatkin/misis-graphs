    <node id="ПОЛОСЧАТОСТЬ ПЕРЛИТНАЯ">
      <data key="d0">ПОЛОСЧАТОСТЬ ПЕРЛИТНАЯ</data>
      <data key="d1">СТРУКТУРА</data>
