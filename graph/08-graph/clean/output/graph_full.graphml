    <edge source="ЗЕРНО ФЕРРИТА" target="ПЕРЕХОДНАЯ ТЕМПЕРАТУРА">
      <data key="d10">10.0</data>
      <data key="d11">Мелкозернистая структура феррита способствует снижению переходной температуры</data>
      <data key="d12">76</data>
