    <edge source="TI" target="СТРОИТЕЛЬНАЯ СТАЛЬ">
      <data key="d10">7.0</data>
      <data key="d11">Титан — сильный карбонитридообразующий элемент, входит в состав карбонитридов и не участвует в упрочнении феррита</data>
      <data key="d12">54</data>
    </edge>
    <edge source="TI" target="09Г2СБФ">
      <data key="d10">9.0</data>
