    </node>
    <node id="ЭНЕРГЕТИЧЕСКИЙ БАЛАНС НА ГРАНИЦЕ ЗЕРНА">
      <data key="d0">ЭНЕРГЕТИЧЕСКИЙ БАЛАНС НА ГРАНИЦЕ ЗЕРНА</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Физическая величина, определяющая способность зерна к росту; зёрна, превышающие по размеру 4/3 среднего значения, становятся ростоспособными за счёт энергетического преимущества на границах|</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">47</data>
      <data key="d7">-1</data>
