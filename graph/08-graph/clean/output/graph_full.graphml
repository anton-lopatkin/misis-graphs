      <data key="d11">Для реализации низкотемпературной термомеханической прокатки был создан специальный стан</data>
      <data key="d12">10</data>
    </edge>
    <edge source="СТАРЕНИЕ" target="МАКСИМАЛЬНОЕ ИЗМЕЛЬЧЕНИЕ ВТОРОЙ ФАЗЫ">
