      <data key="d0">РЕЙКА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Узкая вытянутая форма феррита, аналогичная пластине; типична для бейнитного феррита)</data>
      <data key="d3">1</data>
      <data key="d4">3</data>
      <data key="d5">13</data>
      <data key="d6">189</data>
      <data key="d7">722</data>
