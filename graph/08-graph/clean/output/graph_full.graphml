      <data key="d11">Эффективность ускоренного охлаждения снижена при производстве толстостенных труб из-за градиента температур по сечению</data>
      <data key="d12">284</data>
    </edge>
    <edge source="УСКОРЕННОЕ ОХЛАЖДЕНИЕ" target="MO- И ТІ-СОДЕРЖАЩИЙ СТАЛЬ">
      <data key="d10">7.0</data>
      <data key="d11">Легирование Mo и Ti позволяет эффективнее использовать ускоренное охлаждение для формирования упрочняющих выделений</data>
      <data key="d12">275</data>
    </edge>
    <edge source="УСКОРЕННОЕ ОХЛАЖДЕНИЕ" target="ПРЕВРАЩЕНИЕ АУСТЕНИТ">
      <data key="d10">9.0</data>
