    <node id="ЭФФЕКТ ОХРУПЧИВАНИЯ">
      <data key="d0">ЭФФЕКТ ОХРУПЧИВАНИЯ</data>
      <data key="d1">ДЕФЕКТ</data>
      <data key="d2">Снижение вязкости разрушения при повышении прочности из-за наличия дисперсных частиц; проявляется в росте T₅₀ и падении KCV^max)</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">104</data>
      <data key="d7">477</data>
