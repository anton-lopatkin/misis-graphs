    <edge source="ЗАМЕДЛЕННОЕ ОХЛАЖДЕНИЕ" target="СТАЛЬ ДЛЯ ГАЗОПРОВОДНЫХ ТРУБ БОЛЬШОГО ДИАМЕТРА">
      <data key="d10">10.0</data>
