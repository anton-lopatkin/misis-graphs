    </edge>
    <edge source="ЗЕРНО ФЕРРИТА" target="СКОРОСТЬ ОХЛАЖДЕНИЯ В ТЕМПЕРАТУРНОМ ИНТЕРВАЛЕ ПРЕВРАЩЕНИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Высокая скорость охлаждения в интервале превращения приводит к измельчению зерна феррита на 2–5 мкм</data>
      <data key="d12">52</data>
    </edge>
    <edge source="ЗЕРНО ФЕРРИТА" target="ТЕМПЕРАТУРА ЗАВЕРШЕНИЯ УСКОРЕННОГО ОХЛАЖДЕНИЯ">
      <data key="d10">8.0</data>
      <data key="d11">Низкая температура завершения охлаждения способствует стабилизации мелкого зерна феррита</data>
