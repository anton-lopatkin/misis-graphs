      <data key="d12">71</data>
    </edge>
    <edge source="МИКРОЛЕГИРОВАНИЕ" target="МАЛОУГЛЕРОДИСТАЯ СТАЛЬ">
      <data key="d10">1.0</data>
      <data key="d11">Микролегирование применяется для улучшения свойств малоуглеродистых сталей</data>
      <data key="d12">77</data>
    </edge>
