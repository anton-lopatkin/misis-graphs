      <data key="d12">21</data>
    </edge>
    <edge source="СТАЛЬ ТИП 05Г1МБ" target="ПРОКАТ">
      <data key="d10">9.0</data>
      <data key="d11">Прокат изготавливается из стали 05Г1МБ в результате прокатки</data>
      <data key="d12">155</data>
