    <node id="ПОКАЗАТЕЛЬ ПОДКРАКИВАНИЯ">
      <data key="d0">ПОКАЗАТЕЛЬ ПОДКРАКИВАНИЯ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Параметр (P_см = 0,137), оценивающий склонность стали к образованию трещин при сварке; низкое значение указывает на хорошую свариваемость</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">11</data>
