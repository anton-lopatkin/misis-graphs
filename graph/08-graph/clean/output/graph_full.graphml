      <data key="d12">6</data>
    </edge>
    <edge source="НИЗКОСЕРНИСТАЯ СТАЛЬ" target="СОДЕРЖАНИЕ СЕРЫ &lt;0,010 %">
      <data key="d10">10.0</data>
