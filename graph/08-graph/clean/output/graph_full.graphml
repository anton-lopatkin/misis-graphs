    <node id="ПОВЕРХНОСТЬ РАЗДЕЛА">
      <data key="d0">ПОВЕРХНОСТЬ РАЗДЕЛА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Граница между второй фазой и матрицей, сохранение непрерывности которой требует деформации как в матрице, так и вокруг частиц второй фазы</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">14</data>
