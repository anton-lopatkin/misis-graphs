    <node id="ФЕРРИТ С ДИСПЕРСНОЕ ВЫДЕЛЕНИЕ">
      <data key="d0">ФЕРРИТ С ДИСПЕРСНОЕ ВЫДЕЛЕНИЕ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Ферритная матрица с мелкими выделениями второй фазы (возможно, карбидов или нитридов); способствует упрочнению; наблюдается в образце №6</data>
      <data key="d3">1</data>
