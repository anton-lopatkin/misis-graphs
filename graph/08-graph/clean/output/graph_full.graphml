    <node id="СНИЖЕНИЕ ТЕМПЕРАТУРЫ ПРЕВРАЩЕНИЯ">
      <data key="d0">СНИЖЕНИЕ ТЕМПЕРАТУРЫ ПРЕВРАЩЕНИЯ</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Эффект, при котором рост содержания углерода понижает температуру фазовых превращений, включая начало мартенситного превращения</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
