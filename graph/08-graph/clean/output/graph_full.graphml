    <edge source="НАЧАЛЬНАЯ ТЕМПЕРАТУРА ШТАБЕЛЯ" target="ШТАБЕЛЬ">
      <data key="d10">9.0</data>
      <data key="d11">Начальная температура штабеля определяется температурой листов при укладке</data>
      <data key="d12">8</data>
    </edge>
    <edge source="ТЕРМОДИФФУЗИОННАЯ ОБРАБОТКА" target="МИКРОНАПРЯЖЕНИЕ">
      <data key="d10">8.0</data>
      <data key="d11">Термодиффузионная обработка снижает микронапряжения за счёт удаления водорода</data>
      <data key="d12">11</data>
    </edge>
    <edge source="КРИСТАЛЛИЧЕСКАЯ РЕШЕТКА Α-ЖЕЛЕЗО" target="МИКРОНАПРЯЖЕНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">Задержка водорода в решётке α-железа вызывает микронапряжения</data>
      <data key="d12">9</data>
    </edge>
    <edge source="ШТАБЕЛЬ" target="ТЕМПЕРАТУРА УКЛАДКИ ЛИСТА В ШТАБЕЛЬ">
      <data key="d10">9.0</data>
      <data key="d11">Температура укладки (не ниже 350 °C) является критическим параметром при использовании штабеля</data>
