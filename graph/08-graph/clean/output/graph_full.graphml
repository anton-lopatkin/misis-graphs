    <node id="РАСПРЕДЕЛЕНИЕ СВОЙСТВ ПО ДЛИНЕ ПОЛОСЫ">
      <data key="d0">РАСПРЕДЕЛЕНИЕ СВОЙСТВ ПО ДЛИНЕ ПОЛОСЫ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Характеристика неоднородности механических свойств вдоль протяжённости прокатанной полосы, обусловленная вариацией температуры и скорости охлаждения</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">20</data>
