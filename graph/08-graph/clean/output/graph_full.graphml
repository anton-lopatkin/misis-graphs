    <node id="ВЫСОКОТЕМПЕРАТУРНЫЙ ОБРАБОТКА">
      <data key="d0">ВЫСОКОТЕМПЕРАТУРНЫЙ ОБРАБОТКА</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Этап контролируемой прокатки, при котором деформация осуществляется при высоких температурах с последующей рекристаллизацией аустенита</data>
      <data key="d3">1</data>
