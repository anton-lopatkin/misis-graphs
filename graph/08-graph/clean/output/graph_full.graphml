    <node id="СОПРОТИВЛЕНИЕ МАЛЫМ ДЕФОРМАЦИЯМ">
      <data key="d0">СОПРОТИВЛЕНИЕ МАЛЫМ ДЕФОРМАЦИЯМ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Способность сплава противостоять начальной деформации; слабо зависит от крупных частиц второй фазы</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">14</data>
      <data key="d6">206</data>
