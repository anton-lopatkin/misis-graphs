      <data key="d11">После прокатки сразу следует закалка для фиксации структуры</data>
      <data key="d12">4</data>
    </edge>
    <edge source="ЗАКАЛКА В ВОДЕ" target="ЛИСТ ТОЛЩИНОЙ 12 ММ">
