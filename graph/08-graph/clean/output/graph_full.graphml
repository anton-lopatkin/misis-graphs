    </node>
    <node id="КУЗОВ">
      <data key="d0">КУЗОВ</data>
      <data key="d1">ИЗДЕЛИЕ</data>
      <data key="d2">Часть автомобиля, в которой применяется сталь NANOHITEN благодаря её хорошей формуемости и пригодности к цинкованию&gt;</data>
      <data key="d3">2</data>
      <data key="d4">1</data>
      <data key="d5">11</data>
