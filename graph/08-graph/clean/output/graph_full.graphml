    </node>
    <node id="ТЕМПЕРАТУРА РАСТВОРЕНИЯ НИОБИЯ">
      <data key="d0">ТЕМПЕРАТУРА РАСТВОРЕНИЯ НИОБИЯ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Температурный параметр, при котором карбонитриды ниобия растворяются; может быть снижена при введении титана, что позволяет эффективнее использовать ниобий при прокатке)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">42</data>
      <data key="d7">308</data>
