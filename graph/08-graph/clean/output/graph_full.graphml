      <data key="d12">28</data>
    </edge>
    <edge source="ТЕРМОМЕХАНИЧЕСКИЙ КОНТРОЛИРУЕМЫЙ ПРОЦЕСС" target="ИНТЕНСИВНОЕ УСКОРЕННОЕ ОХЛАЖДЕНИЕ">
      <data key="d10">10.0</data>
