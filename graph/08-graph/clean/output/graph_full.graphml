      <data key="d10">10.0</data>
      <data key="d11">Сляб подвергается нагреву в методической печи перед прокаткой</data>
      <data key="d12">53</data>
    </edge>
    <edge source="СЛЯБ" target="ПЯТИЗОННАЯ МЕТОДИЧЕСКАЯ ПЕЧЬ ТОЛКАТЕЛЬНОГО ТИПА">
