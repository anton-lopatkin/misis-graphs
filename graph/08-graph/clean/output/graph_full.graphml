      <data key="d10">8.0</data>
      <data key="d11">Содержание углерода в ниобиевых сталях понижено (менее 0,10 %) для обеспечения свариваемости и вязкости</data>
      <data key="d12">161</data>
    </edge>
    <edge source="УГЛЕРОД" target="СТАЛЬ С ВАНАДИЕМ И НИОБИЕМ">
