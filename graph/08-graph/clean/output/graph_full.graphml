    <node id="УПРОЧНЕНИЕ НАКЛЕПОМ">
      <data key="d0">УПРОЧНЕНИЕ НАКЛЕПОМ</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Механизм повышения прочности за счёт увеличения плотности дислокаций при пластической деформации.</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
