      <data key="d12">6</data>
    </edge>
    <edge source="КЛЕТЬ" target="СЕЧЕНИЕ ИСХОДНОЙ ЗАГОТОВКИ">
      <data key="d10">8.0</data>
      <data key="d11">Возможности клети ограничивают выбор сечения исходной заготовки для эффективной проработки структуры</data>
      <data key="d12">6</data>
    </edge>
    <edge source="ТЕМПЕРАТУРА ОКОНЧАНИЯ ПРОКАТКИ" target="ПРОТИВОРЕЧИЕ">
      <data key="d10">10.0</data>
      <data key="d11">Противоречие возникает из-за необходимости использовать очень низкие температуры окончания прокатки, что ухудшает другие характеристики</data>
      <data key="d12">28</data>
    </edge>
