      <data key="d12">4</data>
    </edge>
    <edge source="ЕСТЕСТВЕННАЯ КОМПОЗИТНАЯ СТРУКТУРА" target="РАЗНОРОДНОСТЬ КОМПОНЕНТ">
      <data key="d10">10.0</data>
      <data key="d11">Разнородность структурных составляющих обусловливает формирование естественной композитной структуры</data>
      <data key="d12">3</data>
    </edge>
    <edge source="ВНЕШНИЙ СЛОЙ ПРОКАТА" target="ПЛОТНОСТЬ ДИСЛОКАЦИЙ В МАТРИЦЕ">
      <data key="d10">9.0</data>
      <data key="d11">Высокая плотность дислокаций наблюдается во внешнем слое проката вследствие интенсивного охлаждения</data>
      <data key="d12">3</data>
    </edge>
    <edge source="Α-FE" target="ТВЁРДЫЙ РАСТВОР ЗАМЕЩЕНИЯ">
      <data key="d10">10.0</data>
      <data key="d11">Легирующие элементы образуют твёрдый раствор замещения в кристаллической решётке α-Fe</data>
      <data key="d12">6</data>
    </edge>
