    </edge>
    <edge source="БЕЙНИТ" target="СЕРИОЗНАЯ ПУТАНИЦА В ОПРЕДЕЛЕНИИ МИКРОСТРУКТУРЫ">
      <data key="d10">8.0</data>
      <data key="d11">Из-за схожей морфологии и механизма формирования бейнит может ошибочно интерпретироваться как мартенсит и наоборот</data>
      <data key="d12">127</data>
    </edge>
