      <data key="d7">330</data>
      <data key="d8">-1</data>
      <data key="d9">-1</data>
    </node>
    <node id="УРАВНЕНИЕ ОГРУБЛЕНИЯ ЗЕРНА">
      <data key="d0">УРАВНЕНИЕ ОГРУБЛЕНИЯ ЗЕРНА</data>
      <data key="d1">СТАНДАРТ</data>
      <data key="d2">Математическое выражение, описывающее рост зерна: D² - D₀² = K₀ t exp(-Q/RT), где D — текущий размер, D₀ — начальный, Q — энергия активации, T — температура, t — время)&gt;</data>
