    <node id="СТАНДАРТНОЕ ОТКЛОНЕНИЕ РАЗМЕРА ЗЕРНА">
      <data key="d0">СТАНДАРТНОЕ ОТКЛОНЕНИЕ РАЗМЕРА ЗЕРНА</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Количественная мера разнозернистости; снижение стандартного отклонения указывает на повышение однородности структуры</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">15</data>
      <data key="d6">216</data>
      <data key="d7">823</data>
