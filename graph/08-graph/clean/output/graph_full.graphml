    <node id="ПОВЕРХНОСТЬ СКОЛА">
      <data key="d0">ПОВЕРХНОСТЬ СКОЛА</data>
      <data key="d1">ДЕФЕКТ</data>
      <data key="d2">Морфология излома, характеризующаяся наличием крупных фасеток, разделенных малоугловыми границами; указывает на хрупкий характер разрушения)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">3</data>
      <data key="d5">14</data>
      <data key="d6">205</data>
      <data key="d7">790</data>
      <data key="d8">-1</data>
