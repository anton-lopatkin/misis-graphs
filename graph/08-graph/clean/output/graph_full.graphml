    <node id="ПОЛИМОРФНОЕ ПРЕВРАЩЕНИЕ">
      <data key="d0">ПОЛИМОРФНОЕ ПРЕВРАЩЕНИЕ</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Процесс изменения кристаллической решётки железа при изменении температуры, лежащий в основе упрочнения сталей</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">-1</data>
      <data key="d6">-1</data>
      <data key="d7">-1</data>
      <data key="d8">-1</data>
      <data key="d9">-1</data>
