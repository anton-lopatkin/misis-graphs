      <data key="d12">22</data>
    </edge>
    <edge source="М/А" target="ГРАНУЛЯРНЫЙ БЕЙНИТ">
      <data key="d10">9.0</data>
      <data key="d11">Включения М/А являются составной частью гранулярного бейнита</data>
