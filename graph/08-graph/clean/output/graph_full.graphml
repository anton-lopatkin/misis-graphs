    <node id="ЭНЕРГИЯ ИСКАЖЕНИЯ">
      <data key="d0">ЭНЕРГИЯ ИСКАЖЕНИЯ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Составляющая свободной энергии, связанная с наличием дислокаций и точечных дефектов в кристаллической решётке после пластической деформации</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">18</data>
