    <node id="МАТРИЦА ПОЛИЭДРИЧЕСКИЙ ФЕРРИТ">
      <data key="d0">МАТРИЦА ПОЛИЭДРИЧЕСКИЙ ФЕРРИТ</data>
      <data key="d1">СТРУКТУРА</data>
