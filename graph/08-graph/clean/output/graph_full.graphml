    <edge source="РАСТВОР 5 % NACL + 0,5 % CH₃COOH" target="ИСПЫТАНИЕ НА ВОДОРОДНОЕ РАСТРЕСКИВАНИЕ">
      <data key="d10">10.0</data>
      <data key="d11">Испытание проводится в указанном растворе, имитирующем агрессивную среду</data>
      <data key="d12">10</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА ВОДОРОДНОЕ РАСТРЕСКИВАНИЕ" target="NACE STANDARD TM 0284–2003">
      <data key="d10">10.0</data>
      <data key="d11">Испытание проводится в соответствии с требованиями стандарта NACE TM 0284–2003</data>
      <data key="d12">10</data>
    </edge>
    <edge source="ПОРА" target="ВНУТРЕННЕЕ ДАВЛЕНИЕ ГАЗА">
      <data key="d10">10.0</data>
      <data key="d11">Внутреннее давление газа (H₂) приводит к образованию пор вблизи включений</data>
      <data key="d12">16</data>
    </edge>
    <edge source="ПОРА" target="ДВУХФАЗНАЯ СТАЛЬ">
      <data key="d10">8.0</data>
      <data key="d11">В двухфазных сталях при прошивке формируются поры на границах фаз</data>
      <data key="d12">28</data>
    </edge>
    <edge source="ПОРА" target="ПРОШИВКА">
      <data key="d10">9.0</data>
      <data key="d11">При прошивке в двухфазных сталях формируются поры из-за неоднородной деформации</data>
      <data key="d12">17</data>
    </edge>
    <edge source="ПОРА" target="СТРОЧЕЧНОЕ НЕМЕТАЛЛИЧЕСКОЕ ВКЛЮЧЕНИЕ">
      <data key="d10">7.0</data>
      <data key="d11">В зоне острых неметаллических включений могут формироваться поры, где скапливается водород</data>
      <data key="d12">17</data>
    </edge>
    <edge source="ПОРА" target="РАЗРЫВ ПЕРЕМЫЧКИ">
      <data key="d10">10.0</data>
      <data key="d11">Разрыв перемычки между порами происходит при их сближении до критического расстояния, что приводит к коалесценции пор и развитию магистральной трещины</data>
      <data key="d12">17</data>
    </edge>
    <edge source="ПОРА" target="ЧИСТОТА СТАЛЬ">
      <data key="d10">9.0</data>
      <data key="d11">Повышенная чистота стали снижает количество центров зарождения пор, уменьшая вероятность разрушения</data>
      <data key="d12">18</data>
    </edge>
    <edge source="АННОДНОЕ РАСТВОРЕНИЕ ЖЕЛЕЗА" target="КАТОДНАЯ РЕАКЦИЯ">
      <data key="d10">10.0</data>
      <data key="d11">Анодное растворение железа и катодная реакция — сопряжённые электрохимические процессы при коррозии</data>
      <data key="d12">3</data>
    </edge>
    <edge source="CSR" target="СОПРОТИВЛЕНИЕ ВОДОРОДНОМУ РАСТРЕСКИВАНИЮ">
      <data key="d10">10.0</data>
      <data key="d11">Сопротивление оценивается по показателю CSR — доле суммарной площади трещин</data>
      <data key="d12">8</data>
    </edge>
    <edge source="CSR" target="ПОКАЗАТЕЛЬ ТРЕЩИНОСТОЙКОСТИ HIC">
      <data key="d10">1.0</data>
      <data key="d11">CSR — показатель степени поражения трещинами по площади при HIC</data>
      <data key="d12">8</data>
    </edge>
    <edge source="ЛОВУШКА В СТАЛЬНОЙ МАТРИЦЕ" target="СКОПЛЕНИЕ ОКСИД">
      <data key="d10">8.0</data>
      <data key="d11">Скопление оксидов формирует эффективную ловушку для водорода</data>
      <data key="d12">3</data>
    </edge>
    <edge source="РАЗРЕЗАНИЕ ОБРАЗЦА" target="ПОЛИРОВАНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">Полирование проводится после разрезания образца на части</data>
      <data key="d12">5</data>
    </edge>
    <edge source="СОПРОТИВЛЕНИЕ ВОДОРОДНОМУ РАСТРЕСКИВАНИЮ" target="ЧИСТОТА СТАЛИ">
      <data key="d10">9.0</data>
      <data key="d11">Высокая чистота стали снижает количество мест зарождения трещин и повышает стойкость к водородному растрескиванию</data>
      <data key="d12">15</data>
    </edge>
    <edge source="РАСТЯГИВАЮЩЕЕ НАПРЯЖЕНИЕ" target="НАПРЯЖЕНИЕ СКОЛ">
      <data key="d10">8.0</data>
      <data key="d11">Растягивающее напряжение может достичь критического значения, необходимого для разрушения скол, особенно в области концентраторов напряжений, таких как надрез</data>
      <data key="d12">8</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА СТОЙКОСТЬ ПРОТИВ СЕРОВОДОРОДНОГО РАСТРЕСКИВАНИЯ ПОД НАПРЯЖЕНИЕМ" target="NACE TM 0177-2005">
      <data key="d10">10.0</data>
      <data key="d11">Испытание проводится в соответствии с требованиями стандарта NACE TM 0177-2005</data>
      <data key="d12">10</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА СТОЙКОСТЬ ПРОТИВ СЕРОВОДОРОДНОГО РАСТРЕСКИВАНИЯ ПОД НАПРЯЖЕНИЕМ" target="МЕТОД А">
      <data key="d10">10.0</data>
      <data key="d11">Метод А является одним из режимов испытания, регламентированных в стандарте для оценки стойкости</data>
      <data key="d12">10</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА СТОЙКОСТЬ ПРОТИВ СЕРОВОДОРОДНОГО РАСТРЕСКИВАНИЯ ПОД НАПРЯЖЕНИЕМ" target="720 ЧАСОВ">
      <data key="d10">10.0</data>
      <data key="d11">Продолжительность испытания составляет 720 часов по методу А</data>
      <data key="d12">10</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА СТОЙКОСТЬ ПРОТИВ СЕРОВОДОРОДНОГО РАСТРЕСКИВАНИЯ ПОД НАПРЯЖЕНИЕМ" target="ДИНАМОМЕТР">
      <data key="d10">8.0</data>
      <data key="d11">Динамометр используется для установки и контроля нагрузки на образец в ходе испытания</data>
      <data key="d12">10</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА СТОЙКОСТЬ ПРОТИВ СЕРОВОДОРОДНОГО РАСТРЕСКИВАНИЯ ПОД НАПРЯЖЕНИЕМ" target="РАСТВОР СЕРОВОДОРОДА">
      <data key="d10">10.0</data>
      <data key="d11">Сероводородсодержащий раствор создает агрессивную среду, вызывающую растрескивание при напряжении</data>
      <data key="d12">12</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА СТОЙКОСТЬ ПРОТИВ СЕРОВОДОРОДНОГО РАСТРЕСКИВАНИЯ ПОД НАПРЯЖЕНИЕМ" target="5 % NACL + 0,5 % CH₃COOH">
      <data key="d10">10.0</data>
      <data key="d11">Данный раствор используется в качестве испытательной среды</data>
      <data key="d12">10</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА СТОЙКОСТЬ ПРОТИВ СЕРОВОДОРОДНОГО РАСТРЕСКИВАНИЯ ПОД НАПРЯЖЕНИЕМ" target="РАЗРУШЕНИЕ ОБРАЗЦА">
      <data key="d10">10.0</data>
      <data key="d11">Разрушение образца является критерием неудовлетворительного результата испытания</data>
      <data key="d12">10</data>
    </edge>
    <edge source="РАСТВОР СЕРОВОДОРОДА" target="ИНТЕНСИВНАЯ ПРОДУВКА">
      <data key="d10">10.0</data>
      <data key="d11">Интенсивная продувка используется для достижения заданной концентрации сероводорода в растворе</data>
      <data key="d12">4</data>
    </edge>
    <edge source="РАСТВОР СЕРОВОДОРОДА" target="ПОДДЕРЖАНИЕ СОДЕРЖАНИЯ В РАСТВОРЕ">
      <data key="d10">10.0</data>
      <data key="d11">Постоянная подача сероводорода с малой интенсивностью поддерживает его концентрацию в растворе на протяжении 720 часов</data>
      <data key="d12">4</data>
    </edge>
    <edge source="ОТНОСИТЕЛЬНОЕ УДЛИНЕНИЕ Δ₅" target="СТАЛЬ МАРКА 10Г2Ф">
      <data key="d10">8.0</data>
      <data key="d11">У стали 10Г2Ф зафиксировано аномально высокое удлинение — 99 %, возможно, ошибка в данных</data>
      <data key="d12">13</data>
    </edge>
    <edge source="ПОКАЗАТЕЛЬ ТРЕЩИНОСТОЙКОСТИ HIC" target="TM–02–84">
      <data key="d10">10.0</data>
      <data key="d11">Испытание на трещиностойкость HIC проводится по стандарту TM–02–84</data>
      <data key="d12">6</data>
    </edge>
    <edge source="КАЛЬЦИЙ" target="СФЕРИЧЕСКИЕ ВКЛЮЧЕНИЯ">
      <data key="d10">9.0</data>
      <data key="d11">При обработке кальцием формируются сферические включения вместо вытянутых MnS</data>
      <data key="d12">12</data>
    </edge>
    <edge source="КАЛЬЦИЙ" target="МОДИФИКАЦИЯ ВКЛЮЧЕНИЙ">
      <data key="d10">9.0</data>
      <data key="d11">Обработка кальцием используется для модификации неметаллических включений</data>
      <data key="d12">14</data>
    </edge>
    <edge source="КАЛЬЦИЙ" target="СТАЛЬ 07ГБ">
      <data key="d10">7.0</data>
      <data key="d11">Кальций (0,0021 %) в стали 07ГБ модифицирует сульфидные включения</data>
      <data key="d12">21</data>
    </edge>
    <edge source="КАЛЬЦИЙ" target="СУЛЬФИД C">
      <data key="d10">8.0</data>
      <data key="d11">Кальций используется для модификации сульфидов (MnS), превращая их в глобулярные включения типа C, что улучшает пластические свойства</data>
      <data key="d12">13</data>
    </edge>
    <edge source="КАЛЬЦИЙ" target="СТАЛЬ 07ГФБ">
      <data key="d10">8.0</data>
      <data key="d11">Кальций (0,002 %) модифицирует неметаллические включения в стали 07ГФБ, улучшая её пластичность</data>
      <data key="d12">61</data>
    </edge>
    <edge source="КИСЛОРОД" target="ПОВЫШЕНИЕ ЧИСТОТЫ СТАЛИ">
      <data key="d10">9.0</data>
      <data key="d11">Повышение чистоты стали включает снижение содержания кислорода до 0,002 %</data>
      <data key="d12">16</data>
    </edge>
    <edge source="КИСЛОРОД" target="ЖИДКАЯ СТАЛЬ">
      <data key="d10">10.0</data>
      <data key="d11">Содержание кислорода в жидкой стали определяет склонность к образованию оксидных включений</data>
      <data key="d12">22</data>
    </edge>
    <edge source="КИСЛОРОД" target="МЕЖЗЁРЕННОЕ ОХРУПЧИВАНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">Кислород при содержании выше 0,002–0,003 % вызывает межзёренное охрупчивание в феррите</data>
      <data key="d12">19</data>
    </edge>
    <edge source="КИСЛОРОД" target="ЭЛЕКТРОПЕЧЬ">
      <data key="d10">9.0</data>
      <data key="d11">Выплавка в электропечи позволяет снизить содержание кислорода в стали до 0,002–0,004 %, что делает её «высокочистой»</data>
      <data key="d12">20</data>
    </edge>
    <edge source="КИСЛОРОД" target="ТВЁРДЫЙ РАСТВОР ВНЕДРЕНИЯ">
      <data key="d10">1.0</data>
      <data key="d11">Кислород растворяется в α-Fe в виде твёрдого раствора внедрения, что приводит к охрупчиванию</data>
      <data key="d12">17</data>
    </edge>
    <edge source="КИСЛОРОД" target="МОНОТОННОЕ УСИЛЕНИЕ ОХРУПЧИВАЮЩЕГО ЭФФЕКТА">
      <data key="d10">9.0</data>
      <data key="d11">С ростом содержания кислорода в феррите охрупчивающий эффект возрастает монотонно</data>
      <data key="d12">16</data>
    </edge>
    <edge source="КИСЛОРОД" target="СОДЕРЖАНИЕ КИСЛОРОДА">
      <data key="d10">10.0</data>
      <data key="d11">Содержание кислорода — количественная характеристика примеси кислорода в стали, влияющая на её свойства</data>
      <data key="d12">22</data>
    </edge>
    <edge source="КИСЛОРОД" target="СТАЛЬ ОБЫЧНОЙ ЧИСТОТЫ">
      <data key="d10">8.0</data>
      <data key="d11">Содержание кислорода в стали обычной чистоты менее 0,008 %</data>
      <data key="d12">19</data>
    </edge>
    <edge source="КИСЛОРОД" target="ВАКУУМИРОВАНИЕ">
      <data key="d10">1.0</data>
      <data key="d11">При вакуумировании кислород удаляется из расплава в виде СО, что способствует повышению чистоты стали</data>
      <data key="d12">28</data>
    </edge>
    <edge source="КИСЛОРОД" target="ВЫПЛАВКА СТАЛИ">
      <data key="d10">10.0</data>
      <data key="d11">Кислород используется при выплавке стали в конвертере для окисления примесей</data>
      <data key="d12">17</data>
    </edge>
    <edge source="СТРОЧЕЧНЫЕ ВКЛЮЧЕНИЯ" target="РАСТРЕСКИВАНИЕ В СЕРОВОДОРОДНОЙ СРЕДЕ">
      <data key="d10">9.0</data>
      <data key="d11">Строчечные включения концентрируют напряжения и инициируют трещины в агрессивной среде</data>
      <data key="d12">3</data>
    </edge>
    <edge source="СЕГРЕГАЦИОННАЯ НЕОДНОРОДНОСТЬ" target="СКОЛОННОСТЬ К ВОДОРОДНОМУ РАСТРЕСКИВАНИЮ">
      <data key="d10">8.0</data>
      <data key="d11">Сегрегация углерода и марганца приводит к образованию полос прочности и повышает чувствительность к растрескиванию</data>
      <data key="d12">8</data>
    </edge>
    <edge source="СЕГРЕГАЦИОННАЯ НЕОДНОРОДНОСТЬ" target="ГОМОГЕННОСТЬ СТРУКТУРЫ">
      <data key="d10">9.0</data>
      <data key="d11">Снижение сегрегационной неоднородности повышает гомогенность структуры стали</data>
      <data key="d12">9</data>
    </edge>
    <edge source="СЕГРЕГАЦИОННАЯ НЕОДНОРОДНОСТЬ" target="ПЕРЛИТНАЯ ПОЛОСА">
      <data key="d10">9.0</data>
      <data key="d11">Сегрегационная неоднородность приводит к образованию перлитных полос за счёт локального обогащения углеродом и другими элементами</data>
      <data key="d12">7</data>
    </edge>
    <edge source="ЧИСТОТА СТАЛИ" target="ОБРАБОТКА ДЛЯ ПОВЫШЕНИЯ ЧИСТОТЫ СТАЛИ">
      <data key="d10">10.0</data>
      <data key="d11">Эта обработка напрямую повышает чистоту стали</data>
      <data key="d12">11</data>
    </edge>
    <edge source="ЧИСТОТА СТАЛИ" target="СОДЕРЖАНИЕ КИСЛОРОДА">
      <data key="d10">9.0</data>
      <data key="d11">Низкое содержание кислорода способствует повышению чистоты стали</data>
      <data key="d12">18</data>
    </edge>
    <edge source="ЧИСТОТА СТАЛИ" target="СОДЕРЖАНИЕ СЕРЫ">
      <data key="d10">9.0</data>
      <data key="d11">Низкое содержание серы улучшает чистоту и пластичность стали</data>
      <data key="d12">13</data>
    </edge>
    <edge source="ЧИСТОТА СТАЛИ" target="ОСЕВАЯ ТРЕЩИНА">
      <data key="d10">8.0</data>
      <data key="d11">Низкое содержание примесей и модифицированные включения снижают склонность к образованию осевых трещин водородного происхождения</data>
      <data key="d12">12</data>
    </edge>
    <edge source="СКОЛОННОСТЬ К ВОДОРОДНОМУ РАСТРЕСКИВАНИЮ" target="ИСПЫТАНИЕ В СЕРОВОДОРОДНОЙ СРЕДЕ">
      <data key="d10">10.0</data>
      <data key="d11">Испытание используется для оценки склонности стали к водородному растрескиванию при различных значениях pH</data>
      <data key="d12">9</data>
    </edge>
    <edge source="СОДЕРЖАНИЕ КИСЛОРОДА" target="ОКСИДНЫЕ ВКЛЮЧЕНИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Высокое содержание кислорода в жидкой стали приводит к образованию грубых оксидных включений; снижение кислорода уменьшает их количество</data>
      <data key="d12">18</data>
    </edge>
    <edge source="СОДЕРЖАНИЕ КИСЛОРОДА" target="ЖИДКИЙ МЕТАЛЛ">
      <data key="d10">9.0</data>
      <data key="d11">Содержание кислорода — ключевой параметр в жидком металле, определяющий тип и количество оксидных включений</data>
      <data key="d12">14</data>
    </edge>
    <edge source="СОДЕРЖАНИЕ КИСЛОРОДА" target="МЕЖЗЁРЕННОЕ ОХРУПЧИВАНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">Высокое содержание кислорода (выше 0,002–0,003 %) вызывает и усиливает межзёренное охрупчивание</data>
      <data key="d12">13</data>
    </edge>
    <edge source="СОДЕРЖАНИЕ КИСЛОРОДА" target="ВЫПЛАВКА В ЭЛЕКТРОПЕЧИ">
      <data key="d10">9.0</data>
      <data key="d11">Выплавка в электропечи позволяет снизить содержание кислорода до 0,002–0,004 %</data>
      <data key="d12">10</data>
    </edge>
    <edge source="СОДЕРЖАНИЕ КИСЛОРОДА" target="МАРТЕНОВСКИЙ СПОСОБ">
      <data key="d10">8.0</data>
      <data key="d11">При мартеновском способе содержание кислорода составляет 0,005–0,008 %</data>
      <data key="d12">10</data>
    </edge>
    <edge source="СОДЕРЖАНИЕ КИСЛОРОДА" target="КИСЛОРОДНО-КОНВЕРТЕРНЫЙ СПОСОБ">
      <data key="d10">8.0</data>
      <data key="d11">При кислородно-конвертерном способе содержание кислорода также находится в диапазоне 0,005–0,008 %</data>
      <data key="d12">10</data>
    </edge>
    <edge source="0,8Σ_Т" target="C–3">
      <data key="d10">10.0</data>
      <data key="d11">Значение 0,8σ_т соответствует группе стойкости C–3 по SSCC, применяемой в самых агрессивных условиях</data>
      <data key="d12">4</data>
    </edge>
    <edge source="CA : S = 1,5–2" target="ОБРАБОТКА КАЛЬЦИЕМ">
      <data key="d10">9.0</data>
      <data key="d11">Соотношение Ca:S 1,5–2 является оптимальным режимом для эффективной модификации включений</data>
      <data key="d12">5</data>
    </edge>
    <edge source="ОБРАБОТКА КАЛЬЦИЕМ" target="МОДИФИКАЦИЯ ВКЛЮЧЕНИЙ">
      <data key="d10">9.0</data>
      <data key="d11">Обработка кальцием вызывает превращение MnS в сферические включения</data>
      <data key="d12">7</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="УДАЛЕНИЕ ВОДОРОД И АЗОТ">
      <data key="d10">10.0</data>
      <data key="d11">Вакуумирование — основной метод удаления газов из жидкой стали</data>
      <data key="d12">17</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="РАСПЛАВ">
      <data key="d10">8.0</data>
      <data key="d11">Вакуумирование применяется к расплаву для удаления газов</data>
      <data key="d12">21</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="ДАВЛЕНИЕ ~100 ПА">
      <data key="d10">1.0</data>
      <data key="d11">Вакуумирование проводят при давлении около 100 Па для обеспечения низкого содержания водорода и удаления оксидных включений</data>
      <data key="d12">16</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="ФЛОТАЦИЯ ВКЛЮЧЕНИЙ">
      <data key="d10">1.0</data>
      <data key="d11">При вакуумировании происходит флотация неметаллических включений, что способствует их удалению из расплава</data>
      <data key="d12">16</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="ФЛОКЕН">
      <data key="d10">1.0</data>
      <data key="d11">Вакуумирование предотвращает образование флокенов за счёт снижения содержания водорода до безопасного уровня</data>
      <data key="d12">18</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="ОКСИДНОЕ ВКЛЮЧЕНИЕ">
      <data key="d10">1.0</data>
      <data key="d11">При вакуумировании содержание крупных оксидных включений (&gt;40 мкм) снижается в 3–5 раз за счёт их флотации</data>
      <data key="d12">17</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="ПОВЫШЕНИЕ КАЧЕСТВА СТАЛИ">
      <data key="d10">1.0</data>
      <data key="d11">Вакуумирование способствует повышению качества стали за счёт дегазации, флотации включений и защиты от вторичного окисления</data>
      <data key="d12">19</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="ВТОРИЧНОЕ ОКИСЛЕНИЕ">
      <data key="d10">1.0</data>
      <data key="d11">Вакуумирование предотвращает вторичное окисление стали, так как проводится в защищённой атмосфере с пониженным давлением</data>
      <data key="d12">17</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="ЗАРОДЫШ ХРУПКОГО РАЗРУШЕНИЯ">
      <data key="d10">1.0</data>
      <data key="d11">Вакуумирование снижает количество крупных оксидных включений в 3–5 раз, тем самым уменьшая число потенциальных зародышей хрупкого разрушения</data>
      <data key="d12">16</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="СТАЛЬ 03Г1Б">
      <data key="d10">9.0</data>
      <data key="d11">После выплавки сталь 03Г1Б подвергается вакуумированию для снижения C, удаления газов и контроля состава</data>
      <data key="d12">41</data>
    </edge>
    <edge source="ВАКУУМИРОВАНИЕ" target="ЭЛЕКТРОДУГОВАЯ ПЕЧЬ">
      <data key="d10">1.0</data>
      <data key="d11">После выплавки в электродуговой печи сталь подвергается вакуумированию для очистки от газов и углерода</data>
      <data key="d12">17</data>
    </edge>
    <edge source="МЯГКАЯ ПРОДУВКА АРГОНОМ" target="ВТОРИЧНОЕ ОКИСЛЕНИЕ">
      <data key="d10">1.0</data>
      <data key="d11">Мягкая продувка аргоном способствует всплыванию включений без нарушения шлакового слоя и предотвращает вторичное окисление</data>
      <data key="d12">4</data>
    </edge>
    <edge source="РАЗЛИВКА С ПОГРУЖНЫМ СТАКАНОМ" target="ВТОРИЧНОЕ ОКИСЛЕНИЕ">
      <data key="d10">8.0</data>
      <data key="d11">Погружной стакан предотвращает контакт металла с воздухом и тем самым исключает вторичное окисление</data>
      <data key="d12">4</data>
    </edge>
    <edge source="ИСПЫТАНИЕ В СЕРОВОДОРОДНОЙ СРЕДЕ" target="PH = 5">
      <data key="d10">9.0</data>
      <data key="d11">Условие pH = 5 используется в испытании на сероводородную стойкость для оценки влияния содержания серы</data>
      <data key="d12">7</data>
    </edge>
    <edge source="ИСПЫТАНИЕ В СЕРОВОДОРОДНОЙ СРЕДЕ" target="PH = 3">
      <data key="d10">10.0</data>
      <data key="d11">Более жёсткое условие испытания (pH = 3), требующее более глубокой очистки стали по сере и кислороду</data>
      <data key="d12">7</data>
    </edge>
    <edge source="ИСПЫТАНИЕ В СЕРОВОДОРОДНОЙ СРЕДЕ" target="СЕРОВОДОРОДНАЯ СРЕДА">
      <data key="d10">10.0</data>
      <data key="d11">Сероводородная среда — условие проведения испытания на стойкость к растрескиванию</data>
      <data key="d12">7</data>
    </edge>
    <edge source="КОВШ" target="ОКСИДНЫЕ ВКЛЮЧЕНИЯ">
      <data key="d10">7.0</data>
      <data key="d11">В ковше должны всплывать грубые включения, но при недостаточном времени или плохих условиях очистки они остаются в металле</data>
      <data key="d12">12</data>
    </edge>
    <edge source="SSCC" target="C–1">
      <data key="d10">9.0</data>
      <data key="d11">Группа C–1 является одной из категорий стойкости по результатам испытания SSCC, соответствующей более низкому пороговому напряжению</data>
      <data key="d12">5</data>
    </edge>
    <edge source="SSCC" target="C–2">
      <data key="d10">9.0</data>
      <data key="d11">Группа C–2 соответствует среднему уровню стойкости по SSCC, определяемому по пороговому напряжению 0,7 σ_т</data>
      <data key="d12">5</data>
    </edge>
    <edge source="SSCC" target="C–3">
      <data key="d10">10.0</data>
      <data key="d11">Группа C–3 устанавливает самые высокие требования к стойкости по SSCC, с пороговым напряжением до 0,8 σ_т</data>
      <data key="d12">6</data>
    </edge>
    <edge source="ДЕНДРИТНАЯ ЛИКВАЦИЯ" target="ГОМОГЕНИЗАЦИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Гомогенизация устраняет дендритную ликвацию за счёт выравнивания состава</data>
      <data key="d12">8</data>
    </edge>
    <edge source="ДЕНДРИТНАЯ ЛИКВАЦИЯ" target="ХИМИЧЕСКИЙ СОСТАВ СТАЛИ">
      <data key="d10">9.0</data>
      <data key="d11">Содержание углерода и марганца в стали определяет степень дендритной ликвации</data>
      <data key="d12">21</data>
    </edge>
    <edge source="ОСЕВАЯ ЛИКВАЦИОННАЯ ЗОНА" target="ОСЕВАЯ ЛИНИЯ">
      <data key="d10">10.0</data>
      <data key="d11">Осевая ликвационная зона совпадает с осевой линией, где происходит растрескивание</data>
      <data key="d12">10</data>
    </edge>
    <edge source="ОСЕВАЯ ЛИКВАЦИОННАЯ ЗОНА" target="НЕПРЕРЫВНОЕ ЛИТЬЁ ЗАГОТОВОК">
      <data key="d10">9.0</data>
      <data key="d11">При непрерывной разливке трудно избежать формирования осевой ликвационной зоны</data>
      <data key="d12">12</data>
    </edge>
    <edge source="ОСЕВАЯ ЛИКВАЦИОННАЯ ЗОНА" target="НЕПРЕРЫВНОЛИТЫЙ МЕТАЛЛ">
      <data key="d10">9.0</data>
      <data key="d11">В непрерывнолитом металле трудно избежать осевой ликвационной зоны</data>
      <data key="d12">10</data>
    </edge>
    <edge source="РЕЖИМ НЕПРЕРЫВНОЙ РАЗЛИВКИ" target="НЕПРЕРЫВНОЕ ЛИТЬЁ ЗАГОТОВОК">
      <data key="d10">9.0</data>
      <data key="d11">Процесс непрерывного литья осуществляется при определённых режимных параметрах</data>
      <data key="d12">5</data>
    </edge>
    <edge source="ЗАКАЛКА И ОТПУСК" target="ГРАНИЧНОЕ СОДЕРЖАНИЕ МАРГАНЦА">
      <data key="d10">9.0</data>
      <data key="d11">Граничное содержание марганца для предотвращения НИС повышается после закалки и отпуска по сравнению с горячекатаным состоянием</data>
      <data key="d12">7</data>
    </edge>
    <edge source="ЗАКАЛКА И ОТПУСК" target="СТРУКТУРА СТАЛИ">
      <data key="d10">9.0</data>
      <data key="d11">Термическая обработка закалка и отпуск формирует структуру стали, влияющую на её свойства</data>
      <data key="d12">7</data>
    </edge>
    <edge source="ГРАНИЧНОЕ СОДЕРЖАНИЕ УГЛЕРОДА" target="ГРАНИЧНОЕ СОДЕРЖАНИЕ МАРГАНЦА">
      <data key="d10">10.0</data>
      <data key="d11">Граничные значения содержания углерода и марганца взаимосвязаны: чем выше C, тем ниже допускается Mn</data>
      <data key="d12">6</data>
    </edge>
    <edge source="ГРАНИЧНОЕ СОДЕРЖАНИЕ УГЛЕРОДА" target="РИС. 4.55, Б">
      <data key="d10">8.0</data>
      <data key="d11">На рис. 4.55, б показана область благоприятного соотношения C и Mn, определяющая граничные содержания</data>
      <data key="d12">4</data>
    </edge>
    <edge source="ГРАНИЧНОЕ СОДЕРЖАНИЕ МАРГАНЦА" target="НИС">
      <data key="d10">9.0</data>
      <data key="d11">Появление НИС зависит от граничного содержания марганца при заданном содержании углерода</data>
      <data key="d12">6</data>
    </edge>
    <edge source="ГРАНИЧНОЕ СОДЕРЖАНИЕ МАРГАНЦА" target="РИС. 4.55, Б">
      <data key="d10">1.0</data>
      <data key="d11">На рисунке показаны допустимые уровни содержания марганца в зависимости от содержания углерода</data>
      <data key="d12">6</data>
    </edge>
    <edge source="СТРУКТУРА СТАЛИ" target="НИС">
      <data key="d10">8.0</data>
      <data key="d11">НИС (нитридно-карбидное внутреннее расслоение) связано с неоднородностью структуры стали</data>
      <data key="d12">6</data>
    </edge>
    <edge source="СТРУКТУРА СТАЛИ" target="РАЗРУШЕНИЕ">
      <data key="d10">10.0</data>
      <data key="d11">Микроструктура стали определяет механизмы зарождения и роста трещины</data>
      <data key="d12">10</data>
    </edge>
    <edge source="МИКРОТВЕРДОСТЬ" target="СЕГРЕГАЦИОННАЯ ПОЛОСА">
      <data key="d10">10.0</data>
      <data key="d11">Высокая микротвердость в сегрегационной полосе (выше 330HV) повышает риск водородного растрескивания</data>
      <data key="d12">10</data>
    </edge>
    <edge source="СМЕЩЕНИЕ РОЛИКОВ" target="ЗОНА ВТОРИЧНОГО ОХЛАЖДЕНИЯ">
      <data key="d10">8.0</data>
      <data key="d11">Смещение роликов происходит в зоне вторичного охлаждения машины непрерывной разливки</data>
      <data key="d12">3</data>
    </edge>
    <edge source="БИЕНИЕ РОЛИКОВ" target="ВЫПУЧИВАНИЕ СЛЯБА">
      <data key="d10">10.0</data>
      <data key="d11">Биение роликов вызывает выпучивание сляба из-за потери равномерного контакта</data>
      <data key="d12">2</data>
    </edge>
    <edge source="ЦЕНТРАЛЬНАЯ СЕГРЕГАЦИЯ" target="УМЕНЬШЕНИЕ ТЕМПЕРАТУРЫ ПЕРЕГРЕВА">
      <data key="d10">9.0</data>
      <data key="d11">Снижение перегрева способствует более равномерному затвердеванию и уменьшает центральную сегрегацию</data>
      <data key="d12">3</data>
    </edge>
    <edge source="ХИМИЧЕСКИЙ СОСТАВ СТАЛИ" target="ИНТЕРВАЛ ТЕМПЕРАТУР ЛИКВИДУС-СОЛИДУС">
      <data key="d10">9.0</data>
      <data key="d11">Содержание углерода и легирующих элементов напрямую определяет ширину интервала ликвидус-солидус</data>
      <data key="d12">16</data>
    </edge>
    <edge source="ХИМИЧЕСКИЙ СОСТАВ СТАЛИ" target="ТАБЛИЦА 4.26">
      <data key="d10">1.0</data>
      <data key="d11">Таблица 4.26 содержит данные о химическом составе различных марок сталей</data>
      <data key="d12">15</data>
    </edge>
    <edge source="ХИМИЧЕСКИЙ СОСТАВ СТАЛИ" target="СТАЛЬ 09ХГ2НФБ">
      <data key="d10">10.0</data>
      <data key="d11">Химический состав стали 09ХГ2НФБ определяет её склонность к образованию бейнита и мартенсита</data>
      <data key="d12">65</data>
    </edge>
    <edge source="ХИМИЧЕСКИЙ СОСТАВ СТАЛИ" target="СТАЛЬ НИЗКОЛЕГИРОВАННАЯ">
      <data key="d10">9.0</data>
      <data key="d11">Химический состав низколегированной стали влияет на кинетику превращений и тип структуры</data>
      <data key="d12">39</data>
    </edge>
    <edge source="ПЕРИТЕКТИЧЕСКАЯ РЕАКЦИЯ" target="УСАДКА СЛЯБА">
      <data key="d10">9.0</data>
      <data key="d11">Перитектическая реакция сопровождается дополнительным уменьшением объема, усиливая общую усадку сляба</data>
      <data key="d12">2</data>
    </edge>
    <edge source="ПЕРИТЕКТИЧЕСКОЕ ПРЕВРАЩЕНИЕ" target="ПАРАМЕТР КРИСТАЛЛИЧЕСКАЯ РЕШЕТКА">
      <data key="d10">8.0</data>
      <data key="d11">Перитектическое превращение характеризуется уменьшением параметра кристаллической решетки при переходе δ-феррит → аустенит</data>
      <data key="d12">2</data>
    </edge>
    <edge source="РИС. 4.56" target="РИС. 4.57">
      <data key="d10">1.0</data>
      <data key="d11">Оба рисунка используются для иллюстрации эффекта охлаждения на структуру и свойства стали</data>
      <data key="d12">7</data>
    </edge>
    <edge source="ЗАТВЕРДЕВАНИЕ" target="ЖИДКИЙ МЕТАЛЛ">
      <data key="d10">10.0</data>
      <data key="d11">Жидкий металл кристаллизуется, образуя дендритную структуру и инициируя процессы сегрегации</data>
      <data key="d12">10</data>
    </edge>
    <edge source="ЗАТВЕРДЕВАНИЕ" target="ПЕРЕГРЕВ МЕТАЛЛА В КОВШЕ">
      <data key="d10">8.0</data>
      <data key="d11">Высокий перегрев увеличивает продолжительность затвердевания и усиливает сегрегацию</data>
      <data key="d12">5</data>
    </edge>
    <edge source="ЗАТВЕРДЕВАНИЕ" target="МЕЖДЕНДРИТНЫЙ ЗОНА">
      <data key="d10">10.0</data>
      <data key="d11">При затвердевании легирующие элементы вытесняются в междендритные зоны, формируя химическую неоднородность</data>
      <data key="d12">6</data>
    </edge>
    <edge source="ИНТЕРВАЛ ТЕМПЕРАТУР ЛИКВИДУС-СОЛИДУС" target="СЕГРЕГАЦИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Уменьшение интервала ликвидус-солидус снижает степень сегрегации при кристаллизации</data>
      <data key="d12">7</data>
    </edge>
    <edge source="СЕРДЕЧНИНА ДЕНДРИТОВ" target="ЖИДКИЙ МЕТАЛЛ">
      <data key="d10">10.0</data>
      <data key="d11">При кристаллизации жидкий металл, затвердевающий первым, формирует сердцевину дендритов, обедненную легирующими элементами</data>
      <data key="d12">8</data>
    </edge>
