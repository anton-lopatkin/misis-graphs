      <data key="d10">9.0</data>
      <data key="d11">В стали 03Г2БТР структурообразование определяется температурой нагрева и степенью деформации</data>
      <data key="d12">39</data>
    </edge>
    <edge source="СТАЛЬ 03Г2БТР" target="СВОЙСТВА">
      <data key="d10">9.0</data>
      <data key="d11">Свойства стали 03Г2БТР зависят от температуры нагрева и степени выделения упрочняющих фаз</data>
      <data key="d12">30</data>
    </edge>
