    <node id="08Г2ФБТ">
      <data key="d0">08Г2ФБТ</data>
      <data key="d1">СТАЛЬ</data>
      <data key="d2">Низколегированная микролегированная сталь, применяемая для производства толстолистового проката повышенной прочности категории К65, содержит марганец, ниобий, ванадий и титан</data>
      <data key="d3">1</data>
      <data key="d4">8</data>
      <data key="d5">5</data>
