      <data key="d12">7</data>
    </edge>
    <edge source="ОБРАБОТКА СИНТЕТИЧЕСКИМ ШЛАКОМ" target="ПОВЫШЕНИЕ КАЧЕСТВА СТАЛИ">
      <data key="d10">1.0</data>
