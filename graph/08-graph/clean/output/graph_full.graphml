    <node id="СРЕДНЕМАССОВАЯ ТЕМПЕРАТУРА 580–680 °C">
      <data key="d0">СРЕДНЕМАССОВАЯ ТЕМПЕРАТУРА 580–680 °C</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Диапазон температур, достигаемых после охлаждения, определяющий условия самопроизвольного отпуска</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">14</data>
      <data key="d6">204</data>
      <data key="d7">782</data>
