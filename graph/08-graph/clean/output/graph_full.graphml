    <node id="НАГРЕВ МЕТАЛЛА ПОД ПРОКАТКУ">
      <data key="d0">НАГРЕВ МЕТАЛЛА ПОД ПРОКАТКУ</data>
      <data key="d1">ОБРАБОТКА</data>
