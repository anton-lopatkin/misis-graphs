      <data key="d10">7.0</data>
      <data key="d11">Цементит является частью второй фазы, выделяющейся в бейнитной структуре</data>
      <data key="d12">52</data>
    </edge>
    <edge source="ЦЕМЕНТИТ" target="ГРАНИЦА РЕЙКА">
      <data key="d10">9.0</data>
      <data key="d11">Цементит преимущественно выделяется по границам реек бейнитного феррита</data>
      <data key="d12">52</data>
