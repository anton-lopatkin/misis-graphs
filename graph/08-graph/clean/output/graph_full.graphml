    <node id="ВЫПЛАВКА В КИСЛОРОДНОМ КОНВЕРТЕРЕ">
      <data key="d0">ВЫПЛАВКА В КИСЛОРОДНОМ КОНВЕРТЕРЕ</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Технология производства стали, обеспечивающая высокую чистоту по примесям</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
