      <data key="d10">10.0</data>
      <data key="d11">Это превращение приводит к образованию мартенситной структуры в закаленной стали</data>
      <data key="d12">10</data>
    </edge>
    <edge source="МАРТЕНСИТНАЯ СТРУКТУРА" target="РАСЩЕПЛЕНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">В сталях с мартенситной структурой плотность расщепления высокая из-за наследования текстуры аустенита</data>
      <data key="d12">36</data>
    </edge>
    <edge source="МАРТЕНСИТНАЯ СТРУКТУРА" target="НАСЛЕДОВАНИЕ ТЕКСТУРЫ АУСТЕНИТА">
      <data key="d10">10.0</data>
      <data key="d11">Мартенсит наследует текстуру аустенита из-за сдвигового характера превращения</data>
      <data key="d12">8</data>
    </edge>
