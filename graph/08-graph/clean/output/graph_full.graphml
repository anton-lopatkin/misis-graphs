      <data key="d10">9.0</data>
      <data key="d11">Углеродный эквивалент стали 13ГС ниже, чем у 17Г1С-У, что улучшает её свариваемость и хладостойкость</data>
      <data key="d12">22</data>
    </edge>
    <edge source="УГЛЕРОДНЫЙ ЭКВИВАЛЕНТ" target="СТАЛЬ X80 (K65)">
      <data key="d10">1.0</data>
