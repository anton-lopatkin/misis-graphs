    <node id="ТОНКАЯ СТРУКТУРА АУСТЕНИТА">
      <data key="d0">ТОНКАЯ СТРУКТУРА АУСТЕНИТА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Микроскопические особенности строения аустенита — субструктура, дислокации, двойники, влияющие на зарождение феррита при превращении</data>
