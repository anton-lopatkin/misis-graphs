    </edge>
    <edge source="ГОРЯЧАЯ ПРОКАТКА ПОЛОСЫ" target="ТЕМПЕРАТУРА ПРОКАТКИ В ЧИСТОВОЙ ГРУППЕ">
      <data key="d10">9.0</data>
