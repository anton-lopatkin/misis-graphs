      <data key="d12">71</data>
    </edge>
    <edge source="ИЗМЕЛЬЧЕНИЕ ЗЕРНА" target="СТРУКТУРА">
      <data key="d10">9.0</data>
      <data key="d11">Измельчение зерна — ключевое изменение структуры, достигаемое ускоренным охлаждением</data>
