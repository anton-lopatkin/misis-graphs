      <data key="d10">10.0</data>
      <data key="d11">Полоса является продуктом горячей прокатки</data>
      <data key="d12">92</data>
    </edge>
    <edge source="ГОРЯЧАЯ ПРОКАТКА" target="СТАЛЬ С СОДЕРЖАНИЕМ 0,06 % C, 1,1 % MN, 0,05 % NB И 0,008 % N">
      <data key="d10">10.0</data>
