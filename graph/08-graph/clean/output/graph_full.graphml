    </node>
    <node id="РАВНОМЕРНОЕ ЗЕРНО АУСТЕНИТА">
      <data key="d0">РАВНОМЕРНОЕ ЗЕРНО АУСТЕНИТА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Однородная по размеру структура аустенита, желаемая перед черновой прокаткой для обеспечения равномерной конечной структуры&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">15</data>
      <data key="d6">216</data>
      <data key="d7">825</data>
