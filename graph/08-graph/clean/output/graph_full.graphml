      <data key="d12">54</data>
    </edge>
    <edge source="ПЛОТНОСТЬ ДИСЛОКАЦИЙ" target="ВЯЗКОСТЬ РАЗРУШЕНИЯ">
      <data key="d10">8.0</data>
      <data key="d11">При упрочнении за счёт высокой плотности дислокаций вязкость разрушения может снижаться, несмотря на рост прочности</data>
      <data key="d12">62</data>
    </edge>
    <edge source="ПЛОТНОСТЬ ДИСЛОКАЦИЙ" target="АЗОТ">
      <data key="d10">1.0</data>
