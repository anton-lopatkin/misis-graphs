      <data key="d12">145</data>
    </edge>
    <edge source="ПРОКАТ" target="НЕМЕТАЛЛИЧЕСКОЕ ВКЛЮЧЕНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">Чистота проката по неметаллическим включениям критически важна для его эксплуатационных свойств</data>
      <data key="d12">176</data>
    </edge>
    <edge source="ПРОКАТ" target="СУБЗЕРНОГРАНИЧНЫЙ МЕХАНИЗМ УПРОЧНЕНИЯ">
      <data key="d10">8.0</data>
      <data key="d11">В прокате должен доминировать субзернограничный механизм упрочнения для реализации запаса вязкости</data>
      <data key="d12">144</data>
    </edge>
    <edge source="ПРОКАТ" target="ОТПУСК">
      <data key="d10">8.0</data>
      <data key="d11">Отпуск проводится после закалки проката для снятия напряжений и регулирования свойств</data>
      <data key="d12">174</data>
    </edge>
    <edge source="ПРОКАТ" target="ПРОХОДНАЯ РОЛИКОВАЯ ПЕЧЬ">
      <data key="d10">9.0</data>
