    <edge source="(NB, MO)(C, N)" target="ФОРМИРОВАНИЕ ВЫДЕЛЕНИЙ">
      <data key="d10">10.0</data>
      <data key="d11">Процесс формирования выделений приводит к образованию фазы (Nb, Mo)(C, N)</data>
