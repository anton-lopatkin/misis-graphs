    <node id="СТОЙКОСТЬ В СРЕДЕ H₂S">
      <data key="d0">СТОЙКОСТЬ В СРЕДЕ H₂S</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Сопротивление серво-водородному растрескиванию, зависящее от однородности структуры и содержания примесей</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">5</data>
