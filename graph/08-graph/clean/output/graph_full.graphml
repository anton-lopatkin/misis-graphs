    <edge source="РОСТ ЗЕРНА" target="NANOHITEN">
      <data key="d10">1.0</data>
      <data key="d11">Добавки титана и, возможно, других элементов в стали NANOHITEN подавляют рост зерна, что способствует получению мелкозернистой структуры</data>
      <data key="d12">91</data>
    </edge>
    <edge source="РОСТ ЗЕРНА" target="ДИФФУЗИЯ ЖЕЛЕЗА ПО ГРАНИЦАМ ЗЕРЕН">
      <data key="d10">10.0</data>
      <data key="d11">Рост зерна контролируется диффузией железа по границам зерен аустенита|</data>
      <data key="d12">43</data>
    </edge>
    <edge source="РОСТ ЗЕРНА" target="УРАВНЕНИЕ РОСТА ЗЕРНА">
      <data key="d10">9.0</data>
      <data key="d11">Кинетика роста зерна описывается уравнением D² - D₀² = kt|</data>
      <data key="d12">43</data>
    </edge>
    <edge source="РОСТ ЗЕРНА" target="МИКРОЛЕГИРУЮЩИЙ ЭЛЕМЕНТ">
      <data key="d10">10.0</data>
      <data key="d11">Микролегирующие элементы (Nb, V, Ti) подавляют рост зерна за счёт образования дисперсных частиц|</data>
      <data key="d12">47</data>
    </edge>
    <edge source="РОСТ ЗЕРНА" target="ЧАСТИЦЫ ДИСПЕРСНОЙ ФАЗЫ">
      <data key="d10">10.0</data>
      <data key="d11">Дисперсные частицы создают тормозящую силу, препятствуя движению границ зерен и подавляя рост зерна|</data>
      <data key="d12">44</data>
    </edge>
    <edge source="РОСТ ЗЕРНА" target="ЗЕРНОГРАНИЧНАЯ ЭНЕРГИЯ">
      <data key="d10">10.0</data>
      <data key="d11">Зернограничная энергия является движущей силой для роста зерна, так как система стремится её минимизировать|</data>
      <data key="d12">39</data>
    </edge>
    <edge source="РОСТ ЗЕРНА" target="УРАВНЕНИЕ ТОРМОЖЕНИЯ ГРАНИЦ">
      <data key="d10">10.0</data>
      <data key="d11">Уравнение описывает, как дисперсные частицы подавляют рост зерна через тормозящую силу G_pin|</data>
