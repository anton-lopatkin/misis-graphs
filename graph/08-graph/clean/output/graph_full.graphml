    <edge source="НАГРЕВ ДО 600 °C" target="НАГРЕВ">
      <data key="d10">10.0</data>
      <data key="d11">Нагрев до 600 °C — конкретный режим обработки, входящий в общую операцию нагрева</data>
      <data key="d12">20</data>
