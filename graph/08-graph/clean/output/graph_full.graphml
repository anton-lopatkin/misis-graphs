    <node id="БЕЙНИТ + ФЕРРИТ">
      <data key="d0">БЕЙНИТ + ФЕРРИТ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Структура, получаемая при стандартной технологии ускоренного охлаждения, аналогична феррит + бейнит, но с преобладанием бейнита</data>
      <data key="d3">1</data>
