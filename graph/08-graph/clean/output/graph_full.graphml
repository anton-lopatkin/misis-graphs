    <edge source="СТАЛЬ Т-1" target="БЕЗУГЛЕРОДИСТЫЙ БЕЙНИТНЫЙ ФЕРРИТ">
      <data key="d10">10.0</data>
      <data key="d11">Сталь Т-1 в исходном состоянии имеет микроструктуру безуглеродистого бейнитного феррита</data>
