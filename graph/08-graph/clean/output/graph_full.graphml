      <data key="d10">10.0</data>
      <data key="d11">Измельчение зерна напрямую повышает хладостойкость стали, так как мелкое зерно препятствует распространению хрупкой трещины</data>
      <data key="d12">176</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="ЗЕРНО ФЕРРИТА">
      <data key="d10">9.0</data>
