      <data key="d10">9.0</data>
      <data key="d11">Свойства стали 09Г2 оцениваются с помощью испытаний на ударный изгиб для определения T₅₀ и KCV^max</data>
      <data key="d12">78</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА УДАРНЫЙ ИЗГИБ" target="KCV^MAX">
      <data key="d10">10.0</data>
