      <data key="d12">167</data>
    </edge>
    <edge source="УГЛЕРОД" target="МАРТЕНСИТНО-АУСТЕНИТНЫЙ СОСТАВЛЯЮЩИЙ">
      <data key="d10">9.0</data>
