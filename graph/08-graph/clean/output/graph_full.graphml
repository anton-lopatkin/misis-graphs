    </node>
    <node id="ГРАНИЦА БЫВШЕГО АУСТЕНИТНОГО ЗЕРНА">
      <data key="d0">ГРАНИЦА БЫВШЕГО АУСТЕНИТНОГО ЗЕРНА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Граница, сохранившаяся после превращения аустенита, обозначается как PAGB. Используется как ориентир при анализе микроструктуры</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">13</data>
