      <data key="d12">22</data>
    </edge>
    <edge source="ИСПЫТАНИЕ" target="СТАЛЬ 15Г2СФ">
      <data key="d10">9.0</data>
      <data key="d11">Свойства стали 15Г2СФ оцениваются по результатам испытаний на растяжение и ударный изгиб</data>
      <data key="d12">83</data>
    </edge>
