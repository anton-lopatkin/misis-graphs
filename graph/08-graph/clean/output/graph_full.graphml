    <node id="ДВА ПРОХОДА В ЧЕРНОВОЙ СТАДИИ">
      <data key="d0">ДВА ПРОХОДА В ЧЕРНОВОЙ СТАДИИ</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Ограниченное количество проходов при черновой прокатке, что может привести к недостаточной рекристаллизации и разнозернистости&gt;</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">15</data>
