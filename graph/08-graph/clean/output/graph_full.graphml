      <data key="d9">-1</data>
    </node>
    <node id="1150–1200 °C">
      <data key="d0">1150–1200 °C</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Температурный интервал нагрева микролегированных сталей перед прокаткой для полного растворения карбонитридных фаз&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">61</data>
      <data key="d7">370</data>
      <data key="d8">-1</data>
