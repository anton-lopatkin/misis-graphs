    </node>
    <node id="КОМПЛЕКС СВОЙСТВО">
      <data key="d0">КОМПЛЕКС СВОЙСТВО</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Совокупность механических характеристик стали, включая прочность, пластичность, ударную вязкость и сопротивление хрупкому разрушению, которую необходимо сбалансировать при разработке новых марок стали</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">72</data>
