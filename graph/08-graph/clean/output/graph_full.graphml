      <data key="d10">10.0</data>
      <data key="d11">На комбинате ООО «Уральская сталь» выпускается сталь нового поколения с повышенной чистотой</data>
      <data key="d12">12</data>
    </edge>
    <edge source="ООО «УРАЛЬСКАЯ СТАЛЬ»" target="ХАЛИЛОВСКОЕ МЕСТОРОЖДЕНИЕ">
