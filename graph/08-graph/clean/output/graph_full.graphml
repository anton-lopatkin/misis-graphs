    <node id="ПОВЕРХНОСТНЫЙ СЛОЙ ПРОКАТА">
      <data key="d0">ПОВЕРХНОСТНЫЙ СЛОЙ ПРОКАТА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Область проката, отличающаяся по структуре и свойствам от сердцевины вследствие градиента температуры и степени деформации при прокатке)&gt;</data>
      <data key="d3">1</data>
