    <edge source="ХЛАДОСТОЙКОСТЬ" target="МНОГОФАЗНАЯ СТРУКТУРА СЛОИСТЫЙ КОМПОЗИТ">
      <data key="d10">1.0</data>
      <data key="d11">Такая структура обеспечивает высокие эксплуатационные свойства, в первую очередь хладостойкость</data>
      <data key="d12">108</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="ВНЕПЕЧНАЯ ОБРАБОТКА СТАЛИ">
      <data key="d10">8.0</data>
      <data key="d11">Внепечная обработка повышает хладостойкость стали за счёт снижения вредных примесей и модифицирования включений</data>
      <data key="d12">115</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="РАСПРЕДЕЛЕНИЕ ВКЛЮЧЕНИЙ ПО СЕЧЕНИЮ ЛИСТА">
      <data key="d10">8.0</data>
      <data key="d11">Равномерное распределение включений по сечению листа положительно влияет на хладостойкость</data>
      <data key="d12">109</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="СТРУКТУРА">
      <data key="d10">9.0</data>
      <data key="d11">Определённый тип структуры является основным фактором, обеспечивающим высокую хладостойкость стали</data>
      <data key="d12">166</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="ЛИСТ">
      <data key="d10">8.0</data>
      <data key="d11">Хладостойкость особенно важна для листовой стали, применяемой в конструкциях северного исполнения</data>
      <data key="d12">181</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="РАВНОМЕРНОСТЬ РАСПРЕДЕЛЕНИЯ ВКЛЮЧЕНИЙ">
      <data key="d10">8.0</data>
      <data key="d11">Равномерное распределение включений способствует повышению хладостойкости</data>
      <data key="d12">108</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="СТАЛЬ СЕВЕРНОЕ ИСПОЛНЕНИЕ">
      <data key="d10">10.0</data>
      <data key="d11">Сталь северного исполнения предназначена для эксплуатации в условиях низких температур, поэтому должна обладать высокой хладостойкостью</data>
      <data key="d12">124</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="СЕРА">
      <data key="d10">8.0</data>
      <data key="d11">Высокое содержание серы снижает хладостойкость; её ограничивают до 0,010 % для повышения вязкости</data>
      <data key="d12">183</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="ФОСФОР">
      <data key="d10">14.0</data>
      <data key="d11">Фосфор, являясь вредной примесью в сталях и других металлических сплавах, оказывает негативное влияние на их эксплуатационные свойства, в частности — на хладостойкость. Хладостойкость представляет собой способность материала сохранять пластичность и ударную вязкость при низких температурах, что критически важно для конструкций, работающих в условиях холодного климата. Высокое содержание фосфора приводит к повышению склонности стали к хрупкому разрушению, особенно при отрицательных температурах, что напрямую снижает её хладостойкость. Это явление связано с тем, что фосфор способствует охрупчиванию границ зёрен в металлической матрице, увеличивая порог хладноломкости — температуру, при которой материал переходит из вязкого состояния в хрупкое.

В связи с этим, как указано в обоих описаниях, содержание фосфора в сталях строго ограничивают. Его концентрация контролируется на всех этапах металлургического производства, поскольку даже незначительные его количества могут существенно ухудшить </data>
      <data key="d12">160</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="СОДЕРЖАНИЕ СЕРЫ">
      <data key="d10">8.0</data>
      <data key="d11">Низкое содержание серы способствует повышению хладостойкости стали</data>
      <data key="d12">109</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="ПОВЫШЕННАЯ ЧИСТОТА ПО ВРЕДНЫМ ПРИМЕСЯМ">
      <data key="d10">1.0</data>
      <data key="d11">Высокая хладостойкость стали обеспечивается, в том числе, за счёт повышенной чистоты по вредным примесям</data>
      <data key="d12">110</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="КРЕМНИЙ">
      <data key="d10">8.0</data>
      <data key="d11">Содержание кремния ≥0,5 % способствует предотвращению низкой хладостойкости</data>
      <data key="d12">145</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="СВАРНОЕ СОЕДИНЕНИЕ">
      <data key="d10">8.0</data>
      <data key="d11">Сварные соединения должны обладать достаточной хладостойкостью, зависящей от состава стали</data>
      <data key="d12">114</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="РАСЧЕТНАЯ ТЕМПЕРАТУРА">
      <data key="d10">9.0</data>
      <data key="d11">При расчетной температуре ниже −50 °C использование стали не рекомендуется из-за риска низкой хладостойкости</data>
      <data key="d12">109</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="СОПРОТИВЛЕНИЕ ХРУПКОМУ РАЗРУШЕНИЮ">
      <data key="d10">10.0</data>
      <data key="d11">Хладостойкость напрямую связана с сопротивлением хрупкому разрушению при низких температурах</data>
      <data key="d12">142</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="СТАЛЬ 07ГФБ">
      <data key="d10">10.0</data>
      <data key="d11">Хладостойкость стали 07ГФБ обеспечивается чистотой, микролегированием и контролируемой прокаткой</data>
      <data key="d12">156</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="СТАЛЬ 03Г1Б">
      <data key="d10">1.0</data>
      <data key="d11">Высокая хладостойкость стали 03Г1Б обусловлена низким содержанием углерода и оптимальным микролегированием</data>
      <data key="d12">133</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="СТАЛЬ 09Г2С">
      <data key="d10">10.0</data>
      <data key="d11">Сталь 09Г2С обладает высокой хладостойкостью: KCV⁻⁴⁰ ≥ 29 Дж/см² и KCU⁻⁷⁰ &gt; 100 Дж/см²</data>
      <data key="d12">122</data>
    </edge>
    <edge source="ФОРМУЕМОСТЬ" target="BH-СТАЛЬ">
      <data key="d10">17.0</data>
      <data key="d11">BH-СТАЛЬ обладает высокой формую́мостью, что является важным свойством для успешной реализации технологических процессов, в особенности холодной штамповки. Благодаря исходно низкому пределу текучести и высокой пластичности, BH-сталь сохраняет хорошую формуемость на этапе формообразования, что позволяет эффективно изготавливать детали сложной геометрии. Это свойство особенно ценно в автомобильной и машиностроительной промышленности, где требуется высокая точность и надёжность при производстве сложнопрофильных элементов. Высокая пластичность материала снижает риск возникновения трещин и разрывов в процессе деформации, обеспечивая стабильность технологического процесса и высокое качество готовых изделий. Таким образом, сочетание низкого предела текучести и высокой способности к пластической деформации делает BH-сталь предпочтительным выбором для операций холодной штамповки, где критически важна не только прочность конечного продукта, но и его способность принимать заданную форму без потер</data>
      <data key="d12">31</data>
    </edge>
    <edge source="ФОРМУЕМОСТЬ" target="IF-СТАЛЬ">
      <data key="d10">8.0</data>
      <data key="d11">IF-сталь имеет высокую способность к вытяжке, в отличие от сталей с твёрдорастворным упрочнением</data>
      <data key="d12">30</data>
    </edge>
    <edge source="ФОРМУЕМОСТЬ" target="АЛЮМИНИЙ">
      <data key="d10">8.0</data>
      <data key="d11">Раскисление алюминием может улучшать структуру, но в целом сталь с алюминиевым раскислением имеет меньшую способность к вытяжке по сравнению с IF-сталью</data>
      <data key="d12">35</data>
    </edge>
    <edge source="ФОРМУЕМОСТЬ" target="TRIPLEX-СТАЛЬ">
      <data key="d10">9.0</data>
      <data key="d11">Отличная формуемость позволяет использовать TRIPLEX-сталь в сложных формах кузова и рамы</data>
      <data key="d12">20</data>
    </edge>
    <edge source="ОБЪЁМНАЯ ДОЛЯ ПЕРЛИТА" target="КОЛИЧЕСТВЕННАЯ ЗАВИСИМОСТЬ ΔT₅₀ = 2,3 V_Π">
      <data key="d10">10.0</data>
      <data key="d11">Эта зависимость напрямую связывает объёмную долю перлита с ростом переходной температуры</data>
      <data key="d12">3</data>
    </edge>
    <edge source="ОБЪЁМНАЯ ДОЛЯ ПЕРЛИТА" target="КОЛИЧЕСТВЕННАЯ ЗАВИСИМОСТЬ ΔKCV^MAX = −4,7 V_Π">
      <data key="d10">10.0</data>
      <data key="d11">Прямо пропорциональная связь между долей перлита и снижением ударной вязкости</data>
      <data key="d12">3</data>
    </edge>
    <edge source="СРЕДНИЙ РАЗМЕР ЗЕРНА ФЕРРИТА" target="РЕЖИМ КОНТРОЛИРУЕМОЙ ПРОКАТКИ">
      <data key="d10">9.0</data>
      <data key="d11">Понижение температуры конца прокатки (например, до 780 °C) способствует измельчению зерна феррита</data>
      <data key="d12">8</data>
    </edge>
    <edge source="СРЕДНИЙ РАЗМЕР ЗЕРНА ФЕРРИТА" target="ОТВОД УГЛЕРОДА">
      <data key="d10">8.0</data>
      <data key="d11">Процесс отвода углерода способствует снижению среднего размера зерна феррита</data>
      <data key="d12">8</data>
    </edge>
    <edge source="СРЕДНИЙ РАЗМЕР ЗЕРНА ФЕРРИТА" target="СНИЖЕНИЕ ТЕМПЕРАТУРЫ ПРЕВРАЩЕНИЯ">
      <data key="d10">8.0</data>
      <data key="d11">Понижение температуры превращения приводит к измельчению зерна феррита</data>
      <data key="d12">7</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="РЕКРИСТАЛЛИЗАЦИЯ">
      <data key="d10">17.0</data>
      <data key="d11">ГОРЯЧАЯ ДЕФОРМАЦИЯ и РЕКРИСТАЛЛИЗАЦИЯ представляют собой взаимосвязанные процессы, происходящие в металлах при высокотемпературной обработке. Горячая деформация, осуществляемая при температурах, превышающих температуру рекристаллизации, приводит к интенсивным структурным изменениям в материале, в частности — к полной рекристаллизации аустенита. В таких условиях деформация способствует разрушению исходной зеренной структуры и инициирует формирование новой, более мелкозернистой структуры за счёт рекристаллизационных процессов. Это позволяет улучшить механические свойства сплава, включая пластичность и однородность структуры.

Рекристаллизация, возникающая в результате горячей деформации, является динамическим процессом, который развивается непосредственно в ходе пластической деформации при высокой температуре. Она характеризуется образованием новых зёрен, свободных от остаточных напряжений и дислокаций, что приводит к восстановлению свойств материала. В случае, если деформация проводится</data>
      <data key="d12">73</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="РОСТ ЗЕРНА">
      <data key="d10">8.0</data>
      <data key="d11">При горячей деформации важно подавлять рост зерна с помощью микролегирования</data>
      <data key="d12">68</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="ПОЛОСЧАТОСТЬ">
      <data key="d10">18.0</data>
      <data key="d11">ГОРЯЧАЯ ДЕФОРМАЦИЯ и ПОЛОСЧАТОСТЬ связаны между собой как процессы, определяющие структурную неоднородность в металлических сплавах, особенно в сталях и сплавах, полученных литьём. Горячая деформация, возникающая при высоких температурах в ходе прокатки или ковки, способствует закреплению и проявлению структурной неоднородности, изначально сформированной на стадии затвердевания слитка. Эта неоднородность обусловлена дендритной ликвацией — процессом, при котором в ходе кристаллизации в различных зонах слитка формируются участки с различным химическим составом. В результате образуются слои с разной концентрацией легирующих и примесных элементов, которые становятся предпосылкой для возникновения полосчатой структуры.

Полосчатость, в свою очередь, представляет собой макроскопическую неоднородность структуры, проявляющуюся в виде чередующихся полос с различными свойствами — плотностью, твёрдостью, химическим составом и восприимчивостью к деформации. Горячая деформация не устраняет эту неод</data>
      <data key="d12">56</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="ЛЕГИРУЮЩИЙ ЭЛЕМЕНТ">
      <data key="d10">8.0</data>
      <data key="d11">При горячей деформации сегрегированные зоны с повышенным содержанием легирующих элементов сохраняются и усиливают неравномерность структуры</data>
      <data key="d12">39</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="ДИСЛОКАЦИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Горячая деформация сопровождается движением дислокаций, включая поперечное скольжение и переползание</data>
      <data key="d12">53</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="«ОЛАДЬЕОБРАЗНЫЙ» ФОРМА">
      <data key="d10">9.0</data>
      <data key="d11">При горячей деформации междендритные зоны приобретают «оладьеобразную» форму, закрепляя сегрегационную неоднородность</data>
      <data key="d12">32</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="ЗАКАЛКА С ПРОКАТНОГО НАГРЕВА">
      <data key="d10">9.0</data>
      <data key="d11">Горячая деформация предшествует закалке с прокатного нагрева</data>
      <data key="d12">51</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="ГОРЯЧЕДЕФОРМИРОВАННЫЙ АУСТЕНИТ">
      <data key="d10">10.0</data>
      <data key="d11">Горячая деформация формирует структуру горячедеформированного аустенита</data>
      <data key="d12">41</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="ТЕРМОМЕХАНИЧЕСКИЙ КОНТРОЛИРУЕМЫЙ ПРОЦЕСС">
      <data key="d10">10.0</data>
      <data key="d11">Горячая деформация — ключевой этап термомеханического контролируемого процесса</data>
      <data key="d12">56</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="РЕКРИСТАЛЛИЗОВАННОЕ ЗЕРНО АУСТЕНИТА">
      <data key="d10">9.0</data>
      <data key="d11">Горячая деформация вызывает динамическую и последующую статическую рекристаллизацию аустенита</data>
      <data key="d12">47</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="РАСТРЕСКИВАНИЕ">
      <data key="d10">8.0</data>
      <data key="d11">При высоком содержании серы и наличии низкоплавких фаз горячая деформация может привести к образованию трещин</data>
      <data key="d12">33</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="ДИНАМИЧЕСКИЙ ВОЗВРАТ">
      <data key="d10">9.0</data>
      <data key="d11">При горячей деформации после стадии упрочнения наступает стадия динамического возврата, снижающего плотность дислокаций</data>
      <data key="d12">33</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="ДИНАМИЧЕСКАЯ РЕКРИСТАЛЛИЗАЦИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Горячая деформация инициирует процесс динамической рекристаллизации аустенита</data>
      <data key="d12">52</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="ДИНАМИЧЕСКАЯ ПОЛИГОНИЗАЦИЯ">
      <data key="d10">9.0</data>
      <data key="d11">При горячей деформации развивается динамическая полигонизация, формирующая субструктуру</data>
      <data key="d12">33</data>
    </edge>
    <edge source="ГОРЯЧАЯ ДЕФОРМАЦИЯ" target="ТЕМПЕРАТУРА">
      <data key="d10">10.0</data>
