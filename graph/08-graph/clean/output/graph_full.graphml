    <node id="ГОРЯЧЕЕ ГЛУБОКОЕ ГАЛЬВАНИЗИРОВАНИЕ">
      <data key="d0">ГОРЯЧЕЕ ГЛУБОКОЕ ГАЛЬВАНИЗИРОВАНИЕ</data>
      <data key="d1">ОБРАБОТКА</data>
