      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Параметр n, характеризующий способность стали к упрочнению при пластической деформации; снижается с ростом прочности стали</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
