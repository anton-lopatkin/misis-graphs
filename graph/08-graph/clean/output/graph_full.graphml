      <data key="d12">4</data>
    </edge>
    <edge source="СНИЖЕНИЕ СОДЕРЖАНИЯ ВРЕДНЫХ ПРИМЕСЕЙ" target="УДАЛЕНИЕ ПРИМЕСЕЙ">
      <data key="d10">10.0</data>
      <data key="d11">Удаление примесей — суть процесса снижения их содержания</data>
      <data key="d12">5</data>
    </edge>
    <edge source="ВВЕДЕНИЕ ТВЁРДЫХ РАСКИСЛИТЕЛЕЙ" target="СНИЖЕНИЕ СОДЕРЖАНИЯ КИСЛОРОД">
      <data key="d10">9.0</data>
      <data key="d11">Раскислители связывают кислород, снижая его содержание в стали</data>
