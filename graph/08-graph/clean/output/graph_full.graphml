    <node id="РАЗОРИЕНТИРОВКА МЕЖДУ СУБЗЕРНАМИ">
      <data key="d0">РАЗОРИЕНТИРОВКА МЕЖДУ СУБЗЕРНАМИ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Угловое различие в ориентации кристаллической решётки между соседними субзернами; в стали S-3 составляет 1–4°</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">9</data>
