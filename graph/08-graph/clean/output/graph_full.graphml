      <data key="d12">54</data>
    </edge>
    <edge source="ЗЕРНО ФЕРРИТА" target="ПОСЛЕДЕФОРМАЦИОННОЕ УСКОРЕННОЕ ОХЛАЖДЕНИЕ">
      <data key="d10">9.0</data>
