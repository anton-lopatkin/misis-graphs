      <data key="d0">УЛЬТРАМЕЛКОЗЕРНИСТАЯ СТРУКТУРА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Микроструктура с размером зерна около 2–3 мкм, обеспечивающая высокие механические свойства, включая вязкость и усталостную прочность&gt;</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">20</data>
