      <data key="d12">64</data>
    </edge>
    <edge source="АЛЮМИНИЙ" target="НИТРИДНЫЕ ФАЗЫ">
      <data key="d10">8.0</data>
      <data key="d11">Алюминий может образовывать нитридные фазы в сочетании с азотом в стали</data>
      <data key="d12">34</data>
    </edge>
    <edge source="АЛЮМИНИЙ" target="НИТРИД ALN">
      <data key="d10">9.0</data>
      <data key="d11">Алюминий образует нитрид AlN, который выделяется при охлаждении и тормозит рост зерна аустенита</data>
      <data key="d12">35</data>
    </edge>
    <edge source="АЛЮМИНИЙ" target="НИТРИД АЛЮМИНИЯ">
      <data key="d10">9.0</data>
      <data key="d11">Алюминий образует дисперсные нитриды алюминия, препятствующие росту зерна аустенита</data>
      <data key="d12">32</data>
    </edge>
    <edge source="АЛЮМИНИЙ" target="АЗОТ">
      <data key="d10">6.0</data>
      <data key="d11">Алюминий также может использоваться для связывания азота, хотя менее эффективно, чем титан</data>
      <data key="d12">81</data>
    </edge>
    <edge source="АЛЮМИНИЙ" target="СТАЛЬ 07ГФБ">
      <data key="d10">8.0</data>
      <data key="d11">Алюминий (0,04 %) раскисляет сталь и способствует измельчению зерна за счёт образования AlN</data>
