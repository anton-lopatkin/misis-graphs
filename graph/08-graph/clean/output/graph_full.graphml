    <edge source="СОДЕРЖАНИЕ НИОБИЯ В ТВЁРДОМ РАСТВОРЕ" target="ТЕМПЕРАТУРА ЧИСТОВОЙ ПРОКАТКИ">
      <data key="d10">10.0</data>
      <data key="d11">Повышенная температура чистовой прокатки препятствует выделению ниобия, сохраняя его в твёрдом растворе</data>
