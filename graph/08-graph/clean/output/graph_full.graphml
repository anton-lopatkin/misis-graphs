    <edge source="МЕЛКОЗЕРНИСТАЯ СТРУКТУРА" target="РЕКРИСТАЛЛИЗАЦИОННАЯ ТЕРМОМЕХАНИЧЕСКАЯ ПРОКАТКА">
      <data key="d10">9.0</data>
