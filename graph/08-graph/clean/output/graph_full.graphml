    </edge>
    <edge source="УСТАНОВКА НЕПРЕРЫВНОЙ РАЗЛИВКИ" target="СТРУЙНОЕ ВАКУУМИРОВАНИЕ">
      <data key="d10">1.0</data>
      <data key="d11">Струйное вакуумирование реализуется на установке непрерывной разливки, например, на ОАО «Азовсталь»</data>
      <data key="d12">5</data>
    </edge>
