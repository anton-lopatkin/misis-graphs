      <data key="d10">8.0</data>
      <data key="d11">Подвижные межфазные границы феррита с аустенитом могут служить центрами роста бейнитных пластин</data>
      <data key="d12">125</data>
    </edge>
    <edge source="БЕЙНИТ" target="АЛЛОТРОПНОМОРФНЫЙ ФЕРРИТ">
