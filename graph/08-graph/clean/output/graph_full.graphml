    <node id="ПРЕВРАЩЕНИЕ ОСТАТОЧНЫЙ АУСТЕНИТ В МАРТЕНСИТ">
      <data key="d0">ПРЕВРАЩЕНИЕ ОСТАТОЧНЫЙ АУСТЕНИТ В МАРТЕНСИТ</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Процесс, происходящий в TRIP-сталях при деформации, приводящий к повышению прочности и пластичности&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">10</data>
