    </edge>
    <edge source="НАГРЕВ МЕТАЛЛА ПОД ПРОКАТКУ" target="РАСПРЕДЕЛЕНИЕ РАЗМЕРА ЗЕРНА АУСТЕНИТА">
      <data key="d10">9.0</data>
