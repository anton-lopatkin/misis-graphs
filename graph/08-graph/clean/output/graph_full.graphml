    <node id="РЕЕЧНЫЙ БЕЙНИТНЫЙ ФЕРРИТ">
      <data key="d0">РЕЕЧНЫЙ БЕЙНИТНЫЙ ФЕРРИТ</data>
      <data key="d1">ФАЗА</data>
      <data key="d2">Пластинчатая форма бейнитного феррита, образующаяся при ускоренном охлаждении; ассоциируется с повышением прочности, но снижением вязкости)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">4</data>
      <data key="d5">13</data>
      <data key="d6">195</data>
      <data key="d7">755</data>
      <data key="d8">-1</data>
      <data key="d9">-1</data>
