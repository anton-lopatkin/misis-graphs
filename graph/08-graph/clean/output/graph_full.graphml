    <node id="СКОЛЬЖЕНИЕ">
      <data key="d0">СКОЛЬЖЕНИЕ</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Синоним дислокационного скольжения — основной механизм пластической деформации при умеренных температурах</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">14</data>
      <data key="d6">212</data>
      <data key="d7">810</data>
