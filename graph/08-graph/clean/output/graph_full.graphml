    <node id="ПЕРЕСЫЩЕННЫЙ ТВЕРДЫЙ РАСТВОР">
      <data key="d0">ПЕРЕСЫЩЕННЫЙ ТВЕРДЫЙ РАСТВОР</data>
      <data key="d1">ФАЗА</data>
      <data key="d2">Твердый раствор углерода и легирующих элементов в железе, находящийся в состоянии, превышающем равновесную растворимость, способный к выделению дисперсных фаз</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">18</data>
