      <data key="d1">СТАЛЬ</data>
      <data key="d2">Низколегированная сталь, легированная кремнием и марганцем, используемая как база для сравнения с микролегированными сталями</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">18</data>
