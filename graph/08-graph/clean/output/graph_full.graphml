      <data key="d12">162</data>
    </edge>
    <edge source="ПРЕДЕЛ ТЕКУЧЕСТИ" target="Σ_F">
      <data key="d10">9.0</data>
      <data key="d11">σ_F коррелирует с пределом текучести: при измельчении зерна оба параметра повышаются сопоставимо</data>
      <data key="d12">163</data>
    </edge>
    <edge source="ПРЕДЕЛ ТЕКУЧЕСТИ" target="ТЕРМИЧЕСКОЕ УЛУЧШЕНИЕ">
      <data key="d10">8.0</data>
      <data key="d11">При термическом улучшении предел текучести повышается на 33 % за счёт измельчения структуры</data>
      <data key="d12">180</data>
    </edge>
    <edge source="ПРЕДЕЛ ТЕКУЧЕСТИ" target="МЕЛКОЗЕРНИСТЫЙ ПРОКАТ">
      <data key="d10">8.0</data>
      <data key="d11">Мелкозернистый прокат с σ_т = 450 МПа демонстрирует более высокую прочность по сравнению с крупнозернистыми аналогами</data>
      <data key="d12">161</data>
    </edge>
    <edge source="ПРЕДЕЛ ТЕКУЧЕСТИ" target="НАКЛЕП">
      <data key="d10">9.0</data>
      <data key="d11">Упрочнение при наклепе повышает предел текучести стали за счет накопления дислокаций</data>
      <data key="d12">172</data>
    </edge>
