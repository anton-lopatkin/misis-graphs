    <edge source="ТЕМПЕРАТУРА СМОТКИ" target="РАСПРЕДЕЛЕНИЕ ТЕМПЕРАТУРЫ ПО ДЛИНЕ ПОЛОСЫ">
      <data key="d10">9.0</data>
      <data key="d11">Температура смотки варьируется по длине полосы</data>
      <data key="d12">17</data>
