    <edge source="НАЧАЛЬНОЕ СОДЕРЖАНИЕ ВОДОРОДА" target="ЖИДКАЯ СТАЛЬ">
      <data key="d10">10.0</data>
      <data key="d11">Начальное содержание водорода измеряется в жидкой стали перед разливкой</data>
