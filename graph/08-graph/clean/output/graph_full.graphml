    </edge>
    <edge source="СТАЛЬ 17ГС" target="УПРОЧНЕНИЕ ЗА СЧЁТ ТВЁРДОГО РАСТВОРА ЗАМЕЩЕНИЯ">
      <data key="d10">8.0</data>
