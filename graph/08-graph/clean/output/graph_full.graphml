    <node id="УДЛИНЕНИЕ">
      <data key="d0">УДЛИНЕНИЕ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Показатель пластичности стали; у стали NANOHITEN находится на высоком уровне по сравнению с обычными высокопрочными сталями)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">11</data>
      <data key="d6">163</data>
      <data key="d7">614</data>
      <data key="d8">991</data>
