    <node id="ГОТОВЫЙ ПРОКАТ">
      <data key="d0">ГОТОВЫЙ ПРОКАТ</data>
      <data key="d1">ИЗДЕЛИЕ</data>
      <data key="d2">Продукт окончательной прокатки, структура которого зависит от всех предшествующих термодеформационных этапов&gt;</data>
      <data key="d3">1</data>
      <data key="d4">3</data>
      <data key="d5">12</data>
      <data key="d6">176</data>
      <data key="d7">671</data>
      <data key="d8">1012</data>
