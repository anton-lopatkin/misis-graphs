      <data key="d11">Рост полигонального феррита контролируется диффузией атомов через границу раздела γ→α</data>
      <data key="d12">50</data>
    </edge>
    <edge source="ПОЛИГОНАЛЬНЫЙ ФЕРРИТ" target="ПРЕВРАЩЕНИЕ В ФЕРРИТ">
