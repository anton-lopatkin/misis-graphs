    <edge source="КОРРОЗИОННОЕ РАЗРУШЕНИЕ ПОД НАПРЯЖЕНИЕМ" target="НЕУПОРЯДОЧЕННАЯ ДИСЛОКАЦИОННАЯ СЕТКА ВЫСОКОЙ ПЛОТНОСТИ">
      <data key="d10">10.0</data>
      <data key="d11">Наличие плотной дислокационной сетки делает сталь подверженной коррозионному разрушению под напряжением</data>
      <data key="d12">9</data>
    </edge>
    <edge source="КОРРОЗИОННОЕ РАЗРУШЕНИЕ ПОД НАПРЯЖЕНИЕМ" target="ДОЛГОВЕЧНОСТЬ">
      <data key="d10">9.0</data>
      <data key="d11">Отсутствие долговечности связано с риском коррозионного разрушения под напряжением при неудалённых структурных дефектах</data>
      <data key="d12">8</data>
    </edge>
    <edge source="КОРРОЗИОННОЕ РАЗРУШЕНИЕ ПОД НАПРЯЖЕНИЕМ" target="КОРРОЗИОННОЕ РАЗРУШЕНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">Коррозионное разрушение под напряжением — один из видов коррозионного разрушения</data>
      <data key="d12">6</data>
    </edge>
    <edge source="КОРРОЗИОННОЕ РАЗРУШЕНИЕ ПОД НАПРЯЖЕНИЕМ" target="НЕУПОРЯДОЧЕННАЯ ДИСЛОКАЦИОННАЯ СЕТКА ВЫСОКАЯ ПЛОТНОСТЬ">
      <data key="d10">8.0</data>
      <data key="d11">Высокая плотность дислокаций способствует развитию коррозионного растрескивания под напряжением</data>
      <data key="d12">9</data>
    </edge>
    <edge source="КОРРОЗИОННОЕ РАЗРУШЕНИЕ ПОД НАПРЯЖЕНИЕМ" target="ДИСЛОКАЦИОННАЯ СЕТКА">
      <data key="d10">10.0</data>
      <data key="d11">Наличие неупорядоченной дислокационной сетки высокой плотности делает сталь склонной к коррозионному разрушению под напряжением</data>
      <data key="d12">6</data>
    </edge>
    <edge source="НЕУПОРЯДОЧЕННАЯ ДИСЛОКАЦИОННАЯ СЕТКА ВЫСОКОЙ ПЛОТНОСТИ" target="НЕУПОРЯДОЧЕННАЯ ДИСЛОКАЦИОННАЯ СЕТКА">
      <data key="d10">10.0</data>
      <data key="d11">Синонимичные понятия, описывающие один и тот же структурный дефект</data>
      <data key="d12">5</data>
