      <data key="d10">9.0</data>
      <data key="d11">Степень деформации — один из трёх ключевых факторов, варьируемых в экспериментальной матрице</data>
      <data key="d12">35</data>
    </edge>
    <edge source="СТЕПЕНЬ ДЕФОРМАЦИИ" target="ЭКСПРЕССИЯ ДЛЯ D_R">
