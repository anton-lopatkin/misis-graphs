      <data key="d11">На начальной стадии горячей деформации плотность дислокаций резко возрастает, что вызывает упрочнение</data>
      <data key="d12">82</data>
    </edge>
    <edge source="ПЛОТНОСТЬ ДИСЛОКАЦИЙ" target="ДИНАМИЧЕСКИЙ ВОЗВРАТ">
