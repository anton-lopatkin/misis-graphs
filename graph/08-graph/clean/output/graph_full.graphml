    <edge source="СТАЛЬ" target="ИСПЫТАНИЕ НА УДАРНЫЙ ИЗГИБ">
      <data key="d10">10.0</data>
      <data key="d11">Испытание проводится для оценки KCV и KCU стали</data>
      <data key="d12">380</data>
