      <data key="d9">-1</data>
    </node>
    <node id="РАЗОРИЕНТИРОВКА ГРАНИЦ">
      <data key="d0">РАЗОРИЕНТИРОВКА ГРАНИЦ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Относительная разориентировка зёрен или реек, используемая для достоверного распознавания типа бейнита (гранулярный, верхний, нижний) с помощью EBSD-анализа; различия в распределении разориентировки позволяют дифференцировать микроструктуры&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">9</data>
      <data key="d6">140</data>
      <data key="d7">568</data>
