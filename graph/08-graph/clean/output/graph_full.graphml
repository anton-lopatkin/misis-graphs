    <edge source="СТАЛЬ ТИП 05Г1МБ" target="Γ→Α-ПРЕВРАЩЕНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">Превращение γ→α происходит при охлаждении стали 05Г1МБ и определяет конечную структуру</data>
      <data key="d12">38</data>
    </edge>
    <edge source="СТАЛЬ ТИП 05Г1МБ" target="ИНТЕНСИВНОЕ ВЫДЕЛЕНИЕ КАРБОНИТРИДОВ В АУСТЕНИТЕ">
      <data key="d10">9.0</data>
      <data key="d11">В стали 05Г1МБ при определённых режимах происходит интенсивное выделение карбонитридов в аустените</data>
      <data key="d12">17</data>
    </edge>
    <edge source="NBC" target="Γ→Α-ПРЕВРАЩЕНИЕ">
      <data key="d10">10.0</data>
      <data key="d11">Выделение дисперсных частиц NbC происходит в ходе γ→α-превращения и в феррите при охлаждении</data>
      <data key="d12">30</data>
    </edge>
    <edge source="NBC" target="ГЛАДМАН">
      <data key="d10">1.0</data>
      <data key="d11">Гладман модифицировал модель Орована и применил её для описания упрочнения за счёт частиц NbC</data>
      <data key="d12">7</data>
    </edge>
    <edge source="NBC" target="ЗВЕЗДООБРАЗНАЯ ЧАСТИЦА">
      <data key="d10">10.0</data>
      <data key="d11">Выделение NbC на TiN формирует характерную «звездообразную» морфологию, где TiN находится в центре, а NbC — в виде ответвлений</data>
      <data key="d12">12</data>
    </edge>
    <edge source="NBC" target="ДИСПЕРСНЫЕ ЧАСТИЦЫ">
      <data key="d10">10.0</data>
