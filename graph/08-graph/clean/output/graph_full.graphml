    <node id="ЗАВЕРШЕНИЕ ДЕФОРМАЦИИ В ДВУХФАЗНОЙ (Γ + Α)-ОБЛАСТИ">
      <data key="d0">ЗАВЕРШЕНИЕ ДЕФОРМАЦИИ В ДВУХФАЗНОЙ (Γ + Α)-ОБЛАСТИ</data>
      <data key="d1">РЕЖИМ</data>
