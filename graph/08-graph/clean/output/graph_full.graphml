    <node id="ХОЛОДНОКАТАНЫЙ">
      <data key="d0">ХОЛОДНОКАТАНЫЙ</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Состояние поставки стали, полученное путём холодной прокатки, обеспечивает повышенную точность размеров и качество поверхности, применяется для DP- и TRIP-сталей)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">12</data>
      <data key="d6">182</data>
      <data key="d7">713</data>
      <data key="d8">-1</data>
      <data key="d9">-1</data>
    </node>
    <node id="ГОРЯЧЕКАТАНЫЙ">
      <data key="d0">ГОРЯЧЕКАТАНЫЙ</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Состояние поставки стали, полученное при горячей прокатке, например, для DP 600, характеризуется более высокой пластичностью и меньшей точностью размеров по сравнению с холоднокатаным)&gt;</data>
      <data key="d3">1</data>
