      <data key="d12">21</data>
    </edge>
    <edge source="Σ_Т" target="СДАТОЧНОЕ ИСПЫТАНИЕ">
      <data key="d10">1.0</data>
      <data key="d11">Сдаточные испытания включали определение предела текучести σ_т</data>
      <data key="d12">24</data>
    </edge>
