    <node id="СТРОЧЕЧНЫЕ ВКЛЮЧЕНИЯ">
      <data key="d0">СТРОЧЕЧНЫЕ ВКЛЮЧЕНИЯ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Вытянутые по направлению прокатки включения, особенно оксиды, способные концентрировать напряжения и инициировать трещины</data>
      <data key="d3">1</data>
