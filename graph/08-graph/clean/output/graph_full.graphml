      <data key="d10">10.0</data>
      <data key="d11">JFE провела опытное производство листов толщиной 19 мм</data>
      <data key="d12">10</data>
    </edge>
    <edge source="JFE" target="ТРУБА ДИАМЕТРОМ 914 ММ">
      <data key="d10">10.0</data>
      <data key="d11">JFE произвела опытные партии труб диаметром 914 мм из стали X120</data>
