      <data key="d11">Разнозернистость — это неоднородность размера зёрен аустенита, возникающая при деформации выше или ниже T_рекр</data>
      <data key="d12">64</data>
    </edge>
    <edge source="ЗЕРНО АУСТЕНИТА" target="СТАЛЬ X120">
