    </edge>
    <edge source="СТОЙКОСТЬ К СЕРОВОДОРОДНОМУ РАСТРЕСКИВАНИЮ" target="MO">
      <data key="d10">1.0</data>
      <data key="d11">Молибден способствует повышению однородности структуры и снижению склонности к хрупкому разрушению в H₂S-среде</data>
