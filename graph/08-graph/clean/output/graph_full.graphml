    <node id="НОРМАЛИЗОВАННОЕ СОСТОЯНИЕ">
      <data key="d0">НОРМАЛИЗОВАННОЕ СОСТОЯНИЕ</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Термическое состояние стали после нормализации — охлаждения на воздухе после нагрева выше критической температуры</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
