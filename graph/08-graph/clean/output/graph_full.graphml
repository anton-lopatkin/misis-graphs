      <data key="d12">36</data>
    </edge>
    <edge source="ЗЕРНО АУСТЕНИТА" target="ТЕМПЕРАТУРА ВЯЗКО-ХРУПКОГО ПЕРЕХОДА">
      <data key="d10">9.0</data>
      <data key="d11">Уменьшение размера зерна аустенита снижает температуру вязко-хрупкого перехода</data>
      <data key="d12">41</data>
    </edge>
    <edge source="ЗЕРНО АУСТЕНИТА" target="ТЕРМОМЕХАНИЧЕСКИЙ КОНТРОЛИРУЕМЫЙ ПРОЦЕСС">
