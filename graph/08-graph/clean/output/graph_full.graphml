    <edge source="СТАЛЬ X120" target="ТЕМПЕРАТУРА ВЯЗКО-ХРУПКОГО ПЕРЕХОДА">
      <data key="d10">8.0</data>
      <data key="d11">Температура вязко-хрупкого перехода снижается при измельчении зерна в стали X120</data>
