    <node id="ПАРАМЕТР РАСПРЕДЕЛЕНИЯ">
      <data key="d0">ПАРАМЕТР РАСПРЕДЕЛЕНИЯ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Статистическая характеристика, описывающая неоднородность структуры, особенно важна правая часть распределения — доля крупных зёрен, нежелательных для конечного качества проката</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">18</data>
