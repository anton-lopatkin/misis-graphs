      <data key="d12">81</data>
    </edge>
    <edge source="ГОРЯЧАЯ ПРОКАТКА" target="ОПТИМАЛЬНЫЙ РЕЖИМ">
      <data key="d10">9.0</data>
      <data key="d11">Оптимальный режим включает управление параметрами горячей прокатки</data>
      <data key="d12">83</data>
    </edge>
    <edge source="ГОРЯЧАЯ ПРОКАТКА" target="СТЕПЕНЬ ДЕФОРМАЦИИ">
      <data key="d10">9.0</data>
