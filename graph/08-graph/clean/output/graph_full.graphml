    </edge>
    <edge source="НИОБИЙ" target="НИОБИЙСОДЕРЖАЩАЯ НИЗКОЛЕГИРОВАННАЯ СТАЛЬ">
      <data key="d10">10.0</data>
      <data key="d11">Ниобий является легирующим элементом в ниобийсодержащей низколегированной стали</data>
