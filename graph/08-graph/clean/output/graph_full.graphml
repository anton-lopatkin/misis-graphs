      <data key="d12">11</data>
    </edge>
    <edge source="ИСПЫТАНИЕ НА УДАРНУЮ ВЯЗКОСТЬ" target="ПРИЕМО-СДАТОЧНОЕ ИСПЫТАНИЕ">
      <data key="d10">9.0</data>
