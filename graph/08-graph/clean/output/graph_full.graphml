      <data key="d10">8.0</data>
      <data key="d11">Правильный выбор режима деформации позволяет уменьшить разнозернистость</data>
      <data key="d12">4</data>
    </edge>
    <edge source="ПОЛОСЧАТОСТЬ СТРУКТУРЫ" target="РАСПОЛОЖЕНИЕ СТРУКТУРНЫХ СОСТАВЛЯЮЩИХ В ВИДЕ ПОЛОС">
