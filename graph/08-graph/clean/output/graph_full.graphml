    <node id="РАСПРОСТРАНЕНИЕ ТРЕЩИНЫ ПО МЕХАНИЗМУ РАСЩЕПЛЕНИЕ">
      <data key="d0">РАСПРОСТРАНЕНИЕ ТРЕЩИНЫ ПО МЕХАНИЗМУ РАСЩЕПЛЕНИЕ</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Процесс хрупкого разрушения по плоскостям расщепления, который подавляется в сталях с композитной структурой благодаря высокой вязкости</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
