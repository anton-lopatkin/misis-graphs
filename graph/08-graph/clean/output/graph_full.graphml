    <node id="ДИФРАКЦИЯ ОБРАТНОРАССЕЯННЫХ ЭЛЕКТРОНОВ">
      <data key="d0">ДИФРАКЦИЯ ОБРАТНОРАССЕЯННЫХ ЭЛЕКТРОНОВ</data>
