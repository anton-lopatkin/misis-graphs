    <edge source="ОГНЕСТОЙКАЯ СТРОИТЕЛЬНАЯ СТАЛЬ" target="ОБЫЧНАЯ КОНСТРУКЦИОННАЯ СТАЛЬ">
      <data key="d10">9.0</data>
