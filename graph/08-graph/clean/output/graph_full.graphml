    <edge source="АУСТЕНИТ" target="ГРАНИЦА АУСТЕНИТНОГО ЗЕРНА">
      <data key="d10">1.0</data>
      <data key="d11">Границы зерен образованы разделом между соседними зернами аустенита</data>
