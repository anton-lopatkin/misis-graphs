    </node>
    <node id="ИСКРИВЛЁННАЯ ГРАНИЦА ЗЕРНА">
      <data key="d0">ИСКРИВЛЁННАЯ ГРАНИЦА ЗЕРНА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Граница зерна, изогнутая вследствие пластической деформации или фазовых превращений, способствует задержке движения дислокаций&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">13</data>
      <data key="d6">190</data>
      <data key="d7">726</data>
      <data key="d8">-1</data>
