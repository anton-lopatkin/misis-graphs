      <data key="d10">9.0</data>
      <data key="d11">Верхний бейнит — один из пяти морфологических типов бейнита, наблюдаемых в данной стали</data>
      <data key="d12">380</data>
    </edge>
    <edge source="СТАЛЬ" target="НИЖНИЙ БЕЙНИТ">
      <data key="d10">9.0</data>
