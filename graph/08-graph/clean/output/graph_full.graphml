    <node id="СЕРДЕЦЕВИНА ПРОКАТА">
      <data key="d0">СЕРДЕЦЕВИНА ПРОКАТА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Центральная часть проката, имеющая иную тепловую историю и степень деформации по сравнению с поверхностью, что влияет на её микроструктуру)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">0</data>
      <data key="d5">-1</data>
