    <node id="ПЕРЛИТНО ФЕРРИТНАЯ СТРУКТУРА">
      <data key="d0">ПЕРЛИТНО ФЕРРИТНАЯ СТРУКТУРА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Смешанная микроструктура, состоящая из феррита и перлита, характерная для среднеуглеродистых сталей, обладающая пониженной вязкостью&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">12</data>
      <data key="d6">177</data>
      <data key="d7">680</data>
