      <data key="d12">339</data>
    </edge>
    <edge source="СТАЛЬ" target="ДЕФОРМАЦИЯ ДВОЙНИКОВАНИЕМ">
      <data key="d10">8.0</data>
      <data key="d11">Как и в железе, в сталях при низких температурах может преобладать двойникование как механизм деформации</data>
      <data key="d12">342</data>
    </edge>
    <edge source="СТАЛЬ" target="СВЕРХМЕЛКОЗЕРНИСТЫЙ ФЕРРИТ">
      <data key="d10">9.0</data>
      <data key="d11">Сверхмелкозернистый феррит — целевая структура в современных сталях</data>
