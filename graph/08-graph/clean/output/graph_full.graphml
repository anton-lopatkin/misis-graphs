      <data key="d9">-1</data>
    </node>
    <node id="ПОЛОСА С ПОВЫШЕННОЙ ПРОЧНОСТЬЮ">
      <data key="d0">ПОЛОСА С ПОВЫШЕННОЙ ПРОЧНОСТЬЮ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Структурная неоднородность, образующаяся из-за сегрегации углерода и марганца, повышающая прочность в отдельных зонах</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">11</data>
      <data key="d6">166</data>
      <data key="d7">626</data>
      <data key="d8">999</data>
      <data key="d9">-1</data>
