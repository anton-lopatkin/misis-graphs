    </edge>
    <edge source="ФЕРРИТНО-БЕЙНИТНАЯ СТРУКТУРА" target="СООТНОШЕНИЕ Σ_Т/Σ_В">
      <data key="d10">10.0</data>
      <data key="d11">Ферритно-бейнитная структура применяется для снижения высокого соотношения σ_т/σ_в, вызванного снижением содержания углерода</data>
      <data key="d12">41</data>
    </edge>
    <edge source="ФЕРРИТНО-БЕЙНИТНАЯ СТРУКТУРА" target="05Г2НДМБ">
