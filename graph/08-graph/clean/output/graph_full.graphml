      <data key="d11">У стали С345ПЛ относительное удлинение составляет 24 %</data>
      <data key="d12">27</data>
    </edge>
    <edge source="Δ₅" target="09Г2СБФ">
      <data key="d10">8.0</data>
      <data key="d11">Относительное удлинение стали 09Г2СБФ — 31–36 %, что свидетельствует о хорошей пластичности</data>
      <data key="d12">46</data>
    </edge>
    <edge source="Δ₅" target="СТАЛЬ 10ХСНДА">
      <data key="d10">10.0</data>
      <data key="d11">Относительное удлинение δ₅ у стали 10ХСНДА превышает 40 %, что значительно выше нормативного значения в 20 %</data>
      <data key="d12">35</data>
    </edge>
    <edge source="KCU⁻⁶⁰" target="ОСНОВНОЙ МЕТАЛЛ">
      <data key="d10">10.0</data>
      <data key="d11">Значение KCU⁻⁶⁰ = 336 Дж/см² относится к основному металлу трубы</data>
      <data key="d12">15</data>
    </edge>
    <edge source="KCV⁻²⁰" target="ТРУБНЫЙ ПЕРЕДЕЛ">
      <data key="d10">9.0</data>
