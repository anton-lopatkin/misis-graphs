    <edge source="НЕЗАВЕРШЁННОЕ ПРЕВРАЩЕНИЕ" target="ОБЪЁМНАЯ ДОЛЯ ВТОРОЙ ФАЗЫ">
      <data key="d10">10.0</data>
      <data key="d11">Незавершённое превращение приводит к увеличению объёмной доли второй фазы, включая M/A, особенно при благоприятных условиях охлаждения</data>
      <data key="d12">6</data>
    </edge>
    <edge source="НЕЗАВЕРШЁННОЕ ПРЕВРАЩЕНИЕ" target="ТЕМПЕРАТУРА ОКОНЧАНИЯ УСКОРЕННОГО ОХЛАЖДЕНИЯ">
      <data key="d10">8.0</data>
