      <data key="d10">1.0</data>
      <data key="d11">Сталь 13ГС-У обеспечивает высокую долю вязкой составляющей в изломе при испытании падающим грузом, что свидетельствует о высокой ударной вязкости</data>
      <data key="d12">182</data>
    </edge>
