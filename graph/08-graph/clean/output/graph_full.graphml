    <edge source="ЭКВИВАЛЕНТНАЯ ОБРАБОТКА" target="НЕУПОРЯДОЧЕННАЯ ДИСЛОКАЦИОННАЯ СЕТКА ВЫСОКОЙ ПЛОТНОСТИ">
