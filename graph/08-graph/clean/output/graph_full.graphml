      <data key="d12">18</data>
    </edge>
    <edge source="СТАЛЬ КЛАССА ПРОЧНОСТИ X65" target="ОПТИМАЛЬНОЕ ЛЕГИРОВАНИЕ">
      <data key="d10">9.0</data>
      <data key="d11">Оптимальное легирование является основой разработки состава стали X65 в зависимости от толщины проката</data>
      <data key="d12">19</data>
    </edge>
    <edge source="КЛЕТЬ" target="ЭНЕРГОСИЛОВЫЕ ПАРАМЕТРЫ КЛЕТИ">
      <data key="d10">10.0</data>
