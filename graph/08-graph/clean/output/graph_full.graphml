      <data key="d4">1</data>
      <data key="d5">12</data>
      <data key="d6">174</data>
      <data key="d7">660</data>
      <data key="d8">1009</data>
      <data key="d9">-1</data>
    </node>
    <node id="МАЛОЕ ОБЖАТИЕ">
      <data key="d0">МАЛОЕ ОБЖАТИЕ</data>
      <data key="d1">ДЕФЕКТ</data>
      <data key="d2">Обжатие менее 8 % в конце черновой стадии прокатки, которое приводит к неполному разрушению исходной структуры и формированию неоднородной микроструктуры; подлежит исключению)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">12</data>
      <data key="d6">174</data>
      <data key="d7">660</data>
      <data key="d8">1009</data>
