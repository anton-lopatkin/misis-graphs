      <data key="d9">-1</data>
    </node>
    <node id="СТРУЯ ЖИДКОГО МЕТАЛЛА">
      <data key="d0">СТРУЯ ЖИДКОГО МЕТАЛЛА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Подвижный поток расплавленной стали при разливке; зона интенсивного образования эндогенных оксидных включений вследствие взаимодействия раскислителей с кислородом&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">23</data>
      <data key="d6">267</data>
      <data key="d7">-1</data>
