      <data key="d12">119</data>
    </edge>
    <edge source="ХЛАДОСТОЙКОСТЬ" target="ЖЕЛЕЗНОДОРОЖНЫЙ МОСТ БАМА">
      <data key="d10">1.0</data>
      <data key="d11">Конструкция моста требует применения сталей с высокой хладостойкостью</data>
