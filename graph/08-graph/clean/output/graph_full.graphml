    <node id="ЖИДКИЙ МЕТАЛЛ">
      <data key="d0">ЖИДКИЙ МЕТАЛЛ</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Агрегатное состояние стали перед кристаллизацией; в этом состоянии происходят процессы образования эндогенных и экзогенных неметаллических включений&gt;</data>
      <data key="d3">1</data>
      <data key="d4">6</data>
      <data key="d5">23</data>
      <data key="d6">267</data>
      <data key="d7">-1</data>
