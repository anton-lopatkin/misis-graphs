    <edge source="КРЕМНИЙ" target="УПРОЧНЕНИЕ ТВЁРДЫЙ РАСТВОР">
      <data key="d10">8.0</data>
      <data key="d11">Кремний участвует в упрочнении твёрдого раствора в IF-стали и других высокопрочных сталях</data>
