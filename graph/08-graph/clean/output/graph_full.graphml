    <node id="СООТНОШЕНИЕ БЕЙНИТ И ФЕРРИТ 90 : 10">
      <data key="d0">СООТНОШЕНИЕ БЕЙНИТ И ФЕРРИТ 90 : 10</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Количественное соотношение фаз в микроструктуре стали состав 4, указывающее на преобладание бейнита над ферритом)&gt;</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">13</data>
