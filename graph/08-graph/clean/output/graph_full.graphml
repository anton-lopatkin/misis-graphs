      <data key="d10">9.0</data>
      <data key="d11">Сталь 14Г2САФ легирована ванадием для карбонитридного упрочнения</data>
      <data key="d12">97</data>
    </edge>
    <edge source="ВАНАДИЙ" target="КАРБОНИТРИДЫ">
      <data key="d10">10.0</data>
      <data key="d11">Ванадий образует дисперсные карбонитриды, ответственные за упрочнение</data>
      <data key="d12">101</data>
    </edge>
