    <node id="MO- И ТІ-СОДЕРЖАЩИЙ СТАЛЬ">
      <data key="d0">MO- И ТІ-СОДЕРЖАЩИЙ СТАЛЬ</data>
      <data key="d1">СТАЛЬ</data>
