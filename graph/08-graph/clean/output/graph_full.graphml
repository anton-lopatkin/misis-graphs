    </edge>
    <edge source="Σ_В" target="ТРУБНЫЙ ПЕРЕДЕЛ">
      <data key="d10">9.0</data>
      <data key="d11">Временное сопротивление основного металла трубы практически не изменяется после трубного передела</data>
