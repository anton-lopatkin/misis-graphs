    <node id="ДИЛАТОМЕТРИЧЕСКИЙ ЭКСПЕРИМЕНТ">
      <data key="d0">ДИЛАТОМЕТРИЧЕСКИЙ ЭКСПЕРИМЕНТ</data>
      <data key="d1">ИСПЫТАНИЕ</data>
      <data key="d2">Метод исследования фазовых превращений по изменению линейных размеров образца при нагреве или охлаждении</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">7</data>
      <data key="d6">126</data>
