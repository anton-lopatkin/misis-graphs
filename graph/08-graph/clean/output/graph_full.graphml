      <data key="d12">65</data>
    </edge>
    <edge source="М/А" target="УГЛЕРОДСОДЕРЖАЩАЯ ФАЗА">
      <data key="d10">9.0</data>
      <data key="d11">М/А-составляющая содержит остаточный аустенит и мартенсит, насыщенные углеродом</data>
      <data key="d12">17</data>
