      <data key="d10">9.0</data>
      <data key="d11">Сталь 10Г2ФБ имеет наивысшее отношение σ_T⁶⁰⁰/σ_T²⁰ = 0,53 среди исследованных, что указывает на высокую огнестойкость</data>
      <data key="d12">20</data>
    </edge>
    <edge source="10Г2ФБ" target="ЭЛЕКТРОСВАРНАЯ ТРУБА">
      <data key="d10">9.0</data>
