      <data key="d10">1.0</data>
      <data key="d11">При глубоком рафинировании в ковш вводят силикокальций для дополнительного раскисления и модифицирования включений</data>
      <data key="d12">8</data>
    </edge>
    <edge source="КАРБИД КАЛЬЦИЯ" target="ГЛУБОКОЕ РАФИНИРОВАНИЕ СТАЛИ">
      <data key="d10">1.0</data>
