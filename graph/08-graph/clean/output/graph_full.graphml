    <node id="КРИТИЧЕСКИЙ РАЗМЕР ЗЕРНА">
      <data key="d0">КРИТИЧЕСКИЙ РАЗМЕР ЗЕРНА</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Размер зерна, при котором зернограничное упрочнение превышает дислокационное (менее 0,33 мкм для железа); при этом деформационное упрочнение становится невозможным</data>
