    <node id="РАСПРЕДЕЛЕНИЕ ФАЗ">
      <data key="d0">РАСПРЕДЕЛЕНИЕ ФАЗ</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Пространственная неоднородность расположения фаз в объёме металла, влияет на свойства и анализируется при микроскопии</data>
