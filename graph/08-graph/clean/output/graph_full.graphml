    <node id="ТЕМПЕРАТУРА ВОЛОКНА">
      <data key="d0">ТЕМПЕРАТУРА ВОЛОКНА</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Температура, при которой в материале возникает хрупкое разрушение по типу «волокно»; в испытании падающим грузом указана как &lt; −20 °C и &lt; −30 °C</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">5</data>
