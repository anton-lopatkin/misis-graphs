      <data key="d12">161</data>
    </edge>
    <edge source="ПРЕДЕЛ ТЕКУЧЕСТИ" target="ОГНЕСТОЙКАЯ СТРОИТЕЛЬНАЯ СТАЛЬ">
      <data key="d10">10.0</data>
