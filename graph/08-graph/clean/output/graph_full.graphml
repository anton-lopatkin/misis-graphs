    </edge>
    <edge source="НИОБИЙ" target="ГОРЯЧАЯ ПОСАДКА">
      <data key="d10">9.0</data>
      <data key="d11">При горячей посадке ниобий остаётся в твёрдом растворе, что усиливает эффект микролегирования</data>
      <data key="d12">157</data>
