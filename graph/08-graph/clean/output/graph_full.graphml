    <edge source="РАСКИСЛЕНИЕ" target="СИЛИКОКАЛЬЦИЙ">
      <data key="d10">1.0</data>
      <data key="d11">Вдувание силикокальция приводит к дополнительному раскислению стали и снижению содержания кислорода до 0,002 %</data>
      <data key="d12">12</data>
    </edge>
    <edge source="РАСКИСЛЕНИЕ" target="КАРБИД КАЛЬЦИЯ">
      <data key="d10">1.0</data>
      <data key="d11">Карбид кальция используется для глубокого раскисления стали и снижения содержания кислорода</data>
      <data key="d12">12</data>
    </edge>
    <edge source="РАСКИСЛЕНИЕ" target="СОДЕРЖАНИЕ КИСЛОРОДА 0,002 %">
      <data key="d10">1.0</data>
      <data key="d11">Такое низкое содержание кислорода достигается в результате раскисления силикокальцием или карбидом кальция</data>
      <data key="d12">11</data>
