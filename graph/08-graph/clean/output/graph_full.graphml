    <node id="ПЕРЕХОД ХРУПКОЕ РАЗРУШЕНИЕ">
      <data key="d0">ПЕРЕХОД ХРУПКОЕ РАЗРУШЕНИЕ</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Процесс изменения механизма разрушения от вязкого к хрупкому при снижении температуры, расширяется с ростом доли перлита</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">11</data>
      <data key="d6">173</data>
      <data key="d7">655</data>
      <data key="d8">1008</data>
      <data key="d9">-1</data>
