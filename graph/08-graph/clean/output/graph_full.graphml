    <edge source="ПЕРЕОХЛАЖДЕНИЕ АУСТЕНИТА" target="ПЛОТНОСТЬ ЦЕНТРОВ ЗАРОЖДЕНИЯ ФЕРРИТНОЙ ФАЗЫ">
