      <data key="d10">9.0</data>
      <data key="d11">Сталь 08Г2МФБ характеризуется ферритно-бейнитной структурой, обеспечивающей оптимальное сочетание свойств</data>
      <data key="d12">34</data>
    </edge>
    <edge source="ФЕРРИТНО-БЕЙНИТНАЯ СТРУКТУРА" target="РЕЖИМ УСКОРЕННОГО ОХЛАЖДЕНИЯ">
      <data key="d10">9.0</data>
