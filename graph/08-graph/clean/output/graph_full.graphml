    <node id="ЗАКАЛКА С ОТПУСКОМ">
      <data key="d0">ЗАКАЛКА С ОТПУСКОМ</data>
      <data key="d1">РЕЖИМ</data>
      <data key="d2">Термическая обработка, включающая нагрев до аустенитной области, быстрое охлаждение и последующий отпуск; используется для получения высокопрочной структуры</data>
      <data key="d3">1</data>
      <data key="d4">4</data>
      <data key="d5">14</data>
      <data key="d6">202</data>
      <data key="d7">770</data>
