      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Оптимальное соотношение между упрочнением, измельчением зерна и вязкостью; нарушается при чрезмерном легировании</data>
      <data key="d3">1</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">38</data>
      <data key="d7">291</data>
