    <node id="Σ_(0.5)">
      <data key="d0">Σ_(0.5)</data>
      <data key="d1">СВОЙСТВО</data>
      <data key="d2">Предел текучести при остаточной деформации 0,5% — напряжение, при котором начинается значительная пластическая деформация&gt;</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">15</data>
