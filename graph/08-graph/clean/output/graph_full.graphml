    <node id="ВЫСОКОУГОЛОВАЯ ГРАНИЦА">
      <data key="d0">ВЫСОКОУГОЛОВАЯ ГРАНИЦА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Граница зерна с большим углом разориентировки, служит эффективным барьером для распространения хрупкой трещины</data>
      <data key="d3">1</data>
      <data key="d4">1</data>
      <data key="d5">-1</data>
      <data key="d6">-1</data>
