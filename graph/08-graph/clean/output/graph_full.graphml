    <node id="ТРУБНЫЙ ПЕРЕДЕЛ">
      <data key="d0">ТРУБНЫЙ ПЕРЕДЕЛ</data>
      <data key="d1">ОБРАБОТКА</data>
      <data key="d2">Технологическая операция, включающая формовку, сварку и термомеханическую обработку листового проката в трубу. Влияет на механические свойства: повышает предел текучести, снижает удлинение)</data>
      <data key="d3">1</data>
      <data key="d4">5</data>
      <data key="d5">5</data>
      <data key="d6">94</data>
      <data key="d7">438</data>
