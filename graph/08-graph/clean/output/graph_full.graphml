    <node id="ГРАНИЦА ИСХОДНОЕ АУСТЕНИТНОЕ ЗЕРНО">
      <data key="d0">ГРАНИЦА ИСХОДНОЕ АУСТЕНИТНОЕ ЗЕРНО</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Межзёренные границы первичного аустенита, которые могут сохраняться после фазовых превращений и служить ориентиром для анализа микроструктуры</data>
      <data key="d3">1</data>
