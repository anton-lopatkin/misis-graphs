    <node id="ОБРАЗОВАНИЕ БЕЙНИТА">
      <data key="d0">ОБРАЗОВАНИЕ БЕЙНИТА</data>
      <data key="d1">ПРЕВРАЩЕНИЕ</data>
      <data key="d2">Диффузионно-сдвиговое превращение аустенита при средних температурах, приводящее к формированию бейнитного феррита с выделениями цементита&gt;</data>
      <data key="d3">2</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">67</data>
      <data key="d7">382</data>
