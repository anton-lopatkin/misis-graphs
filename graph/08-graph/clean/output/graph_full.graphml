    <node id="МАКРОСТРУКТУРА">
      <data key="d0">МАКРОСТРУКТУРА</data>
      <data key="d1">СТРУКТУРА</data>
      <data key="d2">Структура, видимая невооруженным глазом или при малом увеличении; отражает крупные неоднородности, такие как осевая пористость, ликвация</data>
      <data key="d3">1</data>
      <data key="d4">0</data>
      <data key="d5">-1</data>
