      <data key="d11">Образование грубых продуктов промежуточного превращения ухудшает ударную вязкость, что компенсируется измельчением зерна</data>
      <data key="d12">200</data>
    </edge>
    <edge source="УДАРНАЯ ВЯЗКОСТЬ" target="ТЕМПЕРАТУРА ЗАВЕРШЕНИЯ УСКОРЕННОГО ОХЛАЖДЕНИЯ">
      <data key="d10">8.0</data>
      <data key="d11">При снижении температуры охлаждения до 600 °C ударная вязкость повышается, но при дальнейшем снижении — падает</data>
      <data key="d12">186</data>
    </edge>
    <edge source="УДАРНАЯ ВЯЗКОСТЬ" target="РИС. 5.67">
      <data key="d10">8.0</data>
