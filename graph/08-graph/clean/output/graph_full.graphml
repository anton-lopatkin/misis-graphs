    <node id="СТРОИТЕЛЬНАЯ НОРМАЛИЗОВАННАЯ СТАЛЬ">
      <data key="d0">СТРОИТЕЛЬНАЯ НОРМАЛИЗОВАННАЯ СТАЛЬ</data>
